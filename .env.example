# --- Scrapy GitHub scraper (scraper/) ---
# Strongly recommended: authenticated GitHub Search allows 30 requests/minute.
# Authentication does not remove GitHub Search's 1,000-result-per-query ceiling.
GITHUB_TOKEN=

# Primary PostgreSQL source for repositories, videos, runs, and transcript status.
# Example only: postgresql://user:***@127.0.0.1:5432/madewith
DATABASE_URL=

# Optional PostgreSQL override used by build-time publishing.
SCRAPE_DATABASE_URL=

# Maximum projects per domain when publishing (default 1000).
SCRAPE_KEEP=1000

# --- YouTube technology-video discovery ---
# Official YouTube Data API v3 key:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- LLM providers ---
# OPENROUTER_API_KEY routes transcript enrichment (youtube/enrich_transcripts.py)
# and the content factory (factory/content_factory.py) through OpenRouter.
# OPENAI_API_KEY is the OpenAI-direct fallback; both keys can coexist — each
# tool prefers the key matching its endpoint.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Per-tool model overrides (leave unset for the defaults):
# ENRICH_MODEL=google/gemini-2.5-pro         # transcript enrichment
# FACTORY_MODEL=anthropic/claude-sonnet-4.5  # content factory
# DESC_MODEL=google/gemini-2.5-flash         # video description rewrites
# OPENAI_MODEL= is legacy/shared — prefer the per-tool variables above.

# Quality gates for English tutorials.
YOUTUBE_MIN_VIEWS=10000
YOUTUBE_MIN_CHANNEL_SUBS=5000
YOUTUBE_MIN_DURATION_SEC=480
YOUTUBE_MAX_DURATION_SEC=10800
YOUTUBE_MIN_LIKE_RATIO=0.004
YOUTUBE_PUBLISH_KEEP=24

# Transcript fetching uses youtube-transcript-api and writes
# src/data/transcripts/<video-id>.json. It needs DATABASE_URL but no API key.
# Bulk requests may trigger YouTube IpBlocked/RequestBlocked responses; control
# pacing with transcribe_youtube.py --sleep and never store proxy credentials here
# unless .env remains untracked.

# --- Build-time data hydration (scripts/pull-data.mjs) ---
# Priority: PostgreSQL above, then the Node app / remote base, then committed JSON.
# On the Ploi box, point this at the local Node app so the build serves the
# freshest scrape:  MADEWITH_DATA_BASE_URL=http://127.0.0.1:8787
MADEWITH_DATA_BASE_URL=

# --- Client (PUBLIC_ values are exposed to the browser) ---
# Base URL the public submit/newsletter forms POST to.
# Prefer same-origin (leave empty): Astro/nginx proxies /newsletter and /submit
# to the Node app. Set an absolute URL only when the browser must hit the API
# host directly (CORS is enabled on those routes).
PUBLIC_API_BASE=

# PostHog analytics (src/components/PostHog.astro). Unset disables analytics
# entirely — no script is emitted. The key is the project API key ("phc_...")
# from PostHog → Project settings. Host: https://us.i.posthog.com for US cloud.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================================
# Node backend (server/) — the Ploi VPS app that replaced the Cloudflare Worker
# ============================================================================
# Where Astro dev proxies /admin/api, /submit, /newsletter, /api/chat, /data.
API_SERVER_URL=http://127.0.0.1:8787
# Node app HTTP port.
PORT=8787
# Redis (KV replacement: etags, rate limits, AI-category cache, meta:lastRun).
REDIS_URL=redis://127.0.0.1:6379
# Filesystem object store (R2 replacement). Absolute path in production.
DATA_DIR=

# Admin auth (replaces Cloudflare Access).
ADMIN_PASSWORD=            # password for the /admin login
ADMIN_TOKEN=              # optional bearer token for automation on /admin/api/*
SESSION_SECRET=           # HMAC key signing admin session cookies (set a long random value)

# Gates POST /refresh outside the admin UI.
REFRESH_SECRET=
# Model for low-confidence category refinement over OpenRouter (optional).
OPENROUTER_CLASSIFY_MODEL=meta-llama/llama-3.1-8b-instruct
# Best-effort URL pinged after a publish to rebuild the static site
# (e.g. a Ploi deploy webhook). Replaces the old Cloudflare Pages deploy hook.
REBUILD_HOOK=

# --- Infobip AI Assistant (powers the /api/chat route + chat widget) ---
# Set on the Node server (.env). INFOBIP_API_KEY is a secret.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# Optional; defaults to the MadeWithWhat assistant baked into server/src/chat.ts
INFOBIP_ASSISTANT_ID=1014612c-95ad-4488-9ab6-b05c8f538b08
