# --- Local scraper (scripts/scrape.mjs) ---
# Optional GitHub token: 60 → 5,000 requests/hour and real language data.
GITHUB_TOKEN=

# --- Build-time data hydration (scripts/pull-data.mjs) ---
# The scraper Worker's base URL; the build pulls /data/<slug>.json from it.
MADEWITH_DATA_BASE_URL=

# --- Client (exposed to the browser; PUBLIC_ prefix) ---
# Worker base URL the public submit form POSTs to (…/submit). Unset → the form
# stays a client-only success state (local/preview).
PUBLIC_API_BASE=

# --- Admin dashboard (local dev) ---
# Astro dev proxies /admin/api/* here (default http://127.0.0.1:8787).
# On Cloudflare Pages, set ADMIN_WORKER_URL to the deployed Worker URL instead.
ADMIN_WORKER_URL=http://127.0.0.1:8787
