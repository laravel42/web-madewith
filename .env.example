# --- Scrapy GitHub scraper (scraper/) ---
# Required: 5,000 GraphQL points/hour with a token vs 60 without.
GITHUB_TOKEN=

# Madewith Postgres (github_search_runs, repositories, technologies, …)
# Example: postgresql://user:pass@127.0.0.1:5432/madewith
DATABASE_URL=

# Optional override for scraper only
SCRAPE_DATABASE_URL=

# Optional: max projects per domain when running scrape:publish (default 1000)
SCRAPE_KEEP=1000

# --- YouTube tech video scraper (scraper/, spider: youtube) ---
# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Quality gates (English tutorials only)
YOUTUBE_MIN_VIEWS=10000
YOUTUBE_MIN_CHANNEL_SUBS=5000
YOUTUBE_MIN_DURATION_SEC=480
YOUTUBE_MAX_DURATION_SEC=10800
YOUTUBE_MIN_LIKE_RATIO=0.004
YOUTUBE_PUBLISH_KEEP=24

# --- Build-time data hydration (scripts/pull-data.mjs) ---
# Primary: Postgres above (runs scraper/publish.py before astro build).
# Fallback: scraper Worker base URL for legacy R2 datasets.
MADEWITH_DATA_BASE_URL=

# --- Client (exposed to the browser; PUBLIC_ prefix) ---
# Worker base URL the public submit form POSTs to (…/submit). Unset → the form
# stays a client-only success state (local/preview).
PUBLIC_API_BASE=

# --- Admin dashboard (local dev) ---
# Astro dev proxies /admin/api/* here (default http://127.0.0.1:8787).
# On Cloudflare Pages, set ADMIN_WORKER_URL to the deployed Worker URL instead.
ADMIN_WORKER_URL=http://127.0.0.1:8787
