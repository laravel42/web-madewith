# --- Scrapy GitHub scraper (workers/projects/) ---
# Strongly recommended: authenticated GitHub Search allows 30 requests/minute.
# Authentication does not remove GitHub Search's 1,000-result-per-query ceiling.
GITHUB_TOKEN=

# Primary PostgreSQL source for repositories, videos, runs, and transcript status.
# Example only: postgresql://user:***@127.0.0.1:5432/madewith
DATABASE_URL=

# Optional PostgreSQL override used by build-time publishing.
SCRAPE_DATABASE_URL=

# Maximum projects per domain when publishing (default 1000).
SCRAPE_KEEP=1000

# --- YouTube technology-video discovery ---
# Official YouTube Data API v3 key:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- LLM providers ---
# OPENAI_API_KEY is the primary key: OpenAI's official API powers transcript
# enrichment (workers/videos/enrich_transcripts.py), the content factory
# (workers/posts/content_factory.py), the chat widget, and category classification
# (server/). OPENROUTER_API_KEY is an optional escape hatch — set it only to
# route a given tool through OpenRouter instead; each tool prefers the key
# matching its endpoint.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Per-tool model overrides (leave unset for the defaults):
# ENRICH_MODEL=gpt-4.1                # transcript enrichment
# FACTORY_MODEL=gpt-5-mini            # content factory
# DESC_MODEL=gpt-4o-mini              # video description rewrites
# CHAT_MODEL=gpt-4o-mini              # /api/chat widget (server/)
# OPENAI_MODEL= is legacy/shared — prefer the per-tool variables above.

# Quality gates for English tutorials.
YOUTUBE_MIN_VIEWS=10000
YOUTUBE_MIN_CHANNEL_SUBS=5000
YOUTUBE_MIN_DURATION_SEC=480
YOUTUBE_MAX_DURATION_SEC=10800
YOUTUBE_MIN_LIKE_RATIO=0.004
YOUTUBE_PUBLISH_KEEP=24

# Transcript fetching uses youtube-transcript-api and writes
# src/data/transcripts/<video-id>.json. It needs DATABASE_URL but no API key.
# Bulk requests may trigger YouTube IpBlocked/RequestBlocked responses; control
# pacing with workers/videos/transcribe_youtube.py --sleep and never store proxy credentials here
# unless .env remains untracked.

# --- Build-time data hydration (workers/utils/pull-data.mjs) ---
# Priority: PostgreSQL above, then the Node app / remote base, then committed JSON.
# On the Ploi box, point this at the local Node app so the build serves the
# freshest scrape:  MADEWITH_DATA_BASE_URL=http://127.0.0.1:8787
MADEWITH_DATA_BASE_URL=

# --- Client (PUBLIC_ values are exposed to the browser) ---
# Base URL the public submit/newsletter forms POST to.
# Prefer same-origin (leave empty): Astro/nginx proxies /api/newsletter and
# /api/submit to the Node app (the /api prefix avoids the static /newsletter
# and /submit pages). Set an absolute URL only when the browser must hit the
# API host directly (CORS is enabled on those routes).
PUBLIC_API_BASE=

# PostHog analytics (src/components/PostHog.astro). Unset disables analytics
# entirely — no script is emitted. The key is the project API key ("phc_...")
# from PostHog → Project settings. Host: https://us.i.posthog.com for US cloud.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================================
# Node backend (server/) — the Ploi VPS app that replaced the Cloudflare Worker
# ============================================================================
# Where Astro dev proxies /admin/api, /api (newsletter/submit/chat), /data.
API_SERVER_URL=http://127.0.0.1:8787
# Node app HTTP port.
PORT=8787
# Redis (KV replacement: etags, rate limits, AI-category cache, meta:lastRun).
REDIS_URL=redis://127.0.0.1:6379
# Filesystem object store (R2 replacement). Absolute path in production.
DATA_DIR=

# Admin auth (replaces Cloudflare Access).
ADMIN_PASSWORD=            # password for the /admin login
ADMIN_TOKEN=              # optional bearer token for automation on /admin/api/*
SESSION_SECRET=           # HMAC key signing admin session cookies (set a long random value)

# Gates POST /refresh outside the admin UI.
REFRESH_SECRET=
# Model for low-confidence category refinement over OpenAI (optional).
OPENAI_CLASSIFY_MODEL=gpt-4o-mini
# Best-effort URL pinged after a publish to rebuild the static site
# (e.g. a Ploi deploy webhook). Replaces the old Cloudflare Pages deploy hook.
REBUILD_HOOK=

# Server-side PostHog capture: newsletter subscribers and project submissions
# are mirrored into PostHog as newsletter_subscription_recorded /
# project_submission_recorded events. Defaults to the PUBLIC_POSTHOG_* values
# above — set these only to override with a server-specific token or host.
# With neither set, server-side capture is disabled (no-op).
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Infobip AI Assistant (powers the /api/chat route + chat widget) ---
# Set on the Node server (.env). INFOBIP_API_KEY is a secret.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# Optional; defaults to the MadeWithWhat assistant baked into server/src/chat.ts
INFOBIP_ASSISTANT_ID=1014612c-95ad-4488-9ab6-b05c8f538b08

# ============================================================================
# Static-site deploy: S3 bucket + Cloudflare cache purge
# (workers/utils/deploy_s3.py — `pnpm deploy:s3`)
# ============================================================================
# Uploads only the files whose content changed, then purges the Cloudflare edge
# cache for exactly the URLs those files serve.
#
# Bucket and the folder inside it. AWS_BUCKET is the name already used above;
# S3_BUCKET is accepted as an alias. S3_PREFIX is a storage path only — it is
# stripped when building purge URLs, so s3://bucket/site/blog/x/index.html
# purges https://<SITE_URL>/blog/x/.
AWS_BUCKET=web-madewith-static-site
S3_PREFIX=

# Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION
# above, or AWS_PROFILE, or an instance role. The IAM identity needs:
#   s3:ListBucket   on arn:aws:s3:::<bucket>        (change detection)
#   s3:PutObject    on arn:aws:s3:::<bucket>/*      (upload)
#   s3:DeleteObject on arn:aws:s3:::<bucket>/*      (only for --delete)
#
# AWS_ENDPOINT is only for S3-compatible storage (Cloudflare R2, MinIO). A
# bucket-scoped AWS URL is ignored: boto3 derives the AWS endpoint from the
# region, and passing one would address https://bucket.s3…/bucket/key.
# AWS_S3_FORCE_PATH_STYLE applies only to such third-party endpoints.
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# CDN invalidation. Whichever is configured runs; both may run at once, which
# is what a Cloudflare-to-CloudFront migration needs — the old edge keeps
# serving until DNS flips. SITE_URL (above) builds the paths/URLs.
#
# CloudFront: the IAM identity needs cloudfront:CreateInvalidation.
AWS_CLOUDFRONT_DISTRIBUTION_ID=
#
# Cloudflare: token needs one permission — Zone → Cache Purge (dash → My
# Profile → API Tokens). Zone ID is on the domain's overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Only changed URLs are purged. Above this many, one purge-everything beats
# batches of 100 fighting the per-plan rate limit (5/min Free, 5/s Pro).
CF_PURGE_MAX_URLS=200
