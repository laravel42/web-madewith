---
import MadeWithWhatWordmark from "../components/MadeWithWhatWordmark.astro";
import NetworkFooter from "../components/NetworkFooter.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title.includes("MadeWithWhat") ? title : `${title} — MadeWithWhat`;
const FONT_HREF =
  "https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONT_HREF} rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding-left: 20px;
        padding-right: 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: "Hanken Grotesk", sans-serif;
        color: #12161a;
        background: #fbfcfb;
        -webkit-font-smoothing: antialiased;
      }
      a { text-decoration: none; color: inherit; }
      .disp { font-family: "Bricolage Grotesque", sans-serif; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; width: 100%; }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(251, 252, 251, 0.86);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #ececec;
      }
      .site-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 0;
      }
      .filter-link {
        cursor: pointer;
        text-decoration: none;
        transition: color 0.12s ease, text-decoration-color 0.12s ease;
      }
      .filter-link:hover {
        color: rgb(47, 111, 235);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgb(47, 111, 235);
        color: #fff;
        font-weight: 700;
        border-radius: 10px;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" style="display:flex; align-items:center; gap:10px;">
          <div class="disp" style="width:30px; height:30px; border-radius:8px; background:#12161a; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px;">M</div>
          <MadeWithWhatWordmark size="header" />
        </a>
        <a href="/#network" style="font-size:14px; font-weight:500; color:#5c6169;">Browse the network ↓</a>
      </div>
    </header>

    <slot />

    <NetworkFooter />
  </body>
</html>
