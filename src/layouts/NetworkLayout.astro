---
import NetworkFooter from "../components/NetworkFooter.astro";
import PageShell from "../components/PageShell.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { GlobalNavActive } from "../components/GlobalSiteNav.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  active?: GlobalNavActive;
  ogType?: string;
}

const { title, description, noindex = false, image, active = "network", ogType = "website" } = Astro.props;
const pageTitle = title.includes("MadeWithWhat") ? title : `${title} — MadeWithWhat`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image ?? new URL("/og.png", site).href;
const FONT_HREF =
  "https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MadeWithWhat" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONT_HREF} rel="stylesheet" />
    <slot name="head" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding-left: 20px;
        padding-right: 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: clip;
        font-family: "Hanken Grotesk", sans-serif;
        color: #12161a;
        -webkit-font-smoothing: antialiased;
      }
      a { text-decoration: none; color: inherit; }
      .disp { font-family: "Bricolage Grotesque", sans-serif; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; width: 100%; }
      .filter-link {
        cursor: pointer;
        text-decoration: none;
        transition: color 0.12s ease, text-decoration-color 0.12s ease;
      }
      .filter-link:hover {
        color: rgb(47, 111, 235);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgb(47, 111, 235);
        color: #fff;
        font-weight: 700;
        border-radius: 10px;
        text-decoration: none;
      }
    </style>
  </head>
  <body class="has-page-shell">
    <PageShell>
      <SiteHeader active={active} />

      <slot />

      <NetworkFooter />
    </PageShell>
  </body>
</html>
