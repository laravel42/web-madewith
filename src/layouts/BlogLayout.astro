---
import NetworkFooter from "../components/NetworkFooter.astro";
import ChatWidget from "../components/ChatWidget.astro";
import PageShell from "../components/PageShell.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PostHog from "../components/PostHog.astro";
import { readableOnLight } from "../config/accessible-color";
import "../styles/blog-card-cover.css";

interface Props {
  title: string;
  description: string;
  active?: "network" | "blog" | "rss";
  /** Raw brand accent, as hex. Text vars are derived from it, never set to it. */
  accent?: string;
  headerCta?: { href: string; label: string };
  /** og:type — "article" for posts, "website" for listings. */
  ogType?: "article" | "website";
  /** Absolute canonical URL override (posts may self-canonicalise). */
  canonical?: string;
  /** Absolute OG image URL; defaults to the network card. */
  image?: string;
}

const { title, description, active = "blog", accent = "#2f6feb", headerCta, ogType = "website", canonical, image } = Astro.props;
// `--blog-accent` paints prose links and inline code, both on light surfaces
// (#fbfcfb page, #f2f4f7 code chip). The raw accent stays available for the
// non-text uses (the blockquote rule) as `--blog-accent-raw`.
const accentText = readableOnLight(accent);
const pageTitle = title.includes("MadeWithWhat") ? title : `${title} — MadeWithWhat`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalHref = canonical ?? new URL(Astro.url.pathname, site).href;
const ogImage = image ?? new URL("/og.png", site).href;
const FONT_HREF =
  "https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=JetBrains+Mono:wght@400;500;700&display=swap";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MadeWithWhat" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONT_HREF} rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="MadeWithWhat Articles" href="/articles/rss.xml" />
    <slot name="head" />
    <PostHog />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding-left: 20px;
        padding-right: 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: clip;
        font-family: "Hanken Grotesk", sans-serif;
        color: #12161a;
        -webkit-font-smoothing: antialiased;
      }
      :global(a) {
        text-decoration: none;
        color: inherit;
      }
      .disp { font-family: "Bricolage Grotesque", sans-serif; }
      .mw-link { color: #2c68dd; }
      .mw-link:hover { color: #1c4fbf; }
      .filter-link {
        cursor: pointer;
        text-decoration: none;
        transition: color 0.12s ease, text-decoration-color 0.12s ease;
      }
      .filter-link:hover {
        color: #2c68dd;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      :global(.blog-hero) {
        max-width: 920px;
        margin: 0 auto;
        padding: 64px 28px 30px;
        text-align: center;
      }
      :global(.blog-hero-eyebrow) {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #2c68dd;
        text-transform: uppercase;
        margin-bottom: 18px;
      }
      :global(.blog-hero-title) {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: clamp(40px, 8vw, 54px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.04;
        margin: 0;
      }
      :global(.blog-hero-copy) {
        font-size: 17px;
        color: #5c6169;
        margin: 18px auto 0;
        line-height: 1.55;
        max-width: 560px;
      }
      :global(.prose) {
        min-width: 0;
        max-width: 100%;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      :global(.prose > *) {
        max-width: 100%;
      }
      :global(.prose img),
      :global(.prose video),
      :global(.prose iframe),
      :global(.prose table),
      :global(.prose pre) {
        max-width: 100%;
      }
      :global(.prose h2) {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 42px 0 14px;
        scroll-margin-top: 96px;
      }
      :global(.prose p) {
        font-family: "Newsreader", serif;
        font-size: 19px;
        line-height: 1.7;
        color: #2b2f36;
        margin: 0 0 18px;
      }
      :global(.prose ul),
      :global(.prose ol) {
        font-family: "Newsreader", serif;
        font-size: 19px;
        line-height: 1.7;
        color: #2b2f36;
        padding-left: 22px;
        margin: 0 0 18px;
      }
      :global(.prose li) { margin: 0 0 8px; }
      :global(.prose strong) { font-weight: 700; color: #12161a; }
      :global(.prose code) {
        font-family: "JetBrains Mono", monospace;
        font-size: 15px;
        background: #f2f4f7;
        padding: 2px 6px;
        border-radius: 5px;
        color: var(--blog-accent, #2f6feb);
      }
      :global(.prose pre) {
        background: #0f1420;
        border-radius: 12px;
        padding: 18px 20px;
        overflow: auto;
        margin: 0 0 18px;
      }
      :global(.prose pre code) {
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        color: #c7d0da;
        background: none;
        padding: 0;
        white-space: pre;
      }
      :global(.prose blockquote) {
        border-left: 3px solid var(--blog-accent-raw, #2f6feb);
        margin: 0 0 18px;
        padding: 6px 0 6px 20px;
        font-family: "Newsreader", serif;
        font-size: 20px;
        font-style: italic;
        color: #3a4048;
      }
      :global(.prose h3) {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -0.01em;
        margin: 28px 0 12px;
        scroll-margin-top: 96px;
      }
      :global(.prose a) {
        color: var(--blog-accent, #2f6feb);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      :global(.prose table) {
        width: 100%;
        border-collapse: collapse;
        margin: 0 0 24px;
        font-family: "Hanken Grotesk", sans-serif;
        font-size: 14px;
        line-height: 1.5;
        letter-spacing: -0.01em;
        color: #3a4048;
        border: 1px solid #e6e8eb;
        border-radius: 12px;
        overflow: hidden;
      }
      :global(.prose th),
      :global(.prose td) {
        border-bottom: 1px solid #eceef1;
        padding: 12px 14px;
        text-align: left;
        vertical-align: top;
      }
      :global(.prose tr:last-child td) {
        border-bottom: none;
      }
      :global(.prose th) {
        background: #f6f7f9;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #6a7077;
      }
      :global(.prose tbody tr:nth-child(even) td) {
        background: #fafbfc;
      }
      :global(.prose figure) {
        margin: 0 0 22px;
      }
      :global(.prose figure img) {
        width: 100%;
        max-width: 100%;
        height: auto;
        border-radius: 14px;
        display: block;
      }
      :global(.prose figcaption) {
        font-size: 13px;
        color: #5c665f;
        margin-top: 8px;
        text-align: center;
      }
      :global(.prose .callout) {
        border-radius: 12px;
        padding: 14px 16px;
        margin: 0 0 18px;
        font-family: "Newsreader", serif;
        font-size: 17px;
        line-height: 1.6;
      }
      :global(.prose .callout strong) {
        display: block;
        font-family: "Hanken Grotesk", sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
      :global(.prose .callout p) {
        font-size: 17px;
        margin: 0;
      }
      :global(.prose .callout-note) {
        background: #eef4ff;
        border: 1px solid #c9d9fb;
        color: #24324d;
      }
      :global(.prose .callout-tip) {
        background: #edf8f1;
        border: 1px solid #b9e3c7;
        color: #1f3d2b;
      }
      :global(.prose .callout-warning) {
        background: #fff4e8;
        border: 1px solid #f2d2a6;
        color: #5a3b12;
      }
      :global(.prose .blog-faq) {
        margin: 42px 0 0;
        padding: 28px;
        background: #f8f9fb;
        border: 1px solid #e9ebee;
        border-radius: 18px;
      }
      :global(.prose .blog-faq > h2) {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 20px;
        scroll-margin-top: 96px;
      }
      :global(.prose .blog-faq-list) {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      :global(.prose .blog-faq-item) {
        background: #fff;
        border: 1px solid #e9ebee;
        border-radius: 12px;
        padding: 16px 18px;
      }
      :global(.prose .blog-faq-question) {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.01em;
        line-height: 1.35;
        color: #12161a;
        margin: 0 0 8px;
        scroll-margin-top: 96px;
      }
      :global(.prose .blog-faq-answer) {
        font-family: "Newsreader", serif;
        font-size: 17px;
        line-height: 1.65;
        color: #3a4048;
        margin: 0;
      }
      :global(.prose .blog-seo-meta) {
        margin: 42px 0 0;
        padding: 28px;
        background: linear-gradient(180deg, #f4f7fc 0%, #f8f9fb 100%);
        border: 1px solid #dde3ee;
        border-radius: 18px;
      }
      :global(.prose .blog-seo-meta > h2) {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 8px;
        scroll-margin-top: 96px;
      }
      :global(.prose .blog-seo-meta-lead) {
        font-family: "Newsreader", serif;
        font-size: 15px;
        line-height: 1.55;
        color: #5c6169;
        margin: 0 0 20px;
      }
      :global(.prose .blog-seo-meta-list) {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0;
      }
      :global(.prose .blog-seo-meta-row) {
        display: grid;
        grid-template-columns: minmax(120px, 168px) minmax(0, 1fr);
        gap: 12px 16px;
        align-items: start;
        background: #fff;
        border: 1px solid #e9ebee;
        border-radius: 12px;
        padding: 12px 14px;
        margin: 0;
      }
      :global(.prose .blog-seo-meta-key) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: lowercase;
        color: #4a5568;
        background: #eef1f6;
        border-radius: 6px;
        padding: 4px 8px;
        margin: 0;
        width: fit-content;
        max-width: 100%;
        word-break: break-word;
      }
      :global(.prose .blog-seo-meta-key-og) {
        color: #1e4d8c;
        background: #e8f0fb;
      }
      :global(.prose .blog-seo-meta-key-article) {
        color: #5a3b12;
        background: #fbf1df;
      }
      :global(.prose .blog-seo-meta-value) {
        font-family: "Newsreader", serif;
        font-size: 15px;
        line-height: 1.55;
        color: #12161a;
        margin: 0;
        word-break: break-word;
      }
      :global(.prose .blog-seo-meta-value a) {
        color: #2f6feb;
        text-decoration: none;
      }
      :global(.prose .blog-seo-meta-value a:hover) {
        text-decoration: underline;
      }
      :global(.prose .blog-seo-meta-path) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        background: #f3f4f6;
        padding: 2px 6px;
        border-radius: 4px;
      }
      :global(.prose .blog-seo-schema) {
        margin-top: 18px;
        border: 1px solid #1f2937;
        border-radius: 12px;
        overflow: hidden;
        background: #111827;
      }
      :global(.prose .blog-seo-schema-label) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #9ca3af;
        padding: 10px 14px;
        border-bottom: 1px solid #374151;
        background: #0f172a;
      }
      :global(.prose .blog-seo-schema-pre) {
        margin: 0;
        padding: 16px;
        overflow-x: auto;
        background: transparent;
        border: none;
        border-radius: 0;
      }
      :global(.prose .blog-seo-schema-pre code) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12.5px;
        line-height: 1.55;
        color: #e5e7eb;
        background: transparent;
        padding: 0;
        white-space: pre;
      }
      @media (max-width: 900px) {
        :global(.prose .blog-seo-meta-row) {
          grid-template-columns: 1fr;
          gap: 8px;
        }
        .blog-grid-3 { grid-template-columns: 1fr 1fr !important; }
        .blog-featured { grid-template-columns: 1fr !important; }
        .blog-article-grid { grid-template-columns: 1fr !important; }
        .blog-toc-layout { grid-template-columns: minmax(0, 1fr) !important; }
      }
      @media (max-width: 560px) {
        .blog-grid-3 { grid-template-columns: 1fr !important; }
      }
      .blog-index-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .blog-index-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(20, 30, 50, 0.08);
      }
      .blog-featured {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .blog-featured:hover {
        transform: translateY(-2px);
        box-shadow: 0 24px 56px rgba(20, 30, 50, 0.1);
      }
    </style>
  </head>
  <body class="has-page-shell" style={`--blog-accent:${accentText}; --blog-accent-raw:${accent};`}>
    <PageShell>
      <SiteHeader
        active={active}
        subscribeHref={headerCta?.href}
        subscribeLabel={headerCta?.label}
      />

      <slot />

      <NetworkFooter />
    </PageShell>
    <ChatWidget />
  </body>
</html>
