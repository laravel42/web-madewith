---
interface Props {
  active: "overview" | "submissions" | "domains" | "posts" | "videos" | "newsletter" | "pipeline" | "settings";
}
const { active } = Astro.props;

const groups: Array<{ title: string; items: Array<{ key: Props["active"]; icon: string; label: string; href: string; badge?: boolean }> }> = [
  { title: "Overview", items: [{ key: "overview", icon: "◧", label: "Overview", href: "/admin/" }] },
  {
    title: "Content",
    items: [
      { key: "domains", icon: "◈", label: "Technologies", href: "/admin/domains/" },
      { key: "posts", icon: "✎", label: "Blog posts", href: "/admin/posts/" },
      { key: "videos", icon: "▷", label: "Videos", href: "/admin/videos/" },
    ],
  },
  {
    title: "Community",
    items: [
      { key: "submissions", icon: "⊕", label: "Submissions", href: "/admin/submissions/", badge: true },
      { key: "newsletter", icon: "✉", label: "Newsletter", href: "/admin/newsletter/" },
    ],
  },
  {
    title: "System",
    items: [
      { key: "pipeline", icon: "↻", label: "Pipeline", href: "/admin/pipeline/" },
      { key: "settings", icon: "⚙", label: "Settings", href: "/admin/settings/" },
    ],
  },
];
---

<aside class="mw-sidebar mw-scroll" style="background:#12161a; color:#c9cdd4; display:flex; flex-direction:column; position:sticky; top:0; height:100vh;">
  <a href="/admin/" style="display:flex; align-items:center; gap:10px; padding:20px 22px 22px; text-decoration:none; color:inherit;">
    <span style="width:30px; height:30px; border-radius:9px; background:#fff; color:#12161a; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px;">M</span>
    <div>
      <div style="font-weight:800; font-size:15px; color:#fff; letter-spacing:-0.01em;">madewithwhat</div>
      <div style="font-size:11px; color:#7e838d; font-weight:600; letter-spacing:.06em; text-transform:uppercase;">Admin</div>
    </div>
  </a>

  <nav aria-label="Admin sections" style="flex:1; overflow-y:auto; padding:6px 12px;">
    {groups.map((g) => (
      <>
        <div class="mw-nav-group-title" style="font-size:10.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#616772; padding:14px 12px 7px;">{g.title}</div>
        {g.items.map((it) => (
          <a
            href={it.href}
            style={`display:flex; align-items:center; gap:11px; padding:9px 12px; border-radius:10px; font-size:13.5px; font-weight:600; margin-bottom:2px; text-decoration:none; ${
              active === it.key ? "color:#fff; background:#262b32;" : "color:#c9cdd4;"
            }`}
          >
            <span style="width:19px; text-align:center; opacity:.9;">{it.icon}</span>
            <span style="flex:1;">{it.label}</span>
            {it.badge && (
              <span id="pending-badge" class="hidden" style="font-size:11px; font-weight:700; color:#fff; background:#7C3AED; padding:1px 7px; border-radius:20px;">0</span>
            )}
          </a>
        ))}
      </>
    ))}
  </nav>

  <div class="mw-user-card" style="padding:14px; border-top:1px solid #23272e;">
    <div style="display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:11px; background:#1b2026;">
      <span id="admin-user-avatar" style="width:32px; height:32px; border-radius:50%; background:#7C3AED; color:#fff; font-weight:700; font-size:13px; display:flex; align-items:center; justify-content:center;">·</span>
      <div style="flex:1; min-width:0;">
        <div id="admin-user-email" style="font-size:13px; font-weight:600; color:#fff; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">…</div>
        <div style="font-size:11.5px; color:#7e838d;">Maintainer</div>
      </div>
    </div>
  </div>
</aside>

<script>
  fetch("/admin/api/me")
    .then((r) => (r.ok ? r.json() : null))
    .then((me) => {
      const email = (me && (me as { email?: string }).email) || "unknown";
      const emailEl = document.getElementById("admin-user-email");
      const avatarEl = document.getElementById("admin-user-avatar");
      if (emailEl) emailEl.textContent = email;
      if (avatarEl) avatarEl.textContent = email.slice(0, 2).toUpperCase();
    })
    .catch(() => {});
</script>
