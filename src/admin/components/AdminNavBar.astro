---
import ColorModeSwitcher from "./ColorModeSwitcher.astro";
---

<nav class="fixed z-30 w-full bg-white border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700">
  <div class="px-3 py-3 lg:px-5 lg:pl-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center justify-start">
        <button
          id="toggle-sidebar"
          aria-controls="sidebar"
          type="button"
          class="p-2 text-gray-600 rounded-lg cursor-pointer lg:hidden hover:text-gray-900 hover:bg-gray-100 focus:ring-2 focus:ring-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
        >
          <svg id="toggle-sidebar-open" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
          </svg>
          <svg id="toggle-sidebar-close" class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
        </button>
        <a href="/admin/" class="flex ml-2 md:mr-6 items-center">
          <span class="self-center text-xl font-semibold whitespace-nowrap dark:text-white">MadeWith<span class="text-primary-600 dark:text-primary-400">What</span></span>
          <span class="ml-2 text-xs font-medium text-gray-500 dark:text-gray-400 hidden sm:inline">Admin</span>
        </a>
      </div>

      <div class="flex items-center gap-2">
        <ColorModeSwitcher />
        <div class="flex items-center ml-2">
          <span id="admin-email" class="text-sm text-gray-500 dark:text-gray-400 hidden sm:inline">…</span>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  import { initSidebar } from "../scripts/admin";
  initSidebar();
</script>
