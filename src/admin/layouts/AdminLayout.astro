---
import AdminSideBar from "../components/AdminSideBar.astro";

interface Props {
  title: string;
  active: "overview" | "submissions" | "domains" | "posts" | "videos" | "newsletter" | "pipeline" | "settings";
}

const { title, active } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — MadeWithWhat Admin</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="mw-admin antialiased">
    <div class="mw-shell">
      <AdminSideBar active={active} />

      <div class="mw-main">
        <header class="mw-topbar">
          <div class="flex items-center gap-4 px-[30px] py-[14px]">
            <div>
              <div class="text-xs font-semibold" style="color:#9aa0a6;">Admin / {title}</div>
              <h1 class="mw-display text-[21px] m-0 mt-px">{title}</h1>
            </div>
            <div class="flex-1"></div>
            <slot name="actions" />
          </div>
        </header>

        <main class="mw-scroll" style="padding:26px 30px 44px; overflow-y:auto;">
          <slot />
          <footer class="pt-8 text-[12.5px]" style="color:#9aa0a6;">
            MadeWithWhat Admin · protected by Cloudflare Access
          </footer>
        </main>
      </div>
    </div>

    <div
      id="admin-toast"
      class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 px-4 py-2 text-sm text-white rounded-lg shadow-lg opacity-0 pointer-events-none transition-opacity"
      style="background:#12161a;"
    ></div>
  </body>
</html>

<script>
  import "flowbite";
</script>

<style is:global>
  @import "../../styles/admin.css";

  .mw-admin {
    margin: 0;
    background: #f5f6f7;
    color: #12161a;
    font-family: "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
  }
  .mw-display {
    font-family: "Bricolage Grotesque", "Hanken Grotesk", sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .mw-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 238px 1fr;
  }
  @media (max-width: 900px) {
    .mw-shell { grid-template-columns: 1fr; }
    .mw-sidebar { position: static !important; height: auto !important; }
  }
  .mw-main { display: flex; flex-direction: column; min-width: 0; min-height: 100vh; }
  .mw-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(245, 246, 247, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e6e8eb;
  }

  .mw-card { background: #fff; border: 1px solid #e9ebee; border-radius: 16px; }
  .mw-card-head { display: flex; align-items: center; gap: 12px; padding: 16px 22px; border-bottom: 1px solid #eef0f2; flex-wrap: wrap; }
  .mw-count { font-size: 12px; font-weight: 600; color: #7c3aed; background: #f2ecfd; padding: 3px 10px; border-radius: 20px; }

  .mw-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .mw-table thead tr { text-align: left; color: #9aa0a6; font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .mw-table th { padding: 12px 16px; font-weight: 700; }
  .mw-table th:first-child { padding-left: 22px; }
  .mw-table td { padding: 13px 16px; color: #5c6169; }
  .mw-table td:first-child { padding-left: 22px; }
  .mw-table tbody tr { border-top: 1px solid #f1f2f4; }
  .mw-num { font-variant-numeric: tabular-nums; }

  .mw-pill { font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 20px; display: inline-block; }
  .mw-pill-green { color: #0f9d58; background: #0f9d5818; }
  .mw-pill-orange { color: #ff5d01; background: #ff5d0118; }
  .mw-pill-red { color: #e0245e; background: #e0245e18; }
  .mw-pill-blue { color: #2f6feb; background: #2f6feb18; }
  .mw-pill-gray { color: #6b7280; background: #6b728022; }
  .mw-pill-purple { color: #7c3aed; background: #7c3aed18; }

  .mw-chip { font-size: 12.5px; font-weight: 600; padding: 6px 12px; border-radius: 9px; cursor: pointer; color: #5c6169; background: #f2f4f6; border: none; font-family: inherit; }
  .mw-chip[aria-pressed="true"], .mw-chip.active { color: #fff; background: #12161a; }

  .mw-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: #fff; background: #12161a; padding: 10px 16px; border-radius: 11px; cursor: pointer; border: none; font-family: inherit; }
  .mw-btn-secondary { color: #3a4048; background: #fff; border: 1px solid #e6e8eb; }
  .mw-btn:disabled { opacity: 0.5; cursor: default; }
  .mw-btn-sm { padding: 6px 12px; font-size: 12.5px; border-radius: 9px; }

  .mw-search { display: flex; align-items: center; gap: 9px; background: #fff; border: 1px solid #e3e6ea; border-radius: 11px; padding: 9px 13px; width: 260px; }
  .mw-search input { border: none; outline: none; background: transparent; font-size: 13.5px; width: 100%; font-family: inherit; color: #12161a; }
  .mw-search input::placeholder { color: #9aa0a6; }

  .mw-kpi { padding: 18px 20px; }
  .mw-kpi-label { font-size: 13px; color: #7a808a; font-weight: 600; }
  .mw-kpi-value { font-family: "Bricolage Grotesque", sans-serif; font-size: 31px; font-weight: 800; letter-spacing: -0.02em; margin-top: 10px; }
  .mw-kpi-icon { width: 32px; height: 32px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 15px; }

  .mw-badge { width: 32px; height: 32px; border-radius: 9px; font-weight: 800; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; color: #fff; background: #3a3f47; }

  .mw-scroll::-webkit-scrollbar { width: 9px; height: 9px; }
  .mw-scroll::-webkit-scrollbar-thumb { background: #e0e3e7; border-radius: 20px; }
</style>
