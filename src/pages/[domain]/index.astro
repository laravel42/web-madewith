---
import { DOMAINS, getResolvedTheme, type Theme } from "../../config/domains";
import { getCatalog, rankedProjects, formatGalleryTotal, topCategoryFilters } from "../../lib/catalog";
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import Hero from "../../components/Hero.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import DomainBlogStrip from "../../components/DomainBlogStrip.astro";

export function getStaticPaths() {
  return DOMAINS.map((theme) => ({ params: { domain: theme.slug }, props: { slug: theme.slug } }));
}

const { slug } = Astro.props as { slug: string };
const theme = getResolvedTheme(slug);
const data = getCatalog(theme.slug);
const projects = rankedProjects(data);
const total = formatGalleryTotal(data);
const categories = topCategoryFilters(data, 5, theme.visibleCategories);
---
<CatalogLayout theme={theme} active="">
  <Hero theme={theme} total={total} categories={categories} />
  <ProjectGrid theme={theme} projects={projects} />
  <DomainBlogStrip theme={theme} />
</CatalogLayout>
