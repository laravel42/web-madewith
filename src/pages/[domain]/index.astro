---
import { DOMAINS, type Theme } from "../../config/domains";
import { getCatalog, rankedProjects, formatTotal } from "../../lib/catalog";
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import Hero from "../../components/Hero.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";

export function getStaticPaths() {
  return DOMAINS.map((theme) => ({ params: { domain: theme.slug }, props: { theme } }));
}

const { theme } = Astro.props as { theme: Theme };
const data = getCatalog(theme.slug);
const projects = rankedProjects(data);
const total = formatTotal(data.totalRepos);
---
<CatalogLayout theme={theme} active="">
  <Hero theme={theme} total={total} />
  <ProjectGrid theme={theme} projects={projects} />
</CatalogLayout>
