---
import { DOMAINS, type Theme } from "../../../config/domains";
import { getCatalog, relatedProjects, type Project } from "../../../lib/catalog";
import { projectDisplayName, projectPreviewExcerpt } from "../../../lib/preview-text";
import { canonicalUrl } from "../../../config/domain-settings";
import CatalogLayout from "../../../layouts/CatalogLayout.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";

export function getStaticPaths() {
  return DOMAINS.flatMap((theme) => {
    const data = getCatalog(theme.slug);
    return data.projects.map((project) => ({
      params: { domain: theme.slug, slug: project.slug },
      props: { theme, project },
    }));
  });
}

const { theme, project } = Astro.props as { theme: Theme; project: Project };
const data = getCatalog(theme.slug);
const related = relatedProjects(data, project, 3);
const displayName = projectDisplayName(project);
const title = `${displayName} — Made with ${theme.techName}`;
const description = `${projectPreviewExcerpt(project)} Built with ${theme.techName} by ${project.author}. ${project.stars.toLocaleString()} GitHub stars.`;

const site = Astro.site!.href;
const canonical = canonicalUrl(theme, Astro.url.pathname, site);
const galleryUrl = canonicalUrl(theme, `/${theme.slug}/`, site);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareSourceCode",
      "@id": canonical,
      url: canonical,
      name: displayName,
      description: projectPreviewExcerpt(project),
      codeRepository: project.repoUrl,
      ...(project.langs?.length ? { programmingLanguage: project.langs.map((l) => l.name) } : {}),
      ...(project.license ? { license: project.license } : {}),
      ...(project.stack?.length ? { keywords: project.stack.join(", ") } : {}),
      author: { "@type": "Person", name: project.author },
      isPartOf: { "@type": "WebSite", name: `Made with ${theme.techName}`, url: galleryUrl },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: `Made with ${theme.techName}`, item: galleryUrl },
        { "@type": "ListItem", position: 2, name: displayName, item: canonical },
      ],
    },
  ],
};
---
<CatalogLayout theme={theme} active="" title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <ProjectDetail theme={theme} project={project} related={related} />
</CatalogLayout>
