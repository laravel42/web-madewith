---
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
import { DOMAINS } from "../../config/domains";
import { getCatalog } from "../../lib/catalog";
import { getVideoCatalog } from "../../lib/videos";
import { getTranscript } from "../../lib/transcripts";

// Content-pipeline health, computed at build time from the same published
// artifacts the site renders. This is a snapshot of the last build — the DB
// queue itself lives in local Postgres (see `./pipeline.sh status`).
const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..", "..", "..");
const rewritesPath = join(ROOT, "src", "data", "video-descriptions.json");
const rewrites: Record<string, string> = existsSync(rewritesPath)
  ? JSON.parse(readFileSync(rewritesPath, "utf8"))
  : {};

interface Row {
  slug: string;
  techName: string;
  projects: number;
  scrapedAt: string | null;
  newestAddedAt: string | null;
  videos: number;
  enriched: number;
  rewritten: number;
  rawDesc: number;
}

const rows: Row[] = DOMAINS.map((d) => {
  let projects = 0;
  let scrapedAt: string | null = null;
  let newestAddedAt: string | null = null;
  try {
    const data = getCatalog(d.slug);
    projects = data.projects.length;
    scrapedAt = data.scrapedAt ?? null;
    for (const p of data.projects) {
      const added = (p as { addedAt?: string }).addedAt;
      if (added && (!newestAddedAt || added > newestAddedAt)) newestAddedAt = added;
    }
  } catch { /* domain without a dataset yet */ }

  let videos = 0, enriched = 0, rewritten = 0;
  try {
    const cat = getVideoCatalog(d.slug);
    videos = cat.videos.length;
    for (const v of cat.videos) {
      if (getTranscript(v.id)) enriched++;
      else if (rewrites[v.id]) rewritten++;
    }
  } catch { /* no video dataset */ }

  return {
    slug: d.slug, techName: d.techName, projects, scrapedAt, newestAddedAt,
    videos, enriched, rewritten, rawDesc: videos - enriched - rewritten,
  };
});

const totals = rows.reduce(
  (t, r) => ({
    projects: t.projects + r.projects,
    videos: t.videos + r.videos,
    enriched: t.enriched + r.enriched,
    rewritten: t.rewritten + r.rewritten,
  }),
  { projects: 0, videos: 0, enriched: 0, rewritten: 0 },
);
const coverage = totals.videos ? Math.round(((totals.enriched + totals.rewritten) / totals.videos) * 100) : 0;
const enrichedPct = totals.videos ? Math.round((totals.enriched / totals.videos) * 100) : 0;

function ago(iso: string | null): string {
  if (!iso) return "—";
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  return days <= 0 ? "today" : days === 1 ? "1 day ago" : `${days} days ago`;
}

const STAGES = [
  { name: "Discover", cmd: "pnpm scrape / pnpm scrape:youtube", out: "PostgreSQL (repositories, youtube_videos)", note: "GitHub GraphQL + ETags; YouTube Data API + strict relevance gate (25 ambiguous slugs)" },
  { name: "Fetch captions", cmd: "youtube/transcribe_rotate.sh ~/vpn-wg 100 1 2", out: "youtube/data/transcripts/<id>.json (local cache)", note: "VPN location rotation; fail-fast exit 75 on IP blocks; blocked videos stay pending" },
  { name: "Enrich", cmd: "enrich_transcripts.py --workers 8 --max-output-tokens 32000", out: "src/data/transcripts/<id>.json (schema v3)", note: "OpenRouter → gemini-2.5-pro; chapters + seoDescription + summary + literal transcription; structure-only fallback on truncation" },
  { name: "Rewrite descriptions", cmd: "rewrite_descriptions.py", out: "src/data/video-descriptions.json", note: "Covers non-enriched videos; gemini-2.5-flash; display picks seoDescription → rewrite → sanitized raw" },
  { name: "Publish", cmd: "./pipeline.sh projects · publish_videos.py", out: "src/data/<slug>.json + videos/<slug>.json", note: "Cross-domain scrub + addedAt stamping run automatically (also in build prebuild)" },
  { name: "Build & ship", cmd: "./pipeline.sh ship", out: "dist/ (pages, RSS by addedAt, llms.txt + llms-full.txt)", note: "prebuild re-hydrates from Postgres when DATABASE_URL is set; commit src/data to update deploys" },
];
---

<AdminLayout title="Pipeline" active="pipeline">
  <div class="px-4 pt-6">
    <div class="mb-4">
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Content pipeline</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Coverage snapshot from the last build's published data. Live queue counts (pending transcripts, DB status) come from
        <code class="text-xs">./pipeline.sh status</code> on the machine holding Postgres.
      </p>
    </div>

    <div class="grid gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="mw-card p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Projects published</p>
        <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{totals.projects.toLocaleString()}</p>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{rows.filter((r) => r.projects > 0).length} of {rows.length} domains</p>
      </div>
      <div class="mw-card p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Videos published</p>
        <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{totals.videos.toLocaleString()}</p>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{totals.enriched.toLocaleString()} with full transcripts ({enrichedPct}%)</p>
      </div>
      <div class="mw-card p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Clean description coverage</p>
        <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{coverage}%</p>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{totals.enriched.toLocaleString()} enriched + {totals.rewritten.toLocaleString()} rewritten</p>
      </div>
      <div class="mw-card p-4">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Raw-description videos</p>
        <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{(totals.videos - totals.enriched - totals.rewritten).toLocaleString()}</p>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">next <code>rewrite_descriptions.py</code> run picks these up</p>
      </div>
    </div>

    <div class="mb-6 mw-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
          <thead class="">
            <tr>
              <th class="p-4 text-xs font-medium text-left text-gray-600 uppercase dark:text-gray-300">Domain</th>
              <th class="p-4 text-xs font-medium text-right text-gray-600 uppercase dark:text-gray-300">Projects</th>
              <th class="p-4 text-xs font-medium text-left text-gray-600 uppercase dark:text-gray-300">Scraped</th>
              <th class="p-4 text-xs font-medium text-left text-gray-600 uppercase dark:text-gray-300">Newest entry</th>
              <th class="p-4 text-xs font-medium text-right text-gray-600 uppercase dark:text-gray-300">Videos</th>
              <th class="p-4 text-xs font-medium text-left text-gray-600 uppercase dark:text-gray-300">Description sources</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
            {rows.map((r) => (
              <tr>
                <td class="p-4 text-sm font-medium text-gray-900 dark:text-white">{r.techName}</td>
                <td class="p-4 text-sm text-right text-gray-700 dark:text-gray-300">{r.projects.toLocaleString()}</td>
                <td class="p-4 text-sm text-gray-500 dark:text-gray-400">{ago(r.scrapedAt)}</td>
                <td class="p-4 text-sm text-gray-500 dark:text-gray-400">{ago(r.newestAddedAt)}</td>
                <td class="p-4 text-sm text-right text-gray-700 dark:text-gray-300">{r.videos}</td>
                <td class="p-4 text-sm">
                  {r.videos === 0 ? (
                    <span class="text-gray-400 dark:text-gray-500">—</span>
                  ) : (
                    <span class="inline-flex items-center gap-2">
                      <span title="Enriched (full transcript + seoDescription)" class="px-2 py-0.5 text-xs font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">{r.enriched} enriched</span>
                      {r.rewritten > 0 && <span title="LLM-rewritten description" class="px-2 py-0.5 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">{r.rewritten} rewritten</span>}
                      {r.rawDesc > 0 && <span title="Sanitized raw YouTube description" class="px-2 py-0.5 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300">{r.rawDesc} raw</span>}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mb-10">
      <h2 class="mb-3 text-lg font-semibold text-gray-900 dark:text-white">Runbook</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {STAGES.map((s, i) => (
          <div class="mw-card p-4">
            <p class="text-xs font-semibold text-gray-400 dark:text-gray-500">STAGE {i + 1}</p>
            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">{s.name}</p>
            <code class="mt-2 block truncate text-xs text-primary-700 dark:text-primary-400" title={s.cmd}>{s.cmd}</code>
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400"><span class="font-medium">Writes:</span> {s.out}</p>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{s.note}</p>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Every stage is idempotent — re-running resumes where the last run stopped. <code>./pipeline.sh ship</code> chains stages 2–6.
      </p>
    </div>
  </div>
</AdminLayout>
