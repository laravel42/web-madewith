---
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
---

<AdminLayout title="Newsletter" active="newsletter">
  <a slot="actions" id="nl-export" href="/admin/api/newsletter/export" class="mw-btn">Export CSV</a>

  <section aria-label="Subscriber metrics" class="grid gap-[18px]" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Active subscribers</span>
        <span class="mw-kpi-icon" style="background:#0f9d581a; color:#0f9d58;">✉</span>
      </div>
      <div id="nl-active" class="mw-kpi-value">—</div>
    </div>
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Network list</span>
        <span class="mw-kpi-icon" style="background:#7C3AED1a; color:#7C3AED;">◧</span>
      </div>
      <div id="nl-network" class="mw-kpi-value">—</div>
    </div>
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Domain lists</span>
        <span class="mw-kpi-icon" style="background:#2F6FEB1a; color:#2F6FEB;">◈</span>
      </div>
      <div id="nl-domain-count" class="mw-kpi-value">—</div>
    </div>
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Unsubscribed</span>
        <span class="mw-kpi-icon" style="background:#6b72801f; color:#6b7280;">⊘</span>
      </div>
      <div id="nl-unsub" class="mw-kpi-value">—</div>
    </div>
  </section>

  <section class="mw-card mt-[18px] overflow-hidden">
    <div class="mw-card-head">
      <h2 class="mw-display text-base m-0">Subscribers</h2>
      <div class="flex-1"></div>
      <select id="nl-status" class="mw-chip" style="appearance:auto;">
        <option value="">All statuses</option>
        <option value="active">Active</option>
        <option value="unsubscribed">Unsubscribed</option>
      </select>
      <select id="nl-slug" class="mw-chip" style="appearance:auto;">
        <option value="">All lists</option>
      </select>
    </div>
    <div class="overflow-x-auto mw-scroll">
      <table class="mw-table">
        <thead>
          <tr><th>Email</th><th>List</th><th>Status</th><th>Subscribed</th><th>Unsubscribed</th></tr>
        </thead>
        <tbody id="nl-rows">
          <tr><td colspan="5">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script>
  import { initNewsletterPage } from "../../admin/scripts/newsletter-admin";
  initNewsletterPage();
</script>
