---
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
import { DOMAINS } from "../../config/domains";
import { getCatalog } from "../../lib/catalog";

let projectsTotal = 0;
const catalogStats = Object.fromEntries(
  DOMAINS.map((d) => {
    try {
      const data = getCatalog(d.slug);
      projectsTotal += data.projects.length;
      return [d.slug, { published: data.projects.length, totalRepos: data.totalRepos, scrapedAt: data.scrapedAt }];
    } catch {
      return [d.slug, { published: 0, totalRepos: 0, scrapedAt: null }];
    }
  }),
);
---

<AdminLayout title="Overview" active="overview">
  <div slot="actions" class="flex gap-2">
    <button id="republish-all" type="button" data-refresh-job class="mw-btn mw-btn-secondary">Republish all</button>
    <button id="refresh-all" type="button" data-refresh-job class="mw-btn">↻ Refresh all</button>
  </div>

  <div id="refresh-job" class="hidden mw-card mb-5 overflow-hidden">
    <div class="flex items-center justify-between gap-3 px-[22px] py-3" style="border-bottom:1px solid #eef0f2;">
      <h2 id="refresh-job-title" class="text-sm font-bold m-0">Refresh</h2>
      <span id="refresh-job-progress-label" class="text-xs font-semibold" style="color:#9aa0a6;">0%</span>
    </div>
    <div class="px-[22px] pt-3 pb-1">
      <progress id="refresh-job-progress" class="h-2 w-full overflow-hidden rounded-full" value="0" max="100"></progress>
    </div>
    <div id="refresh-job-log" class="max-h-48 overflow-y-auto px-[22px] py-3 font-mono text-xs leading-5 mw-scroll" aria-live="polite"></div>
  </div>

  <section aria-label="Key metrics" class="grid gap-[18px]" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Pending submissions</span>
        <span class="mw-kpi-icon" style="background:#FF5D011a; color:#FF5D01;">⊕</span>
      </div>
      <div id="stat-pending" class="mw-kpi-value">—</div>
      <a href="/admin/submissions/" class="text-[12.5px] font-semibold" style="color:#2F6FEB;">Review queue →</a>
    </div>
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Technologies</span>
        <span class="mw-kpi-icon" style="background:#7C3AED1a; color:#7C3AED;">◈</span>
      </div>
      <div id="stat-domains" class="mw-kpi-value">—</div>
      <span class="text-[12.5px]" style="color:#9aa0a6;">tracked catalogs</span>
    </div>
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Projects published</span>
        <span class="mw-kpi-icon" style="background:#2F6FEB1a; color:#2F6FEB;">▤</span>
      </div>
      <div class="mw-kpi-value">{projectsTotal.toLocaleString()}</div>
      <span class="text-[12.5px]" style="color:#9aa0a6;">as of last build</span>
    </div>
    <div class="mw-card mw-kpi">
      <div class="flex items-center justify-between">
        <span class="mw-kpi-label">Last full run</span>
        <span class="mw-kpi-icon" style="background:#0f9d581a; color:#0f9d58;">↻</span>
      </div>
      <div id="stat-lastrun" class="mw-kpi-value" style="font-size:19px; margin-top:16px;">—</div>
      <span class="text-[12.5px]" style="color:#9aa0a6;">scrape or republish</span>
    </div>
  </section>

  <section class="mw-card mt-[18px] overflow-hidden">
    <div class="mw-card-head">
      <h2 class="mw-display text-base m-0">Technologies</h2>
      <span class="mw-count">{DOMAINS.length} tracked</span>
    </div>
    <div class="overflow-x-auto mw-scroll">
      <table class="mw-table">
        <thead>
          <tr>
            <th>Technology</th>
            <th>Published</th>
            <th>Ecosystem</th>
            <th>Last scraped</th>
            <th style="text-align:right; padding-right:22px;">Actions</th>
          </tr>
        </thead>
        <tbody id="domain-rows" data-catalog-stats={JSON.stringify(catalogStats)}>
          <tr><td colspan="5">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script>
  import { initOverviewPage } from "../../admin/scripts/admin";
  initOverviewPage();
</script>
