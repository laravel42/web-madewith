---
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
import { DOMAINS } from "../../config/domains";
import { getCatalog } from "../../lib/catalog";

const catalogStats = Object.fromEntries(
  DOMAINS.map((d) => {
    try {
      const data = getCatalog(d.slug);
      return [d.slug, { published: data.projects.length, totalRepos: data.totalRepos, scrapedAt: data.scrapedAt }];
    } catch {
      return [d.slug, { published: 0, totalRepos: 0, scrapedAt: null }];
    }
  }),
);
---

<AdminLayout title="Overview" active="overview">
  <div class="px-4 pt-6">
    <div class="mb-4 sm:flex sm:items-center sm:justify-between">
      <div>
        <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Overview</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Catalog stats and domain refresh controls</p>
      </div>
      <div class="flex gap-2 mt-4 sm:mt-0">
        <button
          id="republish-all"
          type="button"
          data-refresh-job
          class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700"
        >
          Republish all
        </button>
        <button
          id="refresh-all"
          type="button"
          data-refresh-job
          class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-primary-600 dark:hover:bg-primary-700"
        >
          Refresh all (scrape)
        </button>
      </div>
    </div>

    <div id="refresh-job" class="hidden mb-6 rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-4 py-3 dark:border-gray-700">
        <h2 id="refresh-job-title" class="text-sm font-semibold text-gray-900 dark:text-white">Refresh</h2>
        <span id="refresh-job-progress-label" class="text-xs font-medium text-gray-500 dark:text-gray-400">0%</span>
      </div>
      <div class="px-4 pt-3 pb-1">
        <progress id="refresh-job-progress" class="h-2 w-full overflow-hidden rounded-full accent-primary-600" value="0" max="100"></progress>
      </div>
      <div id="refresh-job-log" class="max-h-48 overflow-y-auto px-4 py-3 font-mono text-xs leading-5" aria-live="polite"></div>
    </div>

    <div class="grid gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Pending submissions</p>
        <p id="stat-pending" class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">—</p>
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Domains</p>
        <p id="stat-domains" class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">—</p>
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:col-span-2 lg:col-span-1">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Last full run</p>
        <p id="stat-lastrun" class="mt-2 text-lg font-semibold text-gray-900 dark:text-white">—</p>
      </div>
    </div>

    <div class="overflow-hidden shadow rounded-lg">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">Domain</th>
              <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">Published</th>
              <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">Ecosystem</th>
              <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">Last scraped</th>
              <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">Actions</th>
            </tr>
          </thead>
          <tbody id="domain-rows" class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" data-catalog-stats={JSON.stringify(catalogStats)}>
            <tr><td colspan="5" class="p-4 text-sm text-gray-500 dark:text-gray-400">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { initOverviewPage } from "../../admin/scripts/admin";
  initOverviewPage();
</script>
