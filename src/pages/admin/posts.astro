---
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
import { getArticles } from "../../lib/blog";

const posts = getArticles().sort((a, b) => b.date.localeCompare(a.date));
const rows = posts.map((p) => ({
  title: p.title,
  desc: p.description,
  date: new Date(p.date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
  href: `/blog/${p.slug}/`,
  tags: [p.primaryTechnology, p.category].filter(Boolean).join(", "),
}));
---

<AdminLayout title="Blog posts" active="posts">
  <section class="mw-card overflow-hidden">
    <div class="mw-card-head">
      <span class="mw-count">{rows.length} posts</span>
      <div class="flex-1"></div>
      <div class="mw-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="#9aa0a6" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="#9aa0a6" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="post-search" aria-label="Search posts" placeholder="Search posts…" />
      </div>
    </div>
    <div class="overflow-x-auto mw-scroll">
      <table class="mw-table">
        <thead>
          <tr><th>Post</th><th>Tags</th><th>Published</th><th style="text-align:right; padding-right:22px;"></th></tr>
        </thead>
        <tbody id="post-rows">
          {rows.map((r) => (
            <tr data-search={`${r.title} ${r.desc} ${r.tags}`.toLowerCase()}>
              <td>
                <div style="display:flex; align-items:center; gap:11px;">
                  <span class="mw-badge" style="background:#FF5D01;">✎</span>
                  <div style="min-width:0;">
                    <div style="font-weight:700; color:#12161a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:420px;">{r.title}</div>
                    <div style="font-size:11.5px; color:#9aa0a6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:420px;">{r.desc}</div>
                  </div>
                </div>
              </td>
              <td>{r.tags || "—"}</td>
              <td class="mw-num">{r.date}</td>
              <td style="text-align:right; padding-right:22px;"><a href={r.href} target="_blank" rel="noopener" style="color:#2F6FEB; font-weight:600;">View ↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div id="post-empty" class="hidden" style="padding:56px; text-align:center; color:#9aa0a6;">
      <div style="font-size:15px; font-weight:600; color:#5c6169;">No posts match your search.</div>
    </div>
  </section>
</AdminLayout>

<script>
  const input = document.getElementById("post-search") as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#post-rows tr"));
  const empty = document.getElementById("post-empty")!;
  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const r of rows) {
      const show = !q || (r.dataset.search ?? "").includes(q);
      r.classList.toggle("hidden", !show);
      if (show) visible++;
    }
    empty.classList.toggle("hidden", visible > 0);
  });
</script>
