---
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
import { DOMAINS } from "../../config/domains";
import { getVideoCatalog } from "../../lib/videos";
import { getTranscript } from "../../lib/transcripts";

const rows: Array<{ id: string; title: string; channel: string; tech: string; slug: string; duration: string; views: number; enriched: boolean; href: string }> = [];
for (const d of DOMAINS) {
  try {
    const cat = getVideoCatalog(d.slug);
    for (const v of cat.videos) {
      rows.push({
        id: v.id, title: v.title, channel: v.channel ?? "", tech: d.techName, slug: d.slug,
        duration: v.duration ?? "—", views: v.views ?? 0, enriched: !!getTranscript(v.id),
        href: `/video/`,
      });
    }
  } catch { /* no videos for this domain */ }
}
rows.sort((a, b) => b.views - a.views);
const enrichedCount = rows.filter((r) => r.enriched).length;
---

<AdminLayout title="Videos" active="videos">
  <section class="mw-card overflow-hidden">
    <div class="mw-card-head">
      <span class="mw-count">{rows.length} videos</span>
      <span class="mw-pill mw-pill-green">{enrichedCount} enriched</span>
      <div class="flex-1"></div>
      <button type="button" class="mw-chip" data-vfilter="" aria-pressed="true">All</button>
      <button type="button" class="mw-chip" data-vfilter="enriched" aria-pressed="false">Enriched</button>
      <button type="button" class="mw-chip" data-vfilter="raw" aria-pressed="false">Not enriched</button>
      <div class="mw-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="#9aa0a6" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="#9aa0a6" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="video-search" aria-label="Search videos" placeholder="Search videos…" />
      </div>
    </div>
    <div class="overflow-x-auto mw-scroll">
      <table class="mw-table">
        <thead>
          <tr><th>Video</th><th>Technology</th><th>Duration</th><th>Views</th><th>Transcript</th></tr>
        </thead>
        <tbody id="video-rows">
          {rows.map((r) => (
            <tr data-search={`${r.title} ${r.channel} ${r.tech}`.toLowerCase()} data-enriched={r.enriched ? "enriched" : "raw"}>
              <td>
                <div style="display:flex; align-items:center; gap:11px;">
                  <span class="mw-badge" style="background:#12161a;">▷</span>
                  <div style="min-width:0;">
                    <div style="font-weight:700; color:#12161a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:420px;">{r.title}</div>
                    <div style="font-size:11.5px; color:#9aa0a6;">{r.channel}</div>
                  </div>
                </div>
              </td>
              <td>{r.tech}</td>
              <td class="mw-num">{r.duration}</td>
              <td class="mw-num">{r.views.toLocaleString()}</td>
              <td>{r.enriched
                ? <span class="mw-pill mw-pill-green">enriched</span>
                : <span class="mw-pill mw-pill-orange">raw</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div id="video-empty" class="hidden" style="padding:56px; text-align:center; color:#9aa0a6;">
      <div style="font-size:15px; font-weight:600; color:#5c6169;">No videos match your filters.</div>
    </div>
  </section>
</AdminLayout>

<script>
  const input = document.getElementById("video-search") as HTMLInputElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-vfilter]"));
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#video-rows tr"));
  const empty = document.getElementById("video-empty")!;
  let filter = "";
  function apply() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const r of rows) {
      const show = (!q || (r.dataset.search ?? "").includes(q)) && (!filter || r.dataset.enriched === filter);
      r.classList.toggle("hidden", !show);
      if (show) visible++;
    }
    empty.classList.toggle("hidden", visible > 0);
  }
  input.addEventListener("input", apply);
  for (const c of chips) {
    c.addEventListener("click", () => {
      filter = c.dataset.vfilter ?? "";
      for (const o of chips) o.setAttribute("aria-pressed", String(o === c));
      apply();
    });
  }
</script>
