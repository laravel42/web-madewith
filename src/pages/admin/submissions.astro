---
import AdminLayout from "../../admin/layouts/AdminLayout.astro";
---

<AdminLayout title="Submissions" active="submissions">
  <div slot="actions">
    <select id="sub-filter" class="mw-btn mw-btn-secondary" style="appearance:auto; padding:9px 12px;">
      <option value="pending">Pending</option>
      <option value="">All</option>
      <option value="approved">Approved</option>
      <option value="rejected">Rejected</option>
    </select>
  </div>

  <section class="mw-card overflow-hidden">
    <div class="mw-card-head">
      <h2 class="mw-display text-base m-0">Project submissions</h2>
      <span class="text-[12.5px]" style="color:#9aa0a6;">Approve to scrape, store, and republish the domain</span>
    </div>
    <div class="overflow-x-auto mw-scroll">
      <table class="mw-table">
        <thead>
          <tr><th>Project</th><th>Domain</th><th>Repo</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody id="sub-rows">
          <tr><td colspan="5">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script>
  import { initSubmissionsPage } from "../../admin/scripts/admin";
  initSubmissionsPage();
</script>
