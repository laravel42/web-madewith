---
import { GROUP_META, getResolvedTheme, networkCardBlurb, networkMetaFor, NETWORK_DOMAINS, type DomainGroup } from "../config/domains";
import { getCatalog } from "../lib/catalog";
import { expandForMarquee, marqueeDuration } from "../lib/marquee-rows";
import NetworkCard from "../components/NetworkCard.astro";
import NetworkFooter from "../components/NetworkFooter.astro";
import ChatWidget from "../components/ChatWidget.astro";
import PageShell from "../components/PageShell.astro";
import PostHog from "../components/PostHog.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/marquee-rows.css";

function siteCard(slug: string) {
  const d = getResolvedTheme(slug);
  const data = getCatalog(d.slug);
  const net = networkMetaFor(d);
  return {
    slug: d.slug,
    techName: d.techName,
    domain: d.domain,
    href: `/${d.slug}/`,
    count: data.projects.length,
    blurb: networkCardBlurb(d),
    ...net,
  };
}

const groups: DomainGroup[] = ["frameworks", "frontend", "backend", "cms-crm", "commerce", "ai-llm"];
const sections = groups
  .map((group) => ({
    group,
    meta: GROUP_META[group],
    sites: NETWORK_DOMAINS.filter((d) => getResolvedTheme(d.slug).group === group).map((d) => siteCard(d.slug)),
  }))
  .filter((s) => s.sites.length > 0);

const site = Astro.site ?? new URL("https://madewithwhat.net");
const canonical = new URL("/", site).href;
const seoTitle = "MadeWithWhat — open-source project galleries for every stack";
const seoDescription = `Browse ${NETWORK_DOMAINS.length} daily-updated showcase galleries across frameworks, frontends, backends, CMS/CRM, commerce, and AI/LLM — indexed from GitHub and ranked by stars.`;
const ogImage = new URL("/favicon.svg", site).href;
const ogCard = new URL("/og.png", site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical}#website`,
      url: canonical,
      name: "MadeWithWhat",
      description: seoDescription,
      inLanguage: "en",
      publisher: { "@id": `${canonical}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${canonical}#organization`,
      name: "MadeWithWhat",
      url: canonical,
      logo: { "@type": "ImageObject", url: ogImage },
    },
    {
      "@type": "CollectionPage",
      "@id": canonical,
      url: canonical,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "en",
      isPartOf: { "@id": `${canonical}#website` },
      about: sections.map(({ meta, sites }) => ({
        "@type": "ItemList",
        name: meta.label,
        numberOfItems: sites.length,
        itemListElement: sites.map((s, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: `Made with ${s.techName}`,
          url: new URL(s.href, site).href,
        })),
      })),
    },
  ],
};

const FONT_HREF =
  "https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;500;700&display=swap";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#12161a" />
    <meta name="generator" content="MadeWithWhat" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="MadeWithWhat Projects" href="/projects/rss.xml" />
    <link rel="alternate" type="text/plain" title="MadeWithWhat LLM context" href="/llms.txt" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MadeWithWhat" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogCard} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogCard} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONT_HREF} rel="stylesheet" />
    <PostHog />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding-left: 20px;
        padding-right: 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: clip;
        font-family: "Hanken Grotesk", sans-serif;
        color: #12161a;
        -webkit-font-smoothing: antialiased;
      }
      a { text-decoration: none; color: inherit; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; width: 100%; }
      .disp { font-family: "Bricolage Grotesque", sans-serif; }
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: stretch; }
      .section { scroll-margin-top: 24px; padding-top: 34px; }
      .section-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 6px;
        margin-bottom: 22px;
      }
      .section-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
      }
      .section-label {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 23px;
        font-weight: 800;
        color: #12161a;
        letter-spacing: -0.02em;
        margin: 0;
        line-height: 1.2;
      }
      .section-count {
        font-size: 12px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        flex-shrink: 0;
      }
      .section-rule {
        flex: 1;
        height: 1px;
      }
      .hero { max-width: 920px; margin: 0 auto; padding: 64px 28px 30px; text-align: center; }
      .hero-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #2c68dd;
        text-transform: uppercase;
        margin-bottom: 18px;
      }
      .hero-title {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: clamp(40px, 8vw, 54px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.04;
        margin: 0;
      }
      .hero-copy {
        font-size: 17px;
        color: #5c6169;
        margin: 18px auto 0;
        line-height: 1.55;
        max-width: 560px;
      }
      .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-top: 30px;
        max-width: 100%;
      }
      .filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 18px;
        white-space: nowrap;
        transition: transform 0.12s ease;
      }
      .filter-pill:hover { transform: translateY(-2px); }
      .network { padding: 24px 0 40px; }
      @media (max-width: 860px) {
        .hero { padding: 40px 0 0; }
        .grid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 560px) {
        .wrap { padding: 0; }
        .grid { display: none; }
      }
    </style>
  </head>
  <body class="has-page-shell">
    <PageShell skipTo="#network" skipLabel="Skip to galleries">
    <SiteHeader active="network" />

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-eyebrow">The MadeWithWhat network</div>
      <h1 class="hero-title" id="hero-title">One catalog engine.<br />A showcase site for every stack.</h1>
      <p class="hero-copy">Each site is a daily-updated gallery of the best open-source projects for a technology, scraped live from GitHub and ranked by stars — themed to its own brand identity.</p>
      <nav class="filter-row" aria-label="Jump to stack category">
        {sections.map(({ group, meta, sites }) => (
          <a
            href={`#${group}`}
            class="filter-pill"
            style={`color:${meta.ink}; background:color-mix(in srgb, ${meta.color} 9%, #ffffff); border:1px solid color-mix(in srgb, ${meta.color} 22%, #ffffff);`}
          >
            <span aria-hidden="true">{meta.icon}</span>
            {meta.label}
          </a>
        ))}
      </nav>
    </section>

    <main id="network" class="wrap network" aria-label="Technology galleries">
      {sections.map(({ group, meta, sites }) => {
        const rowA = expandForMarquee(sites.filter((_, i) => i % 2 === 0));
        const rowB = expandForMarquee(sites.filter((_, i) => i % 2 === 1));
        const rows = [rowA, rowB].filter((row) => row.length > 0);
        return (
        <section class="section" id={group} aria-labelledby={`section-${group}`}>
          <div class="section-head">
            <span class="section-icon" style={`background:${meta.bg}; color:${meta.ink};`} aria-hidden="true">{meta.icon}</span>
            <h2 class="section-label" id={`section-${group}`}>{meta.label}</h2>
            <span class="section-count" style={`color:${meta.ink}; background:color-mix(in srgb, ${meta.color} 12%, #ffffff);`}>
              {sites.length} {sites.length === 1 ? "site" : "sites"}
            </span>
            <span class="section-rule" style={`background:linear-gradient(90deg, color-mix(in srgb, ${meta.color} 30%, #ffffff), transparent);`}></span>
          </div>
          <div class="grid">
            {sites.map((s) => (
              <NetworkCard
                href={s.href}
                techName={s.techName}
                domain={s.domain}
                count={s.count}
                blurb={s.blurb}
                accent={s.accent}
                accentInk={s.accentInk}
                card={s.card}
              />
            ))}
          </div>
          <div class="grid-slideshow is-active" data-marquee>
            {rows.map((row, rowIndex) => (
              <div
                class:list={["grid-slideshow__row", rowIndex === 1 && "grid-slideshow__row--reverse"]}
                data-marquee-row
                data-reverse={rowIndex === 1 ? "true" : undefined}
                style={`--marquee-duration:${marqueeDuration(row.length)};`}
              >
                <div class="grid-slideshow__track">
                  <div class="grid-slideshow__set">
                    {row.map((s) => (
                      <div class="grid-slideshow__item">
                        <NetworkCard
                          href={s.href}
                          techName={s.techName}
                          domain={s.domain}
                          count={s.count}
                          blurb={s.blurb}
                          accent={s.accent}
                          accentInk={s.accentInk}
                          card={s.card}
                        />
                      </div>
                    ))}
                  </div>
                  <div class="grid-slideshow__set" aria-hidden="true">
                    {row.map((s) => (
                      <div class="grid-slideshow__item">
                        <NetworkCard
                          href={s.href}
                          techName={s.techName}
                          domain={s.domain}
                          count={s.count}
                          blurb={s.blurb}
                          accent={s.accent}
                          accentInk={s.accentInk}
                          card={s.card}
                          decorative
                        />
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
        );
      })}
    </main>

    <NetworkFooter />
    </PageShell>
    <ChatWidget />
    <script>
      import { bindAllMarqueeRows } from "../scripts/marquee-rows";
      bindAllMarqueeRows();
    </script>
  </body>
</html>
