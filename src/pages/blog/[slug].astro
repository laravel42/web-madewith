---
import BlogLayout from "../../layouts/BlogLayout.astro";
import BlogArticleView from "../../components/blog/BlogArticleView.astro";
import { blogTechFor } from "../../lib/blog-tech";
import { getArticle, getArticles, articleDeckDescription } from "../../lib/blog";
import { englishDisplayText } from "../../lib/preview-text";

export function getStaticPaths() {
  return getArticles().map((article) => ({ params: { slug: article.slug } }));
}

const { slug } = Astro.params;
const article = getArticle(slug!);
if (!article) return Astro.redirect("/blog/");

const tech = blogTechFor(article.primaryTechnology);
const displayTitle = englishDisplayText(article.title, article.excerpt, article.description);
const displayDescription = articleDeckDescription(article);
const canonicalUrl = article.canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const fallbackJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: displayTitle,
  description: displayDescription,
  datePublished: article.date,
  dateModified: article.updated,
  author: { "@type": "Person", name: article.author },
  publisher: { "@type": "Organization", name: "MadeWithWhat" },
  articleSection: article.category,
  keywords: article.tags.join(", "),
  mainEntityOfPage: canonicalUrl,
};
const jsonLdScript = article.jsonLd ?? JSON.stringify(fallbackJsonLd);
const ogImage = article.image ? new URL(article.image, Astro.site ?? Astro.url).href : undefined;
---
<BlogLayout title={displayTitle} description={displayDescription} active="blog" accent={tech.accent} headerCta={{ href: tech.galleryHref, label: "Gallery ↗" }} ogType="article" canonical={canonicalUrl} image={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLdScript} />
  </Fragment>
  <BlogArticleView article={article} />
</BlogLayout>
