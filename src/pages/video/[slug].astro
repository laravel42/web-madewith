---
import NetworkLayout from "../../layouts/NetworkLayout.astro";
import { allVideoCards, getVideoDetail, isoDuration, slugifyVideo } from "../../lib/video-view";
import { getTranscript, segmentTime } from "../../lib/transcripts";
import { renderArticle } from "../../lib/markdown";
import { MW_LOGOS } from "../../lib/logos";

export function getStaticPaths() {
  return allVideoCards().map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const detail = getVideoDetail(slug!);
if (!detail) return Astro.redirect("/video/");
const { item, related } = detail;

const transcript = getTranscript(item.videoId);
// Transcript chapters carry an anchor slug (v3); fall back to slugifying the
// title for older records so the floating nav still links into the transcript.
const transcriptChapters = (transcript?.chapters ?? []).map((c) => ({
  ...c,
  slug: c.slug ?? slugifyVideo(c.title),
}));

// Prefer transcript-derived chapters (full-video coverage) over the ones parsed
// from the YouTube description; fall back to the description parse.
const chapters = transcriptChapters.length
  ? transcriptChapters.map((c) => ({
      time: segmentTime(c.startTime),
      seconds: Math.floor(c.startTime),
      label: c.title,
      description: c.description,
      slug: c.slug,
    }))
  : item.chapters.map((c) => ({ ...c, slug: undefined as string | undefined, description: "" }));

const summaryHtml = renderArticle(transcript?.summary ?? "");
// The transcription is one `## <chapter>` section per chapter, in order. Inject
// each chapter's anchor id into its H2 so the floating nav links straight in.
let transcriptionHtml = renderArticle(transcript?.transcription ?? "");
let h2Index = 0;
transcriptionHtml = transcriptionHtml.replace(/<h2>/g, () => {
  const slug = transcriptChapters[h2Index]?.slug ?? `section-${h2Index + 1}`;
  h2Index += 1;
  return `<h2 id="${slug}" class="vd-tx-h">`;
});

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(item.href, site).href;
const embedUrl = `https://www.youtube-nocookie.com/embed/${item.videoId}`;
const title = `${item.title} — ${item.techName} video`;
// Prefer the AI-written SEO description (~500 chars) over the raw excerpt.
const description = transcript?.seoDescription ?? item.excerpt;
const topics = [item.techName, item.kind, item.groupLabel];

const playerCover = `linear-gradient(135deg, color-mix(in srgb, ${item.accent} 55%, #000) 0%, ${item.accent} 100%)`;
const logoPath = MW_LOGOS[item.techName] ?? "";
const hasLogo = !!logoPath;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoObject",
      "@id": canonical,
      name: item.title,
      description,
      thumbnailUrl: item.thumbnail ? [item.thumbnail] : undefined,
      uploadDate: item.dateIso,
      duration: isoDuration(item.durationSeconds),
      contentUrl: item.videoUrl,
      embedUrl,
      url: canonical,
      publisher: { "@type": "Organization", name: "MadeWithWhat" },
      author: { "@type": "Person", name: item.channel },
      interactionStatistic: {
        "@type": "InteractionCounter",
        interactionType: { "@type": "WatchAction" },
        userInteractionCount: item.views,
      },
      isPartOf: { "@type": "WebSite", name: "MadeWithWhat", url: new URL("/", site).href },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Videos", item: new URL("/video/", site).href },
        { "@type": "ListItem", position: 2, name: item.title, item: canonical },
      ],
    },
  ],
};
---
<NetworkLayout title={title} description={description} active="video" image={item.thumbnail} ogType="video.other">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="vd">
    <div class="vd-grid">
      <!-- LEFT: hero + player + meta -->
      <div class="vd-main">
        <header class="vd-hero" style={`--cover-accent:${item.accentCover}; --cover-ink:${item.accentInk};`}>
          <div class="vd-hero-top">
            <a href={item.galleryHref} class="vd-hero-tech">
              <span class="vd-hero-logo" aria-hidden="true">
                {hasLogo ? (
                  <svg viewBox="0 0 24 24" width="16" height="16">
                    <path d={logoPath} fill="currentColor" />
                  </svg>
                ) : (
                  <span class="vd-hero-logo-fallback">{item.techName.charAt(0)}</span>
                )}
              </span>
              <span class="vd-hero-tech-copy">
                <span class="vd-hero-eyebrow">Made with</span>
                <span class="vd-hero-tech-name">{item.techName}</span>
              </span>
            </a>
            <span class="vd-hero-kind">{item.kind}</span>
          </div>
          <h1 class="vd-hero-title">{item.title}</h1>
          {hasLogo && (
            <svg class="vd-hero-watermark" viewBox="0 0 24 24" aria-hidden="true">
              <path d={logoPath} fill="currentColor" />
            </svg>
          )}
        </header>

        <div class="vd-player" data-role="player" data-embed={`${embedUrl}?autoplay=1&rel=0`} style={`background:${playerCover};`}>
          {item.thumbnail && <img class="vd-poster-img" src={item.thumbnail} alt="" width="1280" height="720" fetchpriority="high" decoding="async" onerror="this.remove()" />}
          <button type="button" class="vd-play-btn" data-role="play" aria-label="Play video">
            <span class="vd-play-dur">{item.duration}</span>
            <span class="vd-play-circle"><span class="vd-play-tri" style={`border-color:transparent transparent transparent ${item.accent};`}></span></span>
          </button>
        </div>

        <div class="vd-byline">
          <span class="vd-avatar" style={`background:${item.accentSolid}; color:${item.accentInk};`}>{item.channelInitial}</span>
          <div class="vd-byline-text">
            <div class="vd-creator">{item.channel}</div>
            <div class="vd-creator-sub">Creator on the {item.techName} channel</div>
          </div>
          <div class="vd-byline-end">
            <a href={item.videoUrl} target="_blank" rel="noopener" class="vd-watch-btn" style={`background:${item.accentSolid}; color:${item.accentInk};`}>Watch on YouTube ↗</a>
          </div>
        </div>

        <div class="vd-stats">
          <span><strong>{item.viewsLabel}</strong> views</span>
          <span><time datetime={item.dateIso}>{item.dateLabel}</time></span>
          <span>{item.duration} runtime</span>
        </div>

        <div class="vd-panel" data-role="tabs" style={`--tab-accent:${item.accent};`}>
          <div class="vd-tabs" role="tablist" aria-label="Video content">
            <button type="button" class="vd-tab" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true" data-tab="overview">Overview</button>
            {summaryHtml && (
              <button type="button" class="vd-tab" role="tab" id="tab-summary" aria-controls="panel-summary" aria-selected="false" data-tab="summary">Summary</button>
            )}
            {transcriptionHtml && (
              <button type="button" class="vd-tab" role="tab" id="tab-transcript" aria-controls="panel-transcript" aria-selected="false" data-tab="transcript">Transcript</button>
            )}
          </div>

          <div class="vd-tab-panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" data-panel="overview" data-active>
            <div class="vd-overview-desc">
              {item.descriptionParagraphs.map((para) => <p>{para}</p>)}
            </div>

            {chapters.length > 0 && (
              <div class="vd-chapters">
                <div class="vd-chapters-head">Chapters</div>
                <div class="vd-chapters-list">
                  {chapters.map((ch) => (
                    <button type="button" class="vd-chapter" data-chapter data-seconds={ch.seconds}>
                      <span class="vd-chapter-time" style={`color:${item.accentOnLight};`}>{ch.time}</span>
                      <span class="vd-chapter-copy">
                        <span class="vd-chapter-label">{ch.label}</span>
                        {"description" in ch && ch.description && <span class="vd-chapter-description">{ch.description}</span>}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            <div class="vd-topics">
              {topics.map((t) => <span class="vd-topic">#{t.replace(/[^A-Za-z0-9]+/g, "").toLowerCase()}</span>)}
            </div>
          </div>

          {summaryHtml && (
            <div class="vd-tab-panel" role="tabpanel" id="panel-summary" aria-labelledby="tab-summary" data-panel="summary" hidden>
              <div class="vd-article-body" set:html={summaryHtml} />
            </div>
          )}

          {transcriptionHtml && (
            <div
              class="vd-tab-panel"
              role="tabpanel"
              id="panel-transcript"
              aria-labelledby="tab-transcript"
              data-panel="transcript"
              data-toc-mode="chips"
              hidden
            >
              {/*
                TOC modes (set data-toc-mode on this panel):
                  - chips  (default / option A): horizontal scrollable chapter chips above the body
                  - float  (option B): floating "Chapters" button with dropdown overlay
              */}
              {transcriptChapters.length > 1 && (
                <>
                  <nav class="vd-toc vd-toc--chips" aria-label="Transcript chapters">
                    <div class="vd-toc-chips" style={`--chip-accent:${item.accent}; --chip-ink:${item.accentOnLight};`}>
                      {transcriptChapters.map((c) => (
                        <a href={`#${c.slug}`} class="vd-toc-chip">
                          <span class="vd-toc-chip-time">{segmentTime(c.startTime)}</span>
                          <span class="vd-toc-chip-title">{c.title}</span>
                        </a>
                      ))}
                    </div>
                  </nav>

                  <div class="vd-toc vd-toc--float" data-role="toc-float">
                    <button type="button" class="vd-toc-float-btn" data-role="toc-float-toggle" aria-expanded="false" aria-controls="vd-toc-float-menu">
                      Chapters
                      <span class="vd-toc-float-count">{transcriptChapters.length}</span>
                    </button>
                    <nav id="vd-toc-float-menu" class="vd-toc-float-menu" hidden aria-label="Transcript chapters">
                      <div class="vd-toc-float-head">On this page</div>
                      <ol class="vd-toc-float-list">
                        {transcriptChapters.map((c) => (
                          <li>
                            <a href={`#${c.slug}`} class="vd-toc-float-link">
                              <span class="vd-toc-float-time" style={`color:${item.accentOnLight};`}>{segmentTime(c.startTime)}</span>
                              <span>{c.title}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </nav>
                  </div>
                </>
              )}
              <div class="vd-transcript-body vd-article-body" set:html={transcriptionHtml} />
            </div>
          )}
        </div>
      </div>

      <!-- RIGHT: related -->
      <aside class="vd-related" aria-label="Related videos">
        <div class="vd-related-head">Related videos</div>
        <div class="vd-related-list">
          {related.map((r) => (
            <a href={r.href} class="vd-related-item">
              <div class="vd-related-cover" style={`background:linear-gradient(135deg, color-mix(in srgb, ${r.accentCover} 82%, #000), ${r.accentCover});`}>
                {r.thumbnail && <img src={r.thumbnail} alt="" width="150" height="84" loading="lazy" decoding="async" onerror="this.remove()" />}
                <span class="vd-related-dur">{r.duration}</span>
              </div>
              <div class="vd-related-text">
                <div class="vd-related-tech" style={`color:${r.accentOnLight};`}>{r.techName}</div>
                <div class="vd-related-title">{r.title}</div>
                <div class="vd-related-sub">{r.channel} · {r.viewsLabel} views</div>
              </div>
            </a>
          ))}
        </div>
        <a href="/video/" class="vd-related-all">Browse the full collection →</a>
      </aside>
    </div>
  </main>

  <style>
    .vd { max-width: 1180px; margin: 0 auto; padding: 22px 24px 20px; width: 100%; }
    /* minmax(0,…) so long transcript/chip content can't blow out the page width */
    .vd-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 22px; align-items: start; }
    .vd-main { min-width: 0; }

    .vd-hero {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 14px;
      padding: 12px 16px 14px;
      border-radius: 14px;
      overflow: hidden;
      color: #fff;
      /* --cover-accent is `accentCover`, the AA-safe light end for white text. */
      background:
        radial-gradient(circle at 82% 16%, rgb(255 255 255 / 24%) 0 2px, transparent 3px),
        radial-gradient(circle at 82% 16%, transparent 0 28px, rgb(255 255 255 / 12%) 29px 30px, transparent 31px),
        linear-gradient(135deg, color-mix(in srgb, var(--cover-accent) 76%, #111) 0%, var(--cover-accent) 100%);
      box-shadow: 0 1px 0 rgb(255 255 255 / 45%) inset, 0 18px 40px -22px rgb(20 20 40 / 40%);
    }
    .vd-hero::before,
    .vd-hero::after { content: ""; position: absolute; pointer-events: none; }
    .vd-hero::before {
      width: 72px; height: 72px; top: -34px; right: -14px;
      border: 1px solid rgb(255 255 255 / 20%); border-radius: 18px; transform: rotate(24deg);
    }
    .vd-hero::after {
      inset: 0; opacity: 0.12;
      background-image:
        linear-gradient(rgb(255 255 255 / 35%) 1px, transparent 1px),
        linear-gradient(90deg, rgb(255 255 255 / 35%) 1px, transparent 1px);
      background-size: 20px 20px;
      mask-image: linear-gradient(90deg, transparent 25%, #000);
    }
    .vd-hero-top {
      position: relative; z-index: 1;
      display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
    }
    .vd-hero-tech {
      display: inline-flex; align-items: center; gap: 8px; color: #fff; text-decoration: none;
    }
    .vd-hero-tech:hover .vd-hero-tech-name { text-decoration: underline; text-underline-offset: 3px; }
    .vd-hero-logo {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 8px;
      background: rgb(255 255 255 / 16%); border: 1px solid rgb(255 255 255 / 22%);
      backdrop-filter: blur(6px); color: #fff; flex-shrink: 0;
    }
    .vd-hero-logo-fallback {
      font-family: "Bricolage Grotesque", sans-serif; font-size: 13px; font-weight: 800; line-height: 1;
    }
    .vd-hero-tech-copy { display: flex; flex-direction: column; gap: 0; }
    /* Full-strength white: at 9px even the AA-safe cover can't carry a 78% tint. */
    .vd-hero-eyebrow {
      font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.2;
    }
    .vd-hero-tech-name {
      font-family: "Bricolage Grotesque", sans-serif; font-size: 13.5px; font-weight: 800;
      letter-spacing: -0.02em; line-height: 1.15;
    }
    .vd-hero-kind {
      position: relative; z-index: 1;
      font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; white-space: nowrap;
      border: 1px solid rgb(255 255 255 / 28%); background: rgb(0 0 0 / 22%); backdrop-filter: blur(6px);
    }
    .vd-hero-title {
      position: relative; z-index: 1; margin: 0; max-width: 92%;
      font-family: "Bricolage Grotesque", sans-serif; font-size: 20px; font-weight: 800;
      line-height: 1.15; letter-spacing: -0.03em;
    }
    .vd-hero-watermark {
      position: absolute; right: 10px; bottom: -8px; width: 64px; height: 64px;
      opacity: 0.12; pointer-events: none; color: #fff;
    }

    .vd-player { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; box-shadow: 0 1px 0 rgb(255 255 255 / 60%) inset, 0 26px 64px -20px rgb(20 20 40 / 32%); }
    .vd-poster-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .vd-player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .vd-play-btn { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: transparent; cursor: pointer; padding: 0; }
    .vd-play-dur { position: absolute; bottom: 20px; right: 20px; font-size: 13px; font-weight: 700; color: #fff; background: rgb(0 0 0 / 55%); padding: 5px 11px; border-radius: 8px; font-variant-numeric: tabular-nums; }
    .vd-play-circle { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 88px; height: 88px; border-radius: 50%; background: rgb(255 255 255 / 94%); display: flex; align-items: center; justify-content: center; box-shadow: 0 12px 34px rgb(0 0 0 / 32%); transition: transform 0.15s ease; }
    .vd-play-btn:hover .vd-play-circle { transform: translate(-50%, -50%) scale(1.05); }
    .vd-play-tri { width: 0; height: 0; border-style: solid; border-width: 16px 0 16px 26px; margin-left: 5px; }

    .vd-byline { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 18px; padding: 14px 16px; background: #fff; border: 1px solid #e9ebee; border-radius: 16px; box-shadow: 0 6px 18px -14px rgb(20 20 40 / 30%); }
    .vd-avatar { width: 44px; height: 44px; border-radius: 50%; font-weight: 700; font-size: 17px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 12px -4px rgb(0 0 0 / 30%); }
    .vd-byline-text { min-width: 0; }
    .vd-creator { font-size: 15px; font-weight: 700; color: #12161a; }
    .vd-creator-sub { font-size: 12.5px; color: #5c665f; margin-top: 1px; }
    .vd-byline-end { flex: 1; display: flex; justify-content: flex-end; }
    .vd-watch-btn { font-size: 13px; font-weight: 700; padding: 10px 16px; border-radius: 22px; white-space: nowrap; text-decoration: none; box-shadow: 0 8px 20px -10px rgb(20 20 40 / 45%); transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .vd-watch-btn:hover { transform: translateY(-1px); box-shadow: 0 12px 26px -10px rgb(20 20 40 / 50%); text-decoration: none; }

    .vd-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 16px; font-size: 13px; color: #5c6169; }
    .vd-stats > span { display: inline-flex; align-items: center; gap: 5px; background: #f2f4f6; border: 1px solid #e9ebee; padding: 6px 12px; border-radius: 20px; }
    .vd-stats strong { color: #12161a; font-variant-numeric: tabular-nums; }

    .vd-panel { margin-top: 20px; background: #fff; border: 1px solid #e9ebee; border-radius: 16px; box-shadow: 0 6px 20px -16px rgb(20 20 40 / 30%); overflow: hidden; }
    .vd-tabs {
      display: flex; flex-wrap: wrap; gap: 2px; padding: 8px 10px 0;
      border-bottom: 1px solid #eef0f2; background: #fafbfc;
    }
    .vd-tab {
      appearance: none; border: 0; background: transparent; cursor: pointer;
      font-size: 13.5px; font-weight: 700; color: #6b717a;
      padding: 11px 14px 12px; border-radius: 10px 10px 0 0;
      border-bottom: 2px solid transparent; margin-bottom: -1px;
      transition: color 0.12s ease, background 0.12s ease;
    }
    .vd-tab:hover { color: #12161a; background: rgb(255 255 255 / 70%); }
    .vd-tab[aria-selected="true"] {
      color: #12161a; background: #fff;
      border-bottom-color: var(--tab-accent, #2c65f0);
    }
    .vd-tab-panel { display: none; padding: 22px 24px; }
    .vd-tab-panel[data-active] { display: block; }
    .vd-overview-desc { font-size: 15px; color: #3a4048; line-height: 1.7; overflow-wrap: anywhere; word-break: break-word; }
    .vd-overview-desc p { margin: 0 0 14px; }
    .vd-overview-desc p:last-child { margin-bottom: 0; }

    .vd-chapters { margin-top: 20px; padding-top: 18px; border-top: 1px solid #eef0f2; }
    .vd-chapters-head { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; color: #5c665f; text-transform: uppercase; margin-bottom: 12px; }
    .vd-chapters-list { display: flex; flex-direction: column; gap: 2px; }
    .vd-chapter { display: flex; align-items: flex-start; gap: 14px; width: 100%; text-align: left; padding: 9px 10px; border: 0; background: transparent; border-radius: 10px; cursor: pointer; transition: background 0.12s ease; }
    .vd-chapter:hover, .vd-chapter[data-active] { background: #f4f5f7; }
    .vd-chapter-time { font-family: "Bricolage Grotesque", sans-serif; font-size: 13px; font-weight: 700; min-width: 52px; flex-shrink: 0; font-variant-numeric: tabular-nums; padding-top: 1px; }
    .vd-chapter-copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .vd-chapter-label { font-size: 14px; color: #12161a; line-height: 1.4; }
    .vd-chapter-description { font-size: 12.5px; color: #6b717a; line-height: 1.45; }

    .vd-article-body { font-size: 15.5px; color: #2b3138; line-height: 1.75; overflow-wrap: anywhere; word-break: break-word; }
    .vd-article-body :global(h2) { font-family: "Bricolage Grotesque", sans-serif; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; color: #12161a; margin: 30px 0 12px; }
    .vd-article-body :global(h3) { font-family: "Bricolage Grotesque", sans-serif; font-size: 17px; font-weight: 700; line-height: 1.3; color: #12161a; margin: 24px 0 10px; }
    .vd-article-body :global(h2:first-child), .vd-article-body :global(h3:first-child) { margin-top: 0; }
    .vd-article-body :global(p) { margin: 0 0 14px; }
    .vd-article-body :global(em) { color: #5c6169; }
    .vd-article-body :global(ul), .vd-article-body :global(ol) { margin: 0 0 16px; padding-left: 22px; }
    .vd-article-body :global(li) { margin: 4px 0; }
    /* Markers carry list structure, so they hold ~3:1 rather than fading out. */
    .vd-article-body :global(li::marker) { color: #8b9199; }
    .vd-article-body :global(a) { color: #2a63ec; text-decoration: none; }
    .vd-article-body :global(a:hover) { text-decoration: underline; }
    .vd-article-body :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.86em; background: #f2f4f6; border: 1px solid #e9ebee; padding: 1px 5px; border-radius: 5px; }
    .vd-article-body :global(pre) { background: #12161a; color: #e6e9ef; border-radius: 12px; padding: 16px 18px; overflow-x: auto; margin: 0 0 16px; font-size: 13px; line-height: 1.6; }
    .vd-article-body :global(pre code) { background: none; border: 0; padding: 0; color: inherit; font-size: 13px; }
    .vd-article-body :global(blockquote) { margin: 0 0 16px; padding: 12px 16px; border-left: 3px solid #d7dbe0; background: #f7f8fa; border-radius: 0 10px 10px 0; color: #3a4048; }
    .vd-article-body :global(blockquote p) { margin: 0 0 6px; }
    .vd-article-body :global(blockquote p:last-child) { margin-bottom: 0; }
    .vd-article-body :global(.callout) { border-left-width: 3px; border-left-style: solid; }
    .vd-article-body :global(.callout-title) { font-weight: 700; font-size: 12.5px; letter-spacing: 0.02em; text-transform: uppercase; }
    .vd-article-body :global(.callout-note) { border-left-color: #4a8cff; background: #eef4ff; }
    .vd-article-body :global(.callout-note .callout-title) { color: #2c65f0; }
    .vd-article-body :global(.callout-tip) { border-left-color: #1fb26b; background: #ecfaf2; }
    .vd-article-body :global(.callout-tip .callout-title) { color: #11824b; }
    .vd-article-body :global(.callout-important) { border-left-color: #8a63ff; background: #f2eeff; }
    .vd-article-body :global(.callout-important .callout-title) { color: #6a3fe0; }
    .vd-article-body :global(.callout-warning), .vd-article-body :global(.callout-caution) { border-left-color: #f0a020; background: #fff6e8; }
    .vd-article-body :global(.callout-warning .callout-title), .vd-article-body :global(.callout-caution .callout-title) { color: #a16408; }

    /* Default A: chips. Alternate B: float. Toggle via data-toc-mode on #panel-transcript. */
    .vd-toc--chips,
    .vd-toc--float { display: none; }
    #panel-transcript[data-toc-mode="chips"] .vd-toc--chips { display: block; }
    #panel-transcript[data-toc-mode="float"] .vd-toc--float { display: block; }

    .vd-toc--chips { margin: 0 0 18px; min-width: 0; max-width: 100%; }
    .vd-toc-chips {
      display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px;
      min-width: 0; max-width: 100%;
      scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;
      mask-image: linear-gradient(90deg, #000 0%, #000 calc(100% - 28px), transparent);
    }
    .vd-toc-chips::-webkit-scrollbar { height: 4px; }
    .vd-toc-chips::-webkit-scrollbar-thumb { background: #d7dbe0; border-radius: 4px; }
    .vd-toc-chip {
      display: inline-flex; align-items: center; gap: 7px; flex: 0 0 auto;
      max-width: 220px; padding: 7px 12px; border-radius: 999px;
      background: #f2f4f6; border: 1px solid #e9ebee; color: #3a4048;
      font-size: 12.5px; line-height: 1.25; text-decoration: none; scroll-snap-align: start;
      transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
    }
    .vd-toc-chip:hover,
    .vd-toc-chip[aria-current="true"] {
      background: color-mix(in srgb, var(--chip-accent, #2c65f0) 12%, #fff);
      border-color: color-mix(in srgb, var(--chip-accent, #2c65f0) 35%, #e9ebee);
      color: #12161a;
    }
    .vd-toc-chip-time {
      font-family: "Bricolage Grotesque", sans-serif; font-weight: 700;
      /* --chip-accent only tints the chip; the timecode uses the AA-safe ink. */
      font-variant-numeric: tabular-nums; color: var(--chip-ink, #2a63ec); flex-shrink: 0;
    }
    .vd-toc-chip-title {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    .vd-toc--float { position: sticky; top: 18px; z-index: 5; height: 0; margin: 0; }
    .vd-toc-float-btn {
      position: absolute; right: 0; top: 0; display: inline-flex; align-items: center; gap: 8px;
      appearance: none; border: 1px solid #e6e8eb; background: #fff; color: #12161a;
      font-size: 13px; font-weight: 700; padding: 9px 13px; border-radius: 999px; cursor: pointer;
      box-shadow: 0 8px 22px -12px rgb(20 20 40 / 40%);
    }
    .vd-toc-float-btn[aria-expanded="true"] { border-color: #cfd4da; }
    .vd-toc-float-count {
      font-size: 11px; font-weight: 700; min-width: 20px; height: 20px; padding: 0 6px;
      border-radius: 999px; background: #f2f4f6; color: #5c6169;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .vd-toc-float-menu {
      position: absolute; right: 0; top: 46px; width: min(300px, calc(100vw - 48px));
      max-height: min(60vh, 420px); overflow-y: auto;
      background: #fff; border: 1px solid #e6e8eb; border-radius: 14px;
      box-shadow: 0 18px 40px -18px rgb(20 20 40 / 40%); padding: 12px 10px;
    }
    .vd-toc-float-head {
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: #5c665f;
      text-transform: uppercase; padding: 0 8px 8px;
    }
    .vd-toc-float-list { list-style: none; margin: 0; padding: 0; }
    .vd-toc-float-list li { margin: 0; }
    .vd-toc-float-link {
      display: flex; gap: 10px; padding: 8px; border-radius: 10px;
      font-size: 13px; line-height: 1.35; color: #3a4048; text-decoration: none;
    }
    .vd-toc-float-link:hover,
    .vd-toc-float-link[aria-current="true"] { background: #f4f5f7; color: #12161a; }
    .vd-toc-float-time {
      font-family: "Bricolage Grotesque", sans-serif; font-weight: 700;
      font-variant-numeric: tabular-nums; flex-shrink: 0; min-width: 36px;
    }

    .vd-transcript-body,
    .vd-tab-panel { min-width: 0; }
    .vd-transcript-body :global(.vd-tx-h) { scroll-margin-top: 96px; padding-top: 6px; border-top: 1px solid #f1f2f4; }
    .vd-transcript-body :global(.vd-tx-h:first-child) { border-top: 0; padding-top: 0; }

    .vd-topics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; padding-top: 18px; border-top: 1px solid #eef0f2; }
    .vd-topic { font-size: 12.5px; font-weight: 600; color: #5c6169; background: #f2f4f6; padding: 6px 12px; border-radius: 20px; transition: background 0.15s ease, color 0.15s ease; }
    .vd-topic:hover { background: #e9edf1; color: #12161a; }

    .vd-related { position: sticky; top: 18px; }
    .vd-related-head { font-family: "Bricolage Grotesque", sans-serif; font-size: 15px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 12px; }
    .vd-related-list { display: flex; flex-direction: column; gap: 12px; }
    .vd-related-item { display: grid; grid-template-columns: 120px 1fr; gap: 10px; align-items: start; color: inherit; text-decoration: none; }
    .vd-related-cover { position: relative; width: 120px; height: 68px; border-radius: 10px; overflow: hidden; }
    .vd-related-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .vd-related-dur { position: absolute; bottom: 5px; right: 5px; font-size: 10px; font-weight: 700; color: #fff; background: rgb(0 0 0 / 60%); padding: 2px 5px; border-radius: 5px; font-variant-numeric: tabular-nums; }
    .vd-related-tech { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .vd-related-title { font-size: 13px; font-weight: 700; line-height: 1.3; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .vd-related-sub { font-size: 11.5px; color: #5c665f; margin-top: 5px; }
    .vd-related-all { display: block; text-align: center; margin-top: 14px; font-size: 13px; font-weight: 700; color: #12161a; background: #fff; border: 1px solid #e6e8eb; padding: 10px; border-radius: 12px; }

    @media (max-width: 940px) {
      .vd-grid { grid-template-columns: 1fr; gap: 20px; }
      .vd-related { position: static; }
      .vd-hero { padding: 10px 14px 12px; }
      .vd-hero-title { max-width: 100%; font-size: 18px; }
      .vd-hero-watermark { width: 56px; height: 56px; right: 8px; }
    }
  </style>

  <script>
    function initVideoPlayer() {
      const player = document.querySelector<HTMLElement>('[data-role="player"]');
      if (!player || player.dataset.wired) return;
      player.dataset.wired = "1";

      const mount = (startSeconds?: number) => {
        const base = player.dataset.embed;
        if (!base) return;
        const src = startSeconds ? `${base}&start=${startSeconds}` : base;
        const iframe = document.createElement("iframe");
        iframe.src = src;
        iframe.title = "YouTube video player";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.setAttribute("allowfullscreen", "");
        player.replaceChildren(iframe);
      };

      player.querySelector<HTMLElement>('[data-role="play"]')?.addEventListener("click", () => mount());

      document.querySelectorAll<HTMLElement>("[data-chapter]").forEach((chapter) => {
        chapter.addEventListener("click", () => {
          const seconds = Number(chapter.dataset.seconds) || 0;
          document.querySelectorAll("[data-chapter][data-active]").forEach((el) => el.removeAttribute("data-active"));
          chapter.setAttribute("data-active", "");
          mount(seconds);
          player.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    }

    function initVideoTabs() {
      const root = document.querySelector<HTMLElement>('[data-role="tabs"]');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = "1";

      const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

      const activate = (name: string) => {
        tabs.forEach((tab) => {
          const on = tab.dataset.tab === name;
          tab.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach((panel) => {
          const on = panel.dataset.panel === name;
          if (on) {
            panel.setAttribute("data-active", "");
            panel.removeAttribute("hidden");
          } else {
            panel.removeAttribute("data-active");
            panel.setAttribute("hidden", "");
          }
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activate(tab.dataset.tab || "overview"));
      });
    }

    function initTocFloat() {
      const root = document.querySelector<HTMLElement>('[data-role="toc-float"]');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = "1";

      const toggle = root.querySelector<HTMLButtonElement>('[data-role="toc-float-toggle"]');
      const menu = root.querySelector<HTMLElement>("#vd-toc-float-menu");
      if (!toggle || !menu) return;

      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        if (open) menu.removeAttribute("hidden");
        else menu.setAttribute("hidden", "");
      };

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });
      document.addEventListener("click", (e) => {
        if (!root.contains(e.target as Node)) setOpen(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    }

    function initVideoPage() {
      initVideoPlayer();
      initVideoTabs();
      initTocFloat();
    }
    initVideoPage();
    document.addEventListener("astro:page-load", initVideoPage);
  </script>
</NetworkLayout>
