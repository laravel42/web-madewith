---
import { BLOG_CATEGORIES, articleIndexItem, getArticles, safeJsonForScript } from "../../lib/blog";

const articles = getArticles().map(articleIndexItem);
const featured = articles[0];
const categories = BLOG_CATEGORIES.filter((c) => c !== "All");
const articlesJson = safeJsonForScript(articles);
---

<main>
  <section class="blog-hero">
    <div class="blog-hero-eyebrow">The MadeWithWhat blog</div>
    <h1 class="blog-hero-title">Guides &amp; deep-dives<br />for every stack.</h1>
    <p class="blog-hero-copy">Tutorials, architecture patterns and performance write-ups across all technologies in the network.</p>

    <div class="blog-hero-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="#9aa0a6" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="#9aa0a6" stroke-width="2" stroke-linecap="round"/></svg>
      <input data-role="blog-search" type="search" aria-label="Search articles" placeholder="Search articles, tech, topics…" />
    </div>

    <nav data-role="blog-cats" class="blog-hero-cats" aria-label="Blog categories">
      {BLOG_CATEGORIES.map((label, index) => (
        <button
          type="button"
          data-cat={label}
          class:list={["blog-cat-pill", index === 0 && "is-active"]}
        >{label}</button>
      ))}
    </nav>
  </section>

  <section data-role="blog-featured" aria-label="Featured article" style="max-width:1080px; margin:0 auto; padding:30px 28px 8px; width:100%;">
    {featured && (
      <a href={featured.href} class="blog-featured" style="display:grid; grid-template-columns:1.05fr 1fr; gap:0; background:#fff; border:1px solid #e9ebee; border-radius:20px; overflow:hidden; box-shadow:0 20px 50px rgba(20,30,50,.06);">
        <div style={`position:relative; min-height:320px; background:linear-gradient(135deg, color-mix(in srgb, ${featured.tech.accent} 55%, #000) 0%, ${featured.tech.accent} 100%); display:flex; align-items:flex-end; padding:26px;`}>
          <span style="position:absolute; top:22px; left:22px; font-size:12px; font-weight:700; color:#fff; background:rgba(0,0,0,.22); padding:5px 12px; border-radius:20px;">Featured · {featured.category}</span>
          <span class="disp" style="font-weight:800; font-size:120px; color:rgba(255,255,255,.16); line-height:.8;">{featured.tech.techName.charAt(0)}</span>
        </div>
        <div style="padding:34px; display:flex; flex-direction:column; justify-content:center;">
          <div style={`font-size:12.5px; font-weight:700; color:${featured.tech.accent}; text-transform:uppercase; letter-spacing:.05em;`}>{featured.primaryTechnology}</div>
          <h2 class="disp" style="font-size:30px; font-weight:800; letter-spacing:-0.02em; line-height:1.12; margin:9px 0 0;">{featured.title}</h2>
          <p style="font-size:15.5px; color:#5c6169; line-height:1.6; margin:14px 0 0;">{featured.excerpt}</p>
          <div style="display:flex; align-items:center; gap:11px; margin-top:22px;">
            <span style={`width:38px; height:38px; border-radius:50%; background:${featured.tech.accent}; color:${featured.tech.accentInk}; font-weight:700; font-size:15px; display:inline-flex; align-items:center; justify-content:center;`}>{featured.authorInitial}</span>
            <div>
              <address style="font-style:normal; font-size:14px; font-weight:600; color:#12161a;">{featured.author}</address>
              <div style="font-size:12.5px; color:#9aa0a6;"><time datetime={featured.date}>{featured.dateLabel}</time> · {featured.readMin} min</div>
            </div>
          </div>
        </div>
      </a>
    )}
  </section>

  <section aria-label="Articles" style="max-width:1080px; margin:0 auto; padding:30px 28px 20px; width:100%;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:20px; gap:16px;">
      <h2 data-role="blog-results-label" class="disp" style="font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:0;">Latest articles</h2>
      <span data-role="blog-count-label" style="font-size:13px; color:#9aa0a6;">{articles.length} articles</span>
    </div>

    <div data-role="blog-grid" class="blog-grid-3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:22px;"></div>

    <div data-role="blog-empty" hidden style="text-align:center; padding:64px 0; color:#9aa0a6;">
      <div style="font-size:17px; font-weight:600; color:#5c6169;">No articles match your filters.</div>
      <div style="font-size:14px; margin-top:6px;">Try a different search term or category.</div>
      <button type="button" data-role="blog-reset" style="display:inline-block; margin-top:18px; font-size:14px; font-weight:600; color:#fff; background:#12161a; padding:10px 18px; border-radius:22px; cursor:pointer; border:none; font-family:inherit;">Clear filters</button>
    </div>

    <nav data-role="blog-pager" aria-label="Pagination" hidden style="display:flex; align-items:center; justify-content:center; gap:8px; margin-top:40px;"></nav>
  </section>

  <section aria-label="Newsletter" style="max-width:1080px; margin:0 auto; padding:26px 28px 70px; width:100%;">
    <div style="background:linear-gradient(135deg,#141a2e,#1f2b52); border-radius:20px; padding:40px; display:flex; align-items:center; justify-content:space-between; gap:30px; flex-wrap:wrap;">
      <div style="max-width:460px;">
        <h2 class="disp" style="font-size:26px; font-weight:800; letter-spacing:-0.02em; color:#fff; margin:0;">One email a week. Every stack.</h2>
        <p style="font-size:15px; color:#b8c0d4; margin:10px 0 0; line-height:1.55;">The best new guides across the network, hand-picked. No spam, unsubscribe anytime.</p>
      </div>
      <form action="/newsletter/" method="get" style="display:flex; gap:10px; flex:1; min-width:280px; max-width:420px;">
        <input type="email" name="email" aria-label="Email address" placeholder="you@example.com" style="flex:1; border:none; border-radius:12px; padding:14px 16px; font-size:15px; outline:none; font-family:inherit;" />
        <button type="submit" style="background:#2F6FEB; color:#fff; border:none; font-weight:700; font-size:15px; padding:14px 22px; border-radius:12px; cursor:pointer; font-family:inherit; white-space:nowrap;">Subscribe</button>
      </form>
    </div>
  </section>
</main>

<style>
  .blog-hero-search {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 26px auto 0;
    max-width: 460px;
    background: #fff;
    border: 1px solid #e3e6ea;
    border-radius: 13px;
    padding: 12px 15px;
    box-shadow: 0 6px 18px rgba(20, 30, 50, 0.04);
  }

  .blog-hero-search input {
    border: none;
    outline: none;
    background: transparent;
    font-size: 15px;
    width: 100%;
    color: #12161a;
    font-family: inherit;
  }

  .blog-hero-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 18px;
  }

  .blog-cat-pill {
    font-size: 12px;
    font-weight: 600;
    color: #3a4048;
    background: #fff;
    border: 1px solid #e6e8eb;
    padding: 6px 12px;
    border-radius: 18px;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.12s ease;
  }

  .blog-cat-pill:hover {
    transform: translateY(-2px);
  }

  .blog-cat-pill.is-active {
    font-weight: 700;
    color: #fff;
    background: #12161a;
    border-color: #12161a;
  }

  .blog-featured {
    text-decoration: none;
    color: inherit;
  }

  .blog-index-card :global(a) {
    text-decoration: none;
    color: inherit;
  }
</style>

<script id="blog-articles" type="application/json" set:html={articlesJson}></script>
<script define:vars={{ featuredSlug: featured?.slug ?? "", categories }}>
  function initBlogIndex() {
    const dataEl = document.getElementById("blog-articles");
    const grid = document.querySelector("[data-role=blog-grid]");
    const empty = document.querySelector("[data-role=blog-empty]");
    const pager = document.querySelector("[data-role=blog-pager]");
    const featured = document.querySelector("[data-role=blog-featured]");
    const search = document.querySelector("[data-role=blog-search]");
    const catWrap = document.querySelector("[data-role=blog-cats]");
    const resultsLabel = document.querySelector("[data-role=blog-results-label]");
    const countLabel = document.querySelector("[data-role=blog-count-label]");
    const resetBtn = document.querySelector("[data-role=blog-reset]");
    if (!dataEl || !grid || !empty || !pager || !search || !catWrap || !resultsLabel || !countLabel) return;
    if (grid.dataset.initialized) return;
    grid.dataset.initialized = "true";

    const articles = JSON.parse(dataEl.textContent || "[]");
    const PAGE_SIZE = 6;
    const state = { query: "", cat: "All", page: 1 };

    function setCatActive(btn, active) {
      btn.classList.toggle("is-active", active);
    }

    function cardHtml(item) {
      return `<article class="blog-index-card" style="background:#fff; border:1px solid #e9ebee; border-radius:16px; overflow:hidden; transition:transform .15s ease, box-shadow .15s ease;">
        <a href="${item.href}" aria-label="Read: ${item.title}">
          <div style="${item.coverStyle}"><span style="${item.tagChipStyle}">${item.category}</span></div>
          <div style="padding:16px 17px 18px;">
            <div style="font-size:12px; font-weight:700; color:${item.tech.accent}; text-transform:uppercase; letter-spacing:.04em;">${item.primaryTechnology}</div>
            <h3 style="font-size:17px; font-weight:800; letter-spacing:-0.01em; line-height:1.28; margin:6px 0 0;">${item.title}</h3>
            <p style="font-size:13.5px; color:#6b7178; line-height:1.5; margin:9px 0 0; min-height:40px;">${item.excerpt}</p>
            <div style="display:flex; align-items:center; gap:8px; margin-top:14px; font-size:12.5px; color:#9aa0a6;">
              <span style="${item.avatarStyle}">${item.authorInitial}</span>${item.author} · <time datetime="${item.date}">${item.dateLabel}</time> · ${item.readMin} min
            </div>
          </div>
        </a>
      </article>`;
    }

    function filtered() {
      const q = state.query.trim().toLowerCase();
      return articles.filter((item) => {
        const catOk = state.cat === "All" || item.category === state.cat;
        const text = `${item.primaryTechnology} ${item.category} ${item.title} ${item.excerpt}`.toLowerCase();
        return catOk && (!q || text.includes(q));
      });
    }

    function render() {
      const q = state.query.trim().toLowerCase();
      const all = filtered();
      const showFeatured = state.page === 1 && state.cat === "All" && !q;
      if (featured) featured.hidden = !showFeatured;

      let gridSource = showFeatured ? all.filter((item) => item.slug !== featuredSlug) : all;
      const totalPages = Math.max(1, Math.ceil(gridSource.length / PAGE_SIZE));
      state.page = Math.min(state.page, totalPages);
      const start = (state.page - 1) * PAGE_SIZE;
      const pageItems = gridSource.slice(start, start + PAGE_SIZE);

      grid.innerHTML = pageItems.map(cardHtml).join("");
      empty.hidden = pageItems.length > 0;
      grid.hidden = pageItems.length === 0;

      const total = gridSource.length + (showFeatured ? 1 : 0);
      resultsLabel.textContent =
        state.cat === "All" && !q ? "Latest articles" : q ? `Results for “${state.query.trim()}”` : `${state.cat} articles`;
      countLabel.textContent = `${total} article${total === 1 ? "" : "s"}`;

      if (totalPages <= 1) {
        pager.hidden = true;
        return;
      }
      pager.hidden = false;
      const pgBase = "min-width:36px; text-align:center; font-size:13.5px; font-weight:600; padding:8px 12px; border-radius:10px; cursor:pointer; border:none; font-family:inherit;";
      let html = `<button type="button" data-page="prev" style="${pgBase} color:${state.page > 1 ? "#3a4048" : "#c7ccd2"}; background:#fff; border:1px solid #e6e8eb;" ${state.page <= 1 ? "disabled" : ""}>← Prev</button>`;
      for (let i = 1; i <= totalPages; i++) {
        const active = i === state.page;
        html += `<button type="button" data-page="${i}" style="${pgBase} color:${active ? "#fff" : "#3a4048"}; background:${active ? "#2F6FEB" : "#fff"}; border:1px solid ${active ? "#2F6FEB" : "#e6e8eb"};">${i}</button>`;
      }
      html += `<button type="button" data-page="next" style="${pgBase} color:${state.page < totalPages ? "#3a4048" : "#c7ccd2"}; background:#fff; border:1px solid #e6e8eb;" ${state.page >= totalPages ? "disabled" : ""}>Next →</button>`;
      pager.innerHTML = html;
    }

    search.addEventListener("input", (e) => {
      state.query = e.target.value;
      state.page = 1;
      render();
    });

    catWrap.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-cat]");
      if (!btn) return;
      state.cat = btn.dataset.cat || "All";
      state.page = 1;
      catWrap.querySelectorAll("button[data-cat]").forEach((el) => {
        setCatActive(el, el.dataset.cat === state.cat);
      });
      render();
    });

    pager.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-page]");
      if (!btn || btn.disabled) return;
      const val = btn.dataset.page;
      if (val === "prev") state.page = Math.max(1, state.page - 1);
      else if (val === "next") state.page += 1;
      else state.page = Number(val);
      window.scrollTo({ top: 0, behavior: "smooth" });
      render();
    });

    resetBtn?.addEventListener("click", () => {
      state.query = "";
      state.cat = "All";
      state.page = 1;
      search.value = "";
      catWrap.querySelectorAll("button[data-cat]").forEach((el) => {
        setCatActive(el, el.dataset.cat === "All");
      });
      render();
    });

    render();
  }

  initBlogIndex();
  document.addEventListener("astro:page-load", initBlogIndex);
</script>
