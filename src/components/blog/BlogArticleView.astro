---
import { blogTechFor } from "../../lib/blog-tech";
import { blogTocFromMarkdown, prepareBlogBody, renderBlogMarkdown } from "../../lib/blog-markdown";
import { articleCardMeta, articleDeckDescription, defaultArticleBody, formatBlogDate, getArticles, type BlogArticle } from "../../lib/blog";
import BlogArticleHeroCover from "./BlogArticleHeroCover.astro";
import BlogCardCover from "./BlogCardCover.astro";
import NewsletterInlineForm from "../NewsletterInlineForm.astro";
import { MW_LOGOS } from "../../lib/logos";
import { englishDisplayText } from "../../lib/preview-text";
import "../../styles/marquee-rows.css";

interface Props { article: BlogArticle; }
const { article } = Astro.props;
const displayTitle = englishDisplayText(article.title, article.excerpt, article.description);
const displayDescription = articleDeckDescription(article);
const tech = blogTechFor(article.primaryTechnology);
const logoPath = MW_LOGOS[tech.techName] ?? "";
const hasLogo = !!logoPath;
const bodySource = prepareBlogBody(article.body || defaultArticleBody(article.primaryTechnology), {
  heroImage: article.image,
});
const html = renderBlogMarkdown(bodySource);
const toc = blogTocFromMarkdown(bodySource);
const related = getArticles()
  .filter((a) => a.slug !== article.slug && a.primaryTechnology !== article.primaryTechnology)
  .slice(0, 3)
  .map(articleCardMeta);
const galleryHref = tech.galleryHref;
const coverVariant = (article.slug.charCodeAt(0) % 3) as 0 | 1 | 2;
---

<main class="blog-main blog-article-shell">
  <div class="blog-read-progress" style="position:fixed; top:0; left:0; right:0; height:3px; background:transparent; z-index:50;">
    <div data-role="read-progress" style={`height:100%; width:0%; background:${tech.accent}; transition:width .08s linear;`}></div>
  </div>

  {/* `--hero-accent` stays raw for fills; text and text-bearing surfaces use the derived pair. */}
  <article
    class="blog-article"
    style={`--hero-accent:${tech.accent}; --hero-ink:${tech.accentInk}; --hero-accent-text:${tech.accentOnLight}; --hero-solid:${tech.accentSolid}`}
  >
    <div class="blog-article-header">
      <BlogArticleHeroCover
        accent={tech.accentCover}
        accentInk={tech.accentInk}
        techName={tech.techName}
        primaryTechnology={article.primaryTechnology}
        category={article.category}
        title={displayTitle}
        galleryHref={galleryHref}
        logoPath={logoPath}
        variant={coverVariant}
      />

      <div class="blog-article-intro">
        <p class="blog-article-description">{displayDescription}</p>
        <div class="blog-article-meta">
          <span class="blog-article-avatar">{article.author.charAt(0).toUpperCase()}</span>
          <div>
            <address class="blog-article-author">{article.author}</address>
            <div class="blog-article-meta-line">
              <time datetime={article.date}>{formatBlogDate(article.date)}</time>
              <span aria-hidden="true">·</span>
              <span>{article.readMin} min read</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="blog-toc-layout">
      <div class="prose" set:html={html}></div>
      {toc.length > 0 && (
        <aside class="blog-toc" aria-label="Table of contents">
          <div class="blog-toc-label">On this page</div>
          <nav class="blog-toc-nav">
            {toc.map((item) => <a href={`#${item.id}`} class="blog-toc-link">{item.label}</a>)}
          </nav>
        </aside>
      )}
    </div>

    <div class="blog-article-author">
      <div style="display:flex; gap:16px; align-items:flex-start; background:#fff; border:1px solid #e9ebee; border-radius:16px; padding:22px;">
        <span style={`width:52px; height:52px; border-radius:50%; background:${tech.accentSolid}; color:${tech.accentInk}; font-weight:700; font-size:20px; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>{article.author.charAt(0).toUpperCase()}</span>
        <div>
          <div style="font-size:12px; font-weight:700; color:#5c665f; text-transform:uppercase; letter-spacing:.05em;">Written by</div>
          <div class="disp" style="font-size:17px; font-weight:800; letter-spacing:-0.01em; margin-top:2px;">{article.author}</div>
          <p style="font-size:14px; color:#6a7077; line-height:1.55; margin:8px 0 0;">Practical guides for the MadeWithWhat network — tooling, structure, and deploy paths that scale.</p>
        </div>
      </div>
    </div>
  </article>

  <section class="blog-article-section" aria-label="Related articles">
    <h2 class="disp" style="font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:0 0 20px;">Keep reading</h2>
    <div class="blog-grid-3" data-role="related-blog-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:22px;">
      {related.map((item, index) => (
        <article class="blog-index-card" style="background:#fff; border:1px solid #e9ebee; border-radius:16px; overflow:hidden;">
          <a href={item.href} class="blog-related-link" aria-label={`Read: ${item.title}`}>
            <BlogCardCover
              accent={item.tech.accentCover}
              accentInk={item.tech.accentInk}
              tech={item.primaryTechnology}
              category={item.category}
              title={item.title}
              size="related"
              variant={(index % 3) as 0 | 1 | 2}
            />
            <div style="padding:15px 16px 16px;">
              <div style={`font-size:11.5px; font-weight:700; color:${item.tech.accentOnLight}; text-transform:uppercase; letter-spacing:.04em;`}>{item.primaryTechnology}</div>
              <h3 style="font-size:15.5px; font-weight:800; line-height:1.3; margin:6px 0 0;">{item.title}</h3>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="grid-slideshow grid-slideshow--pad-28" data-role="related-blog-marquee"></div>
  </section>

  <section class="blog-article-section blog-article-newsletter" aria-label="Newsletter">
    <div style="background:linear-gradient(135deg,#141a2e,#1f2b52); border-radius:20px; padding:36px 40px; display:flex; align-items:center; justify-content:space-between; gap:26px; flex-wrap:wrap;">
      <div style="max-width:440px;">
        <h2 class="disp" style="font-size:24px; font-weight:800; letter-spacing:-0.02em; color:#fff; margin:0;">Get the next guide in your inbox</h2>
        <p style="font-size:14.5px; color:#b8c0d4; margin:9px 0 0; line-height:1.55;">One email a week, across every stack in the network.</p>
      </div>
      <NewsletterInlineForm
        source="blog_article_banner"
        buttonBg={tech.accentSolid}
        buttonColor={tech.accentInk}
      />
    </div>
  </section>
</main>

<style>
  .blog-main {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 28px 70px;
    overflow-x: clip;
  }

  .blog-article-header {
    margin: 0 auto;
    padding-top: 32px;
  }

  .blog-article-intro {
    width: 100%;
    box-sizing: border-box;
    margin: 24px 0 0;
    padding: 24px 32px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(135deg, #f6f7f9 0%, #fafafa 55%, #ffffff 100%);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px 48px;
    align-items: center;
  }

  .blog-article-description {
    font-size: 19px;
    font-weight: 700;
    color: #3a4048;
    line-height: 1.55;
    margin: 0;
  }

  .blog-article-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    justify-self: end;
    flex-shrink: 0;
  }

  .blog-article-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--hero-solid);
    color: var(--hero-ink);
    font-weight: 700;
    font-size: 17px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  address.blog-article-author {
    font-style: normal;
    font-size: 14.5px;
    font-weight: 700;
    color: #12161a;
  }

  .blog-article-meta-line {
    font-size: 13px;
    color: #5c665f;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }

  .blog-toc-layout {
    margin-top: 22px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 44px;
    align-items: start;
  }

  .blog-toc-layout .prose {
    min-width: 0;
    max-width: 100%;
  }

  /* Must come after the base rules above: same specificity, so source order
     decides whether the mobile collapse actually applies. */
  @media (max-width: 900px) {
    .blog-article-intro {
      grid-template-columns: 1fr;
      gap: 20px;
      align-items: start;
      padding-left: 0;
      padding-right: 0;
    }

    .blog-article-meta {
      justify-self: start;
    }

    .blog-toc-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .blog-toc {
    position: sticky;
    top: 100px;
  }

  .blog-toc-label {
    font-size: 11px;
    font-weight: 700;
    color: #5c665f;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  .blog-toc-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 0 0 16px;
    border-left: 2px solid #e6e8eb;
  }

  .blog-toc-link {
    display: block;
    position: relative;
    padding: 5px 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #5c6169;
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .blog-toc-link:hover,
  .blog-toc-link:focus-visible {
    color: var(--hero-accent-text, #2f6feb);
    outline: none;
  }

  .blog-toc-link.is-active {
    color: var(--hero-accent-text, #2f6feb);
    font-weight: 700;
  }

  .blog-toc-link.is-active::before {
    content: "";
    position: absolute;
    left: -18px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    border-radius: 1px;
    background: var(--hero-accent-text, #2f6feb);
  }

  div.blog-article-author {
    max-width: 760px;
    margin: 48px auto 0;
  }

  .blog-article-section {
    margin-top: 44px;
  }

  .blog-related-link {
    text-decoration: none;
    color: inherit;
  }
</style>

<script>
  import { syncGridMarquee } from "../../scripts/marquee-rows";

  function initReadProgress() {
    const bar = document.querySelector("[data-role=read-progress]");
    if (!(bar instanceof HTMLElement) || bar.dataset.initialized) return;
    bar.dataset.initialized = "true";
    const onScroll = () => {
      const root = document.documentElement;
      const max = (root.scrollHeight - root.clientHeight) || 1;
      const pct = Math.min(100, Math.max(0, (root.scrollTop || window.scrollY) / max * 100));
      bar.style.width = `${pct}%`;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function initTocSpy() {
    const nav = document.querySelector(".blog-toc-nav");
    if (!(nav instanceof HTMLElement) || nav.dataset.spyInitialized) return;
    const links = [...nav.querySelectorAll(".blog-toc-link")].filter(
      (el): el is HTMLAnchorElement => el instanceof HTMLAnchorElement && !!el.hash,
    );
    if (!links.length) return;
    nav.dataset.spyInitialized = "true";

    const sections = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const heading = document.getElementById(id);
        return heading ? { link, heading } : null;
      })
      .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => !!item);
    if (!sections.length) return;

    const setActive = (active: HTMLAnchorElement | null) => {
      for (const { link } of sections) {
        const on = link === active;
        link.classList.toggle("is-active", on);
        if (on) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    // Prefer the last heading whose top has crossed a fixed offset from the viewport top.
    const offset = 120;
    const sync = () => {
      let current: HTMLAnchorElement | null = sections[0]?.link ?? null;
      for (const { link, heading } of sections) {
        if (heading.getBoundingClientRect().top - offset <= 0) current = link;
        else break;
      }
      setActive(current);
    };

    window.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  }

  function initBlogArticleChrome() {
    initReadProgress();
    initTocSpy();
    initRelatedMarquee();
  }

  function initRelatedMarquee() {
    const grid = document.querySelector<HTMLElement>('[data-role="related-blog-grid"]');
    const host = document.querySelector<HTMLElement>('[data-role="related-blog-marquee"]');
    if (!grid || !host || grid.dataset.marqueeInit) return;
    grid.dataset.marqueeInit = "1";
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".blog-index-card"));
    const mobile = window.matchMedia("(max-width: 560px)");
    let destroy = () => {};
    const sync = () => {
      destroy = syncGridMarquee(grid, host, cards, destroy);
    };
    mobile.addEventListener("change", sync);
    sync();
  }

  initBlogArticleChrome();
  document.addEventListener("astro:page-load", initBlogArticleChrome);
</script>
