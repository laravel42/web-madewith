---
interface Props {
  size?: "header" | "footer";
}

const { size = "header" } = Astro.props;
const mainSize = size === "header" ? "17px" : "16px";
const brand = "rgb(47, 111, 235)";
---

<span class="disp" style={`font-weight:800; font-size:${mainSize}; letter-spacing:-0.01em;`}>
  <span style={`color:${brand};`}>made</span><span style="font-size:16px; font-weight:800;">with</span><span style={`color:${brand};`}>what</span>
</span>
