<div style="max-width:560px; margin:0 auto; padding:48px 28px 90px;">
  <div data-role="newsletter-success" hidden style="text-align:center; padding:60px 0;">
    <div style="width:64px; height:64px; border-radius:50%; background:rgb(47, 111, 235); display:flex; align-items:center; justify-content:center; margin:0 auto 22px;">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4 10-10" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="disp" style="font-size:30px; font-weight:800; letter-spacing:-0.02em;">You're subscribed!</div>
    <div style="font-size:16px; color:#5c665f; margin-top:12px; max-width:420px; margin-inline:auto; line-height:1.55;">We'll send a digest of standout projects across the MadeWithWhat network when galleries refresh.</div>
    <a href="/" class="btn btn-primary" style="padding:13px 22px; font-size:15px; margin-top:26px;">Back to network</a>
  </div>
  <form data-role="newsletter-form">
    <div style="font-size:13px; color:#8b9690; margin-bottom:14px;"><a href="/" class="filter-link" style="color:inherit;">Home</a> &nbsp;/&nbsp; Newsletter</div>
    <div style="font-size:13px; font-weight:600; color:rgb(47, 111, 235); letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;">Newsletter</div>
    <div class="disp" style="font-size:40px; font-weight:800; letter-spacing:-0.03em;">Stay in the loop</div>
    <div style="font-size:16px; color:#5c665f; margin-top:10px; line-height:1.55;">Get a digest of standout open-source projects across the MadeWithWhat network when galleries refresh — no spam, unsubscribe any time.</div>
    <div style="margin-top:34px; display:flex; flex-direction:column; gap:16px;">
      <div>
        <label for="n-email-network" style="display:block; font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">Email address</label>
        <input id="n-email-network" name="email" type="email" required placeholder="you@example.com" autocomplete="email" style="width:100%; border:1px solid #e0e5e2; border-radius:10px; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;" />
      </div>
      <button type="submit" class="btn btn-primary" style="padding:15px 22px; font-size:15px; border:none; width:100%; cursor:pointer;">Subscribe</button>
    </div>
  </form>
</div>

<script>
  function initNewsletter() {
    const form = document.querySelector<HTMLFormElement>('[data-role="newsletter-form"]');
    const success = document.querySelector<HTMLElement>('[data-role="newsletter-success"]');
    if (!form || !success || form.dataset.newsletterInitialized) return;
    form.dataset.newsletterInitialized = "true";
    const apiBase = import.meta.env.PUBLIC_API_BASE;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const email = (form.querySelector('[name="email"]') as HTMLInputElement | null)?.value.trim() || "";
      if (!email) return;

      if (!apiBase) { form.hidden = true; success.hidden = false; window.scrollTo({ top: 0 }); return; }

      if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent || ""; btn.textContent = "Subscribing…"; }
      try {
        const res = await fetch(`${apiBase.replace(/\/$/, "")}/newsletter`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, scope: "network" }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error((data as any).error || `Subscription failed (${res.status})`);
        form.hidden = true; success.hidden = false; window.scrollTo({ top: 0 });
      } catch (err) {
        alert((err as Error).message);
        if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || "Subscribe"; }
      }
    });
  }
  initNewsletter();
  document.addEventListener("astro:page-load", initNewsletter);
</script>
