---
import MadeWithWhatWordmark from "./MadeWithWhatWordmark.astro";

/** Source repo — update when the public URL is finalized. */
const GITHUB_REPO_URL = "https://github.com/laravel42/web-madewith";
---

<footer class="network-footer">
  <div class="network-footer-inner">
    <div style="display:flex; align-items:center; gap:10px;">
      <div class="disp" style="width:26px; height:26px; border-radius:7px; background:#12161a; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px;">M</div>
      <MadeWithWhatWordmark size="footer" />
    </div>
    <div class="network-footer-links">
      <a href="/rss.xml" class="network-footer-link">RSS</a>
      <a href="/newsletter" class="network-footer-link">Newsletter</a>
      <a href="/llm" class="network-footer-link">LLM</a>
      <a href={GITHUB_REPO_URL} class="network-footer-link network-footer-github" target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</footer>

<style>
  .network-footer {
    border-top: 1px solid #ececec;
    background: #fff;
    margin-top: auto;
    margin-left: -20px;
    margin-right: -20px;
    width: calc(100% + 40px);
  }
  .network-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .network-footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    font-size: 13px;
    color: #8b9690;
  }
  .network-footer-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.12s ease, text-decoration-color 0.12s ease;
  }
  .network-footer-link:hover {
    color: rgb(47, 111, 235);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .network-footer-github {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
</style>
