---
import MadeWithWhatWordmark from "./MadeWithWhatWordmark.astro";
import { GITHUB_REPO_URL } from "./GitHubBadge.astro";
---

<footer style="border-top:1px solid #ececec; background:#fff; margin-top:auto; margin-left:-20px; margin-right:-20px; overflow-x:clip;">
  <div style="max-width:1200px; margin:0 auto; padding:18px clamp(16px,3vw,32px); display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); align-items:center; gap:12px; font-size:13px; color:#8b9690;">
    <div style="display:flex; align-items:center; gap:10px; min-width:0;">
      <div class="disp" style="width:26px; height:26px; border-radius:7px; background:#12161a; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; flex-shrink:0;">M</div>
      <MadeWithWhatWordmark size="footer" />
    </div>
    <a href="https://laravel42.com" target="_blank" rel="noopener noreferrer" style="white-space:nowrap; text-align:center; display:inline-flex; align-items:center; gap:5px; background:#f3f4f6; border:1px solid #ececec; border-radius:999px; padding:5px 12px; font-size:12.5px; color:#6b7280; text-decoration:none;">
      Made with
      <svg width="14" height="14" viewBox="0 0 24 24" fill="#e5484d" aria-label="love" role="img" style="flex-shrink:0; vertical-align:middle;"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      by{" "}
      <span style="color:#374151; font-weight:600;">Laravel42</span>
    </a>
    <div style="display:flex; align-items:center; justify-content:flex-end; flex-wrap:nowrap; gap:clamp(10px,2vw,22px); min-width:0;">
      <a href="/rss.xml" style="color:inherit; text-decoration:none; white-space:nowrap;">RSS</a>
      <a href="/newsletter" style="color:inherit; text-decoration:none; white-space:nowrap;">Newsletter</a>
      <a href="/llm" style="color:inherit; text-decoration:none; white-space:nowrap;">LLM</a>
      <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-weight:700; white-space:nowrap;">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</footer>
