---
import type { Theme } from "../config/domains";
import type { Project } from "../lib/catalog";
import ProjectCard from "./ProjectCard.astro";
import "../styles/marquee-rows.css";

interface Props { theme: Theme; projects: Project[]; }
const { theme, projects } = Astro.props;
const n = projects.length;
const countFormat = theme.variant === "terminal" ? "terminal" : "minimal";
const countInitial = countFormat === "terminal" ? `// ${n} result${n === 1 ? "" : "s"}` : `${n} project${n === 1 ? "" : "s"}`;

// The result count and the empty state sit straight on the page shell, and the
// editorial layout is not always light — Next runs it on black. So the muted
// grey flips with the shell: #5c665f clears AA on #fbfcfb, #9aa69e on #000 and
// on the terminal #0c0f0e (the value the terminal variant already used).
const muted = theme.darkShell ? "#9aa69e" : "#5c665f";
const gridPadTop = theme.editorial ? "0" : theme.variant === "terminal" ? "12px" : "14px";
---

{theme.editorial ? (
  <div class="shell-pad-x mw-project-grid mw-full-bleed" style={`max-width:1200px; margin:0 auto; padding:0 32px 80px; background:${theme.bg};`}>
    <div data-role="count" data-format="minimal" style={`font-size:13px; color:${muted}; margin:18px 0;`}>{countInitial}</div>
    <div data-role="grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px;">
      {projects.map((p, i) => <ProjectCard theme={theme} project={p} rank={(i < 9 ? "0" : "") + (i + 1)} priority={i < 3} />)}
      <div data-role="empty" hidden style={`grid-column:1 / -1; padding:60px 20px; text-align:center; color:${muted}; font-size:15px; border-right:1px solid #e8e8e8; border-bottom:1px solid #e8e8e8;`}>No projects match your search.</div>
    </div>
    <div class="grid-slideshow" data-role="project-marquee"></div>
    <div data-role="pager" class="pager" hidden></div>
  </div>
) : (
  <div class="shell-pad-x mw-project-grid mw-full-bleed" style={`max-width:1200px; margin:0 auto; padding:${gridPadTop} 32px 80px; background:${theme.bg};`}>
    <div data-role="count" data-format={countFormat} style={`font-size:${theme.variant === "terminal" ? "12px" : "13px"}; color:${muted}; margin-bottom:${theme.variant === "terminal" ? "16px" : "18px"};`}>{countInitial}</div>
    <div data-role="grid" style={`display:grid; grid-template-columns:repeat(3,1fr); gap:${theme.variant === "terminal" ? "18px" : "24px"};`}>
      {projects.map((p, i) => <ProjectCard theme={theme} project={p} rank={(i < 9 ? "0" : "") + (i + 1)} priority={i < 3} />)}
      <div data-role="empty" hidden style={`grid-column:1 / -1; padding:60px 20px; text-align:center; color:${muted}; font-size:15px;`}>No projects match your search.</div>
    </div>
    <div class="grid-slideshow" data-role="project-marquee"></div>
    <div data-role="pager" class="pager" hidden></div>
  </div>
)}

<script>
  import { syncCatalogMarquee } from "../scripts/marquee-rows";

  // Shared client-side catalog engine: search + sort + tag filter, wired to the
  // hero controls via data-role hooks. Works across all three visual variants;
  // absent controls (e.g. no tag pills in editorial) are simply skipped.
  function initCatalog() {
    const grid = document.querySelector<HTMLElement>('[data-role="grid"]');
    if (!grid || grid.dataset.catalogInitialized) return;
    grid.dataset.catalogInitialized = "true";
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-role="card"]'));
    const empty = grid.querySelector<HTMLElement>('[data-role="empty"]');
    const marqueeHost = document.querySelector<HTMLElement>('[data-role="project-marquee"]');
    const search = document.querySelector<HTMLInputElement>('[data-role="search"]');
    const sortBtn = document.querySelector<HTMLElement>('[data-role="sort"]');
    const sortLabel = document.querySelector<HTMLElement>('[data-sort-label]');
    const tags = Array.from(document.querySelectorAll<HTMLElement>('[data-role="tag"]'));
    const count = document.querySelector<HTMLElement>('[data-role="count"]');
    const pager = document.querySelector<HTMLElement>('[data-role="pager"]');
    const PER_PAGE = 24;
    const mobile = window.matchMedia("(max-width: 560px)");
    let destroyMarquee = () => {};

    let query = "";
    let sort: "stars" | "name" = "stars";
    let page = 1;
    // A single active filter spanning dimensions; type "tag" covers category + stack.
    let active: { type: "all" | "tag" | "author" | "lang" | "license"; value: string } = { type: "all", value: "All" };
    const PREP: Record<string, string> = { tag: "in", author: "by", lang: "written in", license: "under" };

    function matchActive(c: HTMLElement) {
      const v = active.value.toLowerCase();
      switch (active.type) {
        case "tag": return c.dataset.category === active.value || (c.dataset.stack || "").split("|").includes(v);
        case "author": return c.dataset.author === v;
        case "lang": return (c.dataset.langs || "").split("|").includes(v);
        case "license": return c.dataset.license === v;
        default: return true;
      }
    }
    function syncPills() {
      // Highlight "All" when unfiltered, the matching category pill for a tag, else none.
      const hi = active.type === "all" ? "All" : active.type === "tag" ? active.value : "\0";
      for (const t of tags) t.classList.toggle("is-active", t.dataset.tag === hi);
    }
    function syncURL() {
      const u = new URL(location.href);
      for (const k of ["tag", "author", "lang", "license"]) u.searchParams.delete(k);
      if (active.type !== "all") u.searchParams.set(active.type, active.value);
      history.replaceState({}, "", u.toString());
    }

    // Deep-link: ?author=X | ?lang=X | ?license=X | ?tag=X (category or stack tag).
    const sp = new URLSearchParams(location.search);
    for (const type of ["author", "lang", "license", "tag"] as const) {
      const val = sp.get(type);
      if (val) { active = { type, value: val }; break; }
    }
    syncPills();

    const stars = (el: HTMLElement) => Number(el.dataset.stars || "0");
    const name = (el: HTMLElement) => el.dataset.name || "";
    const hayOf = (c: HTMLElement) =>
      `${c.dataset.name} ${c.dataset.desc} ${c.dataset.author} ${c.dataset.category} ${c.dataset.stack} ${c.dataset.langs} ${c.dataset.license}`.toLowerCase();

    function goTo(p: number) {
      page = p;
      apply();
      count?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function renderPager(pages: number) {
      if (!pager) return;
      pager.textContent = "";
      if (pages <= 1) { pager.hidden = true; return; }
      pager.hidden = false;
      const btn = (label: string, target: number, opts: { active?: boolean; disabled?: boolean } = {}) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "pager-btn" + (opts.active ? " is-active" : "");
        b.textContent = label;
        if (opts.disabled) b.disabled = true;
        else if (!opts.active) b.addEventListener("click", () => goTo(target));
        return b;
      };
      pager.append(btn("‹", page - 1, { disabled: page === 1 }));
      // Always show first & last, a window around the current page; ellipses fill gaps.
      const nums = [...new Set([1, page - 1, page, page + 1, pages])].filter((x) => x >= 1 && x <= pages).sort((a, b) => a - b);
      let prev = 0;
      for (const num of nums) {
        if (num - prev > 1) {
          const gap = document.createElement("span");
          gap.className = "pager-gap";
          gap.textContent = "…";
          pager.append(gap);
        }
        pager.append(btn(String(num), num, { active: num === page }));
        prev = num;
      }
      pager.append(btn("›", page + 1, { disabled: page === pages }));
    }

    function syncMarquee() {
      if (!marqueeHost) return;
      destroyMarquee = syncCatalogMarquee(grid!, marqueeHost, cards, destroyMarquee);
    }

    function apply() {
      // sort the DOM so pages read in the chosen order
      const ordered = [...cards].sort((a, b) =>
        sort === "stars" ? stars(b) - stars(a) : name(a).localeCompare(name(b))
      );
      ordered.forEach((c) => grid!.appendChild(c));
      if (empty) grid!.appendChild(empty);

      // filter → the full matching set (across all pages), in sorted order
      const matched = ordered.filter((c) => matchActive(c) && (!query || hayOf(c).includes(query)));
      const total = matched.length;
      const pages = Math.max(1, Math.ceil(total / PER_PAGE));
      page = Math.min(Math.max(1, page), pages);

      // reveal only the current page's window (hidden cards don't load their images)
      const start = (page - 1) * PER_PAGE;
      const win = new Set(matched.slice(start, start + PER_PAGE));
      for (const c of cards) c.hidden = !win.has(c);
      if (empty) empty.hidden = total !== 0;

      // count label reflects the full filtered total, not just this page
      if (count) {
        const fmt = count.dataset.format;
        count.textContent = fmt === "terminal"
          ? `// ${total} result${total === 1 ? "" : "s"}`
          : `${total} project${total === 1 ? "" : "s"}`;
        if (active.type !== "all") {
          const pre = PREP[active.type];
          count.append(fmt === "terminal" ? ` · ${pre} ` : ` ${pre} `);
          const chip = document.createElement("span");
          chip.className = "active-tag";
          chip.textContent = active.value;
          count.append(chip);
        }
      }

      renderPager(pages);
      syncMarquee();
    }

    search?.addEventListener("input", () => { query = search.value.trim().toLowerCase(); page = 1; apply(); });

    sortBtn?.addEventListener("click", () => {
      sort = sort === "stars" ? "name" : "stars";
      if (sortLabel) {
        sortLabel.textContent = sort === "stars"
          ? sortLabel.dataset.labelStars || "Most stars"
          : sortLabel.dataset.labelName || "A–Z";
      }
      page = 1;
      apply();
    });

    for (const tag of tags) {
      tag.addEventListener("click", () => {
        const label = tag.dataset.tag || "All";
        active = (label === "All" || (active.type === "tag" && active.value === label))
          ? { type: "all", value: "All" }
          : { type: "tag", value: label };
        syncPills();
        syncURL();
        page = 1;
        apply();
      });
    }

    mobile.addEventListener("change", syncMarquee);
    apply();
  }
  initCatalog();
  document.addEventListener("astro:page-load", initCatalog);
</script>
