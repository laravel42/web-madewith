---
import type { Theme } from "../config/domains";
import type { Project } from "../lib/catalog";
import { formatStars } from "../lib/catalog";

interface Props { theme: Theme; project: Project; rank: string; }
const { theme, project, rank } = Astro.props;
const base = `/${theme.slug}`;
const href = `${base}/project/${project.slug}`;
const stars = formatStars(project.stars);
const initial = project.author.charAt(0).toUpperCase();
// shared data hooks for the client-side filter
const dataAttrs = {
  "data-role": "card",
  "data-name": project.name.toLowerCase(),
  "data-desc": project.desc.toLowerCase(),
  "data-author": project.author.toLowerCase(),
  "data-category": project.category,
  "data-stars": String(project.stars),
};
const editorial = theme.editorial;
const radius = editorial ? 0 : 6;
---

{theme.variant === "terminal" ? (
  <a href={href} class="card" {...dataAttrs}>
    <div style="height:140px; background:#0e120f; border-bottom:1px solid #1f2622; padding:13px; position:relative;">
      <div style="font-size:11px; color:#3f4a43; margin-bottom:11px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">~/{project.author}/{project.slug}</div>
      <div style="height:7px; width:58%; background:#1c231e; border-radius:3px; margin-bottom:9px;"></div>
      <div style={`height:26px; width:46%; background:${theme.accent}; opacity:.8; border-radius:4px; margin-bottom:10px;`}></div>
      <div style="height:6px; width:80%; background:#1c231e; border-radius:3px; margin-bottom:6px;"></div>
      <div style="height:6px; width:66%; background:#1c231e; border-radius:3px;"></div>
    </div>
    <div style="padding:14px 15px 15px;">
      <div style="font-size:11px; color:#5c665f; margin-bottom:7px;">[{project.category}]</div>
      <div class="disp" style="font-weight:600; font-size:16px; color:#e8efe9; margin-bottom:5px;">{project.name}</div>
      <div style="font-size:12px; color:#7c887f; line-height:1.5; margin-bottom:13px; min-height:36px;">{project.desc}</div>
      <div style="display:flex; align-items:center; justify-content:space-between; font-size:12px;">
        <span style="color:#5c665f;">@{project.author}</span>
        <span style={`color:${theme.accent};`}>★ {stars}</span>
      </div>
    </div>
  </a>
) : editorial ? (
  <a href={href} class="card-editorial" {...dataAttrs}>
    <div style="height:158px; background:#f5f5f5; position:relative; padding:14px; border-bottom:1px solid #e8e8e8;">
      <div class="disp" style="position:absolute; top:14px; right:14px; font-weight:800; font-size:13px;">{rank}</div>
      <div style="height:8px; width:50%; background:#e3e3e3; margin-bottom:9px; margin-top:26px;"></div>
      <div style="height:30px; width:44%; background:#0a0a0a; margin-bottom:11px;"></div>
      <div style="height:7px; width:78%; background:#e8e8e8; margin-bottom:6px;"></div>
      <div style="height:7px; width:62%; background:#e8e8e8;"></div>
    </div>
    <div style="padding:18px 20px 20px;">
      <div class="disp" style="font-weight:700; font-size:18px; letter-spacing:-0.01em; margin-bottom:6px;">{project.name}</div>
      <div style="font-size:13.5px; color:#666; line-height:1.45; margin-bottom:15px; min-height:38px;">{project.desc}</div>
      <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f0f0f0; padding-top:13px;">
        <span style="font-size:13px; font-weight:600;">@{project.author}</span>
        <span style="font-size:13px; font-weight:700;">★ {stars}</span>
      </div>
    </div>
  </a>
) : (
  <a href={href} class="card" {...dataAttrs}>
    <div style="height:152px; background:#f4f6f5; border-bottom:1px solid #eef0ef; padding:11px; position:relative;">
      <div style="display:flex; gap:5px; margin-bottom:13px;"><span style="width:8px;height:8px;border-radius:50%;background:#dfe4e1;"></span><span style="width:8px;height:8px;border-radius:50%;background:#dfe4e1;"></span><span style="width:8px;height:8px;border-radius:50%;background:#dfe4e1;"></span></div>
      <div style="height:8px; width:55%; background:#e3e8e5; border-radius:4px; margin-bottom:9px;"></div>
      <div style={`height:30px; width:42%; background:${theme.accent}; opacity:.9; border-radius:${radius}px; margin-bottom:11px;`}></div>
      <div style="height:7px; width:80%; background:#e9edeb; border-radius:4px; margin-bottom:7px;"></div>
      <div style="height:7px; width:68%; background:#e9edeb; border-radius:4px;"></div>
    </div>
    <div style="padding:15px 16px 16px;">
      <div style="display:flex; align-items:center; gap:8px; margin-bottom:7px;">
        {theme.chipAccent ? (
          <span style={`font-size:11px; font-weight:600; color:${theme.accent}; background:color-mix(in srgb, ${theme.accent} 12%, #fff); padding:3px 9px; border-radius:20px; letter-spacing:.02em;`}>{project.category}</span>
        ) : (
          <span style="font-size:11px; font-weight:600; color:#8b9690; background:#f1f4f2; padding:3px 8px; border-radius:5px;">{project.category}</span>
        )}
      </div>
      <div class="disp" style="font-weight:700; font-size:17px; margin-bottom:5px; letter-spacing:-0.01em;">{project.name}</div>
      <div style="font-size:13.5px; color:#6b756f; line-height:1.45; margin-bottom:14px; min-height:38px;">{project.desc}</div>
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style={`width:22px; height:22px; border-radius:50%; background:${theme.accent}; color:${theme.accentInk}; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center;`}>{initial}</span>
          <span style="font-size:13px; color:#6b756f;">{project.author}</span>
        </div>
        <div style="display:flex; align-items:center; gap:5px; font-size:13px; font-weight:600; color:#3a443f;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f5b400"><path d="m12 2 3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
          {stars}
        </div>
      </div>
    </div>
  </a>
)}
