---
import type { Theme } from "../config/domains";
interface Cat { label: string; count: number; blurb: string; }
interface Props { theme: Theme; cats: Cat[]; total: string; }
const { theme, cats, total } = Astro.props;
const base = `/${theme.slug}`;
const catCount = cats.length;
const radius = `${theme.radius}px`;
const href = (label: string) => `${base}/?tag=${encodeURIComponent(label)}`;
---

{theme.variant === "terminal" ? (
  <div style="max-width:1200px; margin:0 auto; padding:48px 32px 80px;">
    <div style="font-size:12px; color:#5c665f; margin-bottom:14px;"><a href={`${base}/`} style="cursor:pointer; text-decoration:none; color:inherit;">~</a> / categories</div>
    <div class="disp" style="font-size:38px; font-weight:700; letter-spacing:-0.02em; color:#f1f6f2;">Browse by category</div>
    <div style="font-size:14px; color:#8b948d; margin-top:10px; max-width:560px;">ls the {theme.techName} ecosystem — {total} projects across {catCount} categories.</div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:32px;">
      {cats.map((c) => (
        <a href={href(c.label)} class="card" style="padding:20px;">
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <div class="disp" style="font-weight:600; font-size:18px; color:#e8efe9;">{c.label}</div>
            <span style={`background:color-mix(in srgb, ${theme.accent} 22%, #0c0f0e); color:${theme.accent}; border:1px solid ${theme.accent}; font-size:12px; padding:2px 9px; border-radius:5px;`}>{c.count}</span>
          </div>
          <div style="font-size:12.5px; color:#7c887f; margin-top:8px; line-height:1.5;">{c.blurb}</div>
          <div style={`margin-top:15px; font-size:12px; color:${theme.accent};`}>cd → </div>
        </a>
      ))}
    </div>
  </div>
) : (
  <div style="max-width:1200px; margin:0 auto; padding:48px 32px 80px;">
    <div style="font-size:13px; color:#8b9690; margin-bottom:14px;"><a href={`${base}/`} style="cursor:pointer; text-decoration:none; color:inherit;">Home</a> &nbsp;/&nbsp; Categories</div>
    <div class="disp" style="font-size:40px; font-weight:800; letter-spacing:-0.03em;">Browse by category</div>
    <div style="font-size:16px; color:#5c665f; margin-top:10px; max-width:560px;">Jump into a slice of the {theme.techName} ecosystem. {total} projects across {catCount} categories.</div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:34px;">
      {cats.map((c) => (
        <a href={href(c.label)} class="card" style={`border-radius:${radius}; padding:22px;`}>
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <div class="disp" style="font-weight:700; font-size:19px; letter-spacing:-0.01em;">{c.label}</div>
            <span style={`background:color-mix(in srgb, ${theme.accent} 13%, #fff); color:${theme.editorial ? "#0a0a0a" : theme.accent}; font-weight:700; font-size:13px; padding:3px 10px; border-radius:20px;`}>{c.count}</span>
          </div>
          <div style="font-size:13.5px; color:#6b756f; margin-top:8px; line-height:1.45;">{c.blurb}</div>
          <div style={`margin-top:16px; font-size:13px; font-weight:600; color:${theme.editorial ? "#0a0a0a" : theme.accent};`}>Explore →</div>
        </a>
      ))}
    </div>
  </div>
)}
