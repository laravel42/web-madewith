---
/**
 * Generated repository cover — the local, zero-download replacement for the
 * GitHub OpenGraph image on cards. Shows the GitHub mark, the repo name, and the
 * available repo stats (contributors, issues, discussions, stars, forks) — each
 * omitted when the data is missing or zero. Themed per domain, with an accent
 * bottom border. No description (the card body already carries it).
 */
import type { Theme } from "../config/domains";
import { formatStars } from "../lib/catalog";

interface Props {
  theme: Theme;
  name: string;
  stars?: number;
  forks?: number;
  watchers?: number;
  issues?: number;
  discussions?: number;
  contributors?: number;
  size?: "card" | "sm";
}

const { theme, name, stars, forks, watchers, issues, discussions, contributors, size = "card" } = Astro.props;
const dark = theme.variant === "terminal";
const accent = theme.accent;

const bg = dark ? "#0e120f" : "#ffffff";
const nameColor = dark ? "#e8efe9" : "#1f2328";
const muted = dark ? "#9aa69e" : "#59636e";

const clip = (s: string, n: number) => {
  const t = (s || "").trim();
  return t.length > n ? t.slice(0, n - 1).trimEnd() + "…" : t;
};

// Octicons (16px viewBox) — GitHub mark + the stat glyphs.
const ICONS: Record<string, string> = {
  github: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z",
  star: "M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z",
  fork: "M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z",
  issue: "M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z",
  discussion: "M1.75 1h8.5c.966 0 1.75.784 1.75 1.75v5.5A1.75 1.75 0 0 1 10.25 10H7.061l-2.574 2.573A1.458 1.458 0 0 1 2 11.543V10h-.25A1.75 1.75 0 0 1 0 8.25v-5.5C0 1.784.784 1 1.75 1ZM1.5 2.75v5.5c0 .138.112.25.25.25h1a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h3.5a.25.25 0 0 0 .25-.25v-5.5a.25.25 0 0 0-.25-.25h-8.5a.25.25 0 0 0-.25.25Zm13 2a.25.25 0 0 0-.25-.25h-.5a.75.75 0 0 1 0-1.5h.5c.966 0 1.75.784 1.75 1.75v5.5A1.75 1.75 0 0 1 14.25 12H14v1.543a1.458 1.458 0 0 1-2.487 1.03L9.22 12.28a.749.749 0 0 1 .53-1.28h.5a.25.25 0 0 0 .25-.25Z",
  eye: "M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z",
  people: "M2 5.5a3.5 3.5 0 1 1 5.898 2.549 5.508 5.508 0 0 1 3.034 4.084.75.75 0 1 1-1.482.235 4 4 0 0 0-7.9 0 .75.75 0 0 1-1.482-.236A5.507 5.507 0 0 1 3.1 8.049 3.493 3.493 0 0 1 2 5.5ZM11 4a3.001 3.001 0 0 1 2.22 5.018 5.01 5.01 0 0 1 2.56 3.012.749.749 0 0 1-.885.954.752.752 0 0 1-.549-.514 3.507 3.507 0 0 0-2.522-2.372.75.75 0 0 1-.575-.729v-.352a.75.75 0 0 1 .548-.722 1.5 1.5 0 0 0-.487-2.921.75.75 0 0 1-.803-.882A.75.75 0 0 1 11 4Zm-5.5-.5a2 2 0 1 0-.001 3.999A2 2 0 0 0 5.5 3.5Z",
};

// Requested order; omit whatever's missing or zero. Open issues are not shown:
// the Octicon issue glyph is a plain dotted circle, and a bare number beside a
// star and a fork read as an unlabelled mystery count rather than "open issues".
const rawStats: Array<{ icon: string; v?: number }> = [
  { icon: "people", v: contributors },
  { icon: "discussion", v: discussions },
  { icon: "star", v: stars },
  { icon: "fork", v: forks },
  { icon: "eye", v: watchers },
];
const isSm = size === "sm";
const maxStats = isSm ? 3 : 4;
const present = rawStats.filter((s) => typeof s.v === "number" && s.v > 0).slice(0, maxStats);

// ---- size-specific geometry ----
const padL = isSm ? 4 : 7;
const VW = isSm ? 176 : 340;
const VH = isSm ? 92 : 124;
const borderH = isSm ? 4 : 6;
const favSize = isSm ? 15 : 22;
const favX = (isSm ? 14 : 22) + padL;
const favY = isSm ? 12 : 22;
const nameX = (isSm ? 36 : 54) + padL;
const nameY = isSm ? 26 : 40;
const nameFont = isSm ? 13 : 20;
const nameClipN = isSm ? 14 : 22;
const iconSize = isSm ? 12 : 15;
const statFont = isSm ? 10.5 : 13;
const statBaseline = isSm ? 74 : 72;
const iconTop = statBaseline - (isSm ? 10 : 12);
const charW = isSm ? 6.2 : 7.3;
const gapAfter = isSm ? 12 : 16;

let cursor = (isSm ? 14 : 24) + padL;
const placed = present.map((s) => {
  const label = formatStars(s.v as number);
  const item = { icon: s.icon, label, x: cursor };
  cursor += iconSize + 5 + label.length * charW + gapAfter;
  return item;
});
const glow = dark ? 0.12 : 0.085;
const glow2 = dark ? 0.1 : 0.06;
---

<div style="position:absolute; inset:0; overflow:hidden;">
  <svg aria-hidden="true" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMinYMid slice" style="position:absolute; inset:0; width:100%; height:100%; display:block;">
    <rect x="0" y="0" width={VW} height={VH} style={`fill:${bg}`} />
    {/* background visual — soft accent glow + faint accent motes */}
    <circle cx={VW - 8} cy={-10} r={isSm ? 58 : 112} style={`fill:${accent};opacity:${glow}`} />
    <circle cx={VW - 8} cy={-10} r={isSm ? 34 : 66} style={`fill:${accent};opacity:${glow2}`} />
    {!isSm && <circle cx="6" cy="138" r="70" style={`fill:${accent};opacity:${dark ? 0.07 : 0.05}`} />}
    {!isSm && [[298, 40, 2], [317, 66, 1.5], [283, 58, 1.5], [322, 28, 2.4], [268, 46, 1.4]].map(([cx, cy, r]) => (
      <circle cx={cx} cy={cy} r={r} style={`fill:${accent};opacity:0.26`} />
    ))}

    {/* GitHub mark */}
    <g transform={`translate(${favX} ${favY}) scale(${favSize / 16})`}>
      <path d={ICONS.github} fill-rule="evenodd" style={`fill:${nameColor}`} />
    </g>
    {/* repo name */}
    <text x={nameX} y={nameY} style={`fill:${nameColor};font:700 ${nameFont}px system-ui,sans-serif`}>{clip(name, nameClipN)}</text>

    {/* stats */}
    {placed.map((p) => (
      <g>
        <g transform={`translate(${p.x} ${iconTop}) scale(${iconSize / 16})`}>
          <path d={ICONS[p.icon]} fill-rule="evenodd" style={`fill:${p.icon === "star" ? "#e3a008" : muted}`} />
        </g>
        <text x={p.x + iconSize + 5} y={statBaseline} style={`fill:${nameColor};font:600 ${statFont}px system-ui,sans-serif`}>{p.label}</text>
      </g>
    ))}
  </svg>
  {/* thick technology-accent bottom border */}
  <div style={`position:absolute; left:0; right:0; bottom:0; height:${borderH}px; background:${accent};`}></div>
</div>
