---
import type { Theme } from "../config/domains";
import type { Project } from "../lib/catalog";
import { readableOn, readableOnDark, readableOnLight, readableOnSurfaceDark, tint } from "../config/accessible-color";
import { formatStars, timeAgo } from "../lib/catalog";
import { projectDisplayLong, projectDisplayName, projectPreviewExcerpt } from "../lib/preview-text";
import { renderArticle } from "../lib/markdown";
import InstallBox from "./InstallBox.astro";
import { installManagers } from "../lib/install-commands";
import { authorHref, hasAuthorPage } from "../lib/authors";
import ProjectCard from "./ProjectCard.astro";

interface Props { theme: Theme; project: Project; related: Project[]; }
const { theme, project, related } = Astro.props;
const base = `/${theme.slug}`;
const radius = `${theme.radius}px`;
const stars = formatStars(project.stars || 0);
const initial = (project.author || "").charAt(0).toUpperCase();
const displayName = projectDisplayName(project);
const displayDesc = projectPreviewExcerpt(project);
const displayLong1 = projectDisplayLong(project, "long1");
const displayLong2 = projectDisplayLong(project, "long2");
// The discovery worker's Markdown README, when this project has one.
const descriptionHtml = project.descriptionMd ? renderArticle(project.descriptionMd) : "";
const relatedCards = related.map((p) => ({ project: p, name: projectDisplayName(p) }));
// Ecosystems with no one-line install render no widget at all — skip its
// wrapper too, so the sidebar doesn't open with an empty 16px gap.
const hasInstall = installManagers(project, theme.slug).length > 0;
// Owners with projects in more than one gallery get a network-wide page; the
// in-gallery `?author=` filter can only ever show this gallery's share of them.
const authorLink = hasAuthorPage(project.author)
  ? authorHref(project.author)
  : `${base}/?author=${encodeURIComponent(project.author)}`;
// Counters shown beside the star count. Each is dropped when the scrape never
// captured it, so a project without the number shows nothing rather than "0".
const STAT_ICONS: Record<string, string> = {
  people: "M2 5.5a3.5 3.5 0 1 1 5.898 2.549 5.508 5.508 0 0 1 3.034 4.084.75.75 0 1 1-1.482.235 4 4 0 0 0-7.9 0 .75.75 0 0 1-1.482-.236A5.507 5.507 0 0 1 3.1 8.049 3.493 3.493 0 0 1 2 5.5ZM11 4a3.001 3.001 0 0 1 2.22 5.018 5.01 5.01 0 0 1 2.56 3.012.749.749 0 0 1-.885.954.752.752 0 0 1-.549-.514 3.507 3.507 0 0 0-2.522-2.372.75.75 0 0 1-.575-.729v-.352a.75.75 0 0 1 .548-.722 1.5 1.5 0 0 0-.487-2.921.75.75 0 0 1-.803-.882A.75.75 0 0 1 11 4Zm-5.5-.5a2 2 0 1 0-.001 3.999A2 2 0 0 0 5.5 3.5Z",
  package: "M8.878.392a1.75 1.75 0 0 0-1.756 0l-5.25 3.045A1.75 1.75 0 0 0 1 4.951v6.098c0 .624.332 1.2.872 1.514l5.25 3.045a1.75 1.75 0 0 0 1.756 0l5.25-3.045c.54-.313.872-.89.872-1.514V4.951c0-.624-.332-1.2-.872-1.514L8.878.392ZM7.875 1.69a.25.25 0 0 1 .25 0l4.63 2.685L8 7.133 3.245 4.375l4.63-2.685ZM2.5 5.677v5.372c0 .09.047.171.125.216l4.625 2.683V8.432Zm6.25 8.271 4.625-2.683a.25.25 0 0 0 .125-.216V5.677L8.75 8.432Z",
  fork: "M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z",
  eye: "M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z",
};
const headerStats = ([
  { icon: "people", label: "contributors", v: project.contributors },
  { icon: "package", label: "used by", v: project.usedBy },
  { icon: "fork", label: "forks", v: project.forks },
  { icon: "eye", label: "watchers", v: project.watchers },
] as Array<{ icon: string; label: string; v?: number }>)
  .filter((s) => typeof s.v === "number" && s.v > 0)
  .map((s) => ({ ...s, value: formatStars(s.v as number) }));
// Clock glyph for the related cards' scraped-date time-ago (matches the gallery cards).
const clockPath = "M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm7-3.25v2.992l2.028.812a.75.75 0 0 1-.557 1.392l-2.5-1A.751.751 0 0 1 7 8.25v-3.5a.75.75 0 0 1 1.5 0Z";
const isTerminal = theme.variant === "terminal";
const editorial = theme.editorial;
// `editorial` is a layout flag, not a background: Next renders it on its black
// shell, angular/sveltekit/rails/drupal/payload on the light one. Ink has to
// follow `darkShell`, which is the only token that says how dark the page is.
const darkShell = !!theme.darkShell;
const btnRadius = editorial ? "2px" : isTerminal ? "8px" : "10px";
const accentText = readableOnDark(theme.accent);
// Terminal tag chips sit on a 16% tint of their own ink, which lifts the fill
// out from under it — the near-black brands landed at 4.05:1 on it.
const tagBg = tint(accentText, 16, "#0c0f0e");
const tagInk = readableOnSurfaceDark(accentText, tagBg);
const muted = isTerminal ? "#a8b2ab" : "#5c665f";
// Light-branch page ink. Next puts this branch on #000000, every other domain
// on #fbfcfb, so each grey has a dark-shell and a light-shell value.
const pageMuted = darkShell ? "#a1a1a1" : "#5c665f"; // 8.1:1 on #000 / 5.8:1 on #fbfcfb
const pageBody = darkShell ? "#c4c4c4" : "#4a554f"; // 12.0:1 / 7.6:1
const pageStrong = darkShell ? "#ededed" : "#3a443f"; // 17.9:1 / 9.8:1
// The sidebar cards stay white on every shell, so they carry their own ink
// rather than inheriting the page ink — Next's #fafafa was 1.04:1 on #fff.
const cardInk = "#16201b"; // 16.7:1 on #fff
const cardMuted = "#5c665f"; // 6.0:1 on #fff (was #8b9690, 3.06:1)

// Dominant language keeps the brand accent, except editorial (Next) whose accent
// is white and would vanish on the light Languages card — give it a visible base.
const langBase = editorial ? "#6366f1" : isTerminal ? accentText : theme.accent;
const palette = isTerminal
  ? [langBase, "#7d9484", "#4f6357"]
  : [langBase, "#f59e0b", "#10b981", "#ec4899", "#06b6d4"];
const langs = (project.langs || []).map((l, i) => ({ ...l, color: palette[i] ?? (isTerminal ? "#6b7a70" : "#94a3b8") }));
// "Built with" chip — a light pill on every shell, so its ink is derived for a
// light surface and measured against the exact tint behind it. Indigo stands in
// on the dark shell, where the accent is white and would leave no tint to read.
const chipColor = darkShell ? "#6366f1" : theme.accent;
const chipBg = tint(chipColor, 14, "#ffffff");
const chipInk = readableOn(tint(chipColor, 58, "#1a221d"), chipBg);
const demo = project.demo;

// Latest 5 releases/tags (may be empty if the repo has none).
const versions = (project.versions || []).slice(0, 5);
const homeLabel = editorial ? "Back to gallery" : "Back to projects";
// The category pill keeps its 13% tint on white on every shell, so its ink is
// the light-surface accent checked against that exact tint — the raw accent was
// white-on-white for Next.
const soft = tint(theme.accent, 13, "#ffffff");
const pillInk = readableOn(readableOnLight(theme.accent), soft);
const previewVariant = isTerminal ? "terminal" : editorial ? "editorial" : "default";
---

{isTerminal ? (
  <div style="max-width:1200px; margin:0 auto; padding:36px 32px 80px;">
    <a href={`${base}/`} style={`display:inline-flex; align-items:center; gap:7px; font-size:13px; color:${muted}; cursor:pointer; text-decoration:none; margin-bottom:26px;`}>
      <span style={`color:${accentText};`}>&lt;</span> cd ../gallery
    </a>
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:30px; flex-wrap:wrap;">
      <div style="flex:1; min-width:300px;">
        <span style={`font-size:11px; color:${muted};`}>[{project.category}]</span>
        <h1 class="disp" style="font-size:40px; font-weight:700; letter-spacing:-0.02em; margin:10px 0 0; line-height:1.12; color:#f1f6f2;"><svg width="0.78em" height="0.78em" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="vertical-align:-0.04em; margin-right:.3em; flex:none;"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>{displayName} <span style={`font-size:.55em; font-weight:400; color:${muted}; letter-spacing:0;`}>by <a href={authorLink} class="filter-link" style="color:inherit;">{project.author}</a></span></h1>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        {demo && <a href={demo} target="_blank" rel="noopener" data-track-type="demo_link" style={`background:var(--accent-solid); color:${theme.accentInk}; font-weight:700; padding:9px 15px; border-radius:${btnRadius}; text-decoration:none; font-size:13px; display:inline-flex; align-items:center; gap:6px;`}>go to website ↗</a>}
        <a href={project.repoUrl} target="_blank" rel="noopener" data-track-type="github_link" style={`background:#24292f; color:#fff; font-weight:600; padding:9px 15px; border-radius:${btnRadius}; text-decoration:none; font-size:13px; display:inline-flex; align-items:center; gap:6px; border:1px solid #3a4048;`}><svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>github</a>
      </div>
    </div>

    {displayDesc && (
      <div style={`font-size:16px; color:#8b948d; margin-top:26px; line-height:1.6; border-left:4px solid ${accentText}; padding-left:18px;`}>{displayDesc}</div>
    )}

    <div style="display:flex; align-items:center; gap:18px; margin-top:20px; flex-wrap:wrap; row-gap:12px;">
      <div style="display:flex; align-items:center; gap:9px;">
        <span style={`width:36px; height:36px; border-radius:7px; background:color-mix(in srgb, ${accentText} 22%, #0c0f0e); color:${accentText}; border:1px solid ${accentText}; font-size:14px; font-weight:700; display:flex; align-items:center; justify-content:center; overflow:hidden;`}><img src={project.avatar} alt={project.author} width="36" height="36" style="width:100%;height:100%;object-fit:cover;" loading="lazy"/></span>
        <div><a href={authorLink} class="filter-link" style="font-size:13px; color:#e8efe9;">@{project.author}</a><div style={`font-size:11px; color:${muted};`}>maintainer</div></div>
      </div>
      <div style={`display:flex; align-items:center; gap:6px; font-size:14px; color:${accentText};`}>★ {stars} stars</div>
      {headerStats.map((s) => (
        <div style={`display:flex; align-items:center; gap:6px; font-size:14px; color:${muted};`}>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={STAT_ICONS[s.icon]} fill-rule="evenodd"/></svg>
          <span style="color:#e8efe9;">{s.value}</span> {s.label}
        </div>
      ))}
    </div>

    <div class="mw-split" style="display:grid; grid-template-columns:minmax(0,2.25fr) minmax(0,1fr); gap:40px; margin-top:30px; padding-top:30px; border-top:1px solid #1f2622;">
      <div>
        <div class="disp" style="font-size:21px; font-weight:600; color:#f1f6f2; margin-bottom:14px;"># README</div>
        {descriptionHtml ? (
          <div class="project-readme is-terminal" set:html={descriptionHtml} />
        ) : (
          <>
            <div style="font-size:14px; color:#a3ada7; line-height:1.75;">{displayLong1}</div>
            <div style="font-size:14px; color:#a3ada7; line-height:1.75; margin-top:14px;">{displayLong2}</div>
          </>
        )}
      </div>
      <div>
        {hasInstall && (
          <div style="margin-bottom:16px; --install-fz:11px;">
            <InstallBox theme={theme} project={project} />
          </div>
        )}
        <div style="background:#101410; border:1px solid #1f2622; border-radius:10px; padding:15px; margin-bottom:16px;">
          <div style={`font-size:12px; color:${muted}; text-transform:uppercase; letter-spacing:.04em; margin-bottom:12px;`}>tags</div>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            {project.stack.map((s) => <a href={`${base}/?tag=${encodeURIComponent(s)}`} class="tag-link" style={`font-size:11px; font-weight:600; color:${tagInk}; background:${tagBg}; border:1px solid color-mix(in srgb, ${accentText} 42%, #0c0f0e); padding:4px 10px; border-radius:999px;`}>{s}</a>)}
          </div>
        </div>
        <div style="background:#101410; border:1px solid #1f2622; border-radius:10px; padding:15px;">
          <div style={`font-size:12px; color:${muted}; text-transform:uppercase; letter-spacing:.04em; margin-bottom:16px;`}>languages</div>
          <div style="display:flex; height:8px; border-radius:6px; overflow:hidden; margin-bottom:16px; background:#0e120f;">
            {langs.map((l) => <span style={`width:${l.pct}%; background:${l.color}; height:100%;`}></span>)}
          </div>
          {langs.map((l) => (
            <div style="display:flex; align-items:center; justify-content:space-between; font-size:12.5px; margin-bottom:9px;">
              <span style="display:flex; align-items:center; gap:8px; color:#c7d0ca;"><span style={`width:9px; height:9px; border-radius:2px; background:${l.color}; display:inline-block;`}></span><a href={`${base}/?lang=${encodeURIComponent(l.name)}`} class="filter-link" style="color:inherit;">{l.name}</a></span>
              <span style={`color:${muted};`}>{l.pct}%</span>
            </div>
          ))}
          <div style={`border-top:1px solid #1c211e; margin-top:14px; padding-top:14px; display:flex; justify-content:space-between; font-size:12.5px;`}><span style={`color:${muted};`}>last commit</span><span style="color:#c7d0ca;">{timeAgo(project.pushedAt) || project.updated}</span></div>
          <div style="display:flex; justify-content:space-between; font-size:12.5px; margin-top:9px;"><span style={`color:${muted};`}>license</span><a href={`${base}/?license=${encodeURIComponent(project.license)}`} class="filter-link" style="color:#c7d0ca;">{project.license}</a></div>
        </div>
        {versions.length > 0 && (
          <div style="background:#101410; border:1px solid #1f2622; border-radius:10px; padding:13px 15px; margin-top:16px;">
            <div style={`font-size:12px; color:${muted}; text-transform:uppercase; letter-spacing:.04em; margin-bottom:10px;`}>latest versions</div>
            {versions.map((v) => (
              <a href={v.url} target="_blank" rel="noopener" class="version-link" style="font-size:12.5px; color:#c7d0ca;"><span style={`color:${accentText};`}>{v.name}</span><span style={`color:${muted};`}>↗</span></a>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="disp" style="font-size:21px; font-weight:600; color:#f1f6f2; margin:44px 0 18px;">more {theme.techName} repos</div>
    <div class="mw-grid3" style="display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px;">
      {relatedCards.map(({ project: p }, i) => (
        <ProjectCard theme={theme} project={p} rank={(i < 9 ? "0" : "") + (i + 1)} />
      ))}
    </div>
  </div>
) : (
  <div style="max-width:1200px; margin:0 auto; padding:36px 32px 80px;">
    <a href={`${base}/`} style={`display:inline-flex; align-items:center; gap:7px; font-size:14px; font-weight:600; color:${pageMuted}; cursor:pointer; text-decoration:none; margin-bottom:26px;`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m15 6-6 6 6 6" stroke={pageMuted} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> {homeLabel}
    </a>
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:30px; flex-wrap:wrap;">
      <div style="flex:1; min-width:300px;">
        <span style={`font-size:11px; font-weight:600; color:${pillInk}; background:${soft}; padding:3px 9px; border-radius:20px;`}>{project.category}</span>
        <h1 class="disp" style="font-size:42px; font-weight:800; letter-spacing:-0.03em; margin:14px 0 0; line-height:1.12;"><svg width="0.78em" height="0.78em" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="vertical-align:-0.04em; margin-right:.3em; flex:none;"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>{displayName} <span style={`font-size:.5em; font-weight:500; color:${pageMuted}; letter-spacing:-0.01em;`}>by <a href={authorLink} class="filter-link" style="color:inherit;">{project.author}</a></span></h1>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        {demo && <a href={demo} target="_blank" rel="noopener" data-track-type="demo_link" style={`background:var(--accent-solid); color:${theme.accentInk}; font-weight:700; padding:9px 16px; border-radius:${btnRadius}; text-decoration:none; font-size:13px; display:inline-flex; align-items:center; gap:6px;`}>Go to website ↗</a>}
        <a href={project.repoUrl} target="_blank" rel="noopener" data-track-type="github_link" style={`background:#24292f; color:#fff; font-weight:600; padding:9px 16px; border-radius:${btnRadius}; text-decoration:none; font-size:13px; display:inline-flex; align-items:center; gap:6px; border:1px solid #3a4048;`}><svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>View on GitHub</a>
      </div>
    </div>

    {displayDesc && (
      <div style={`font-size:18px; color:${pageMuted}; margin-top:26px; line-height:1.55; border-left:4px solid var(--accent-solid); padding-left:18px;`}>{displayDesc}</div>
    )}

    <div style="display:flex; align-items:center; gap:18px; margin-top:20px; flex-wrap:wrap; row-gap:12px;">
      <div style="display:flex; align-items:center; gap:9px;">
        <span style={`width:38px; height:38px; border-radius:50%; overflow:hidden; background:${theme.accent}; display:flex; align-items:center; justify-content:center;`}><img src={project.avatar} alt={project.author} width="38" height="38" style="width:100%;height:100%;object-fit:cover;" loading="lazy"/></span>
        <div><a href={authorLink} class="filter-link" style="font-size:14px; font-weight:600;">{project.author}</a><div style={`font-size:12px; color:${pageMuted};`}>Maintainer</div></div>
      </div>
      <div style={`display:flex; align-items:center; gap:6px; font-size:15px; font-weight:700; color:${pageStrong};`}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="#f5b400"><path d="m12 2 3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
        {stars} stars
      </div>
      {headerStats.map((s) => (
        <div style={`display:flex; align-items:center; gap:6px; font-size:15px; color:${pageMuted};`}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={STAT_ICONS[s.icon]} fill-rule="evenodd"/></svg>
          <span style={`font-weight:700; color:${pageStrong};`}>{s.value}</span> {s.label}
        </div>
      ))}
    </div>

    <div class="mw-split" style="display:grid; grid-template-columns:minmax(0,2.25fr) minmax(0,1fr); gap:40px; margin-top:30px; padding-top:30px; border-top:1px solid #eef0ef;">
      <div>
        <div class="disp" style="font-size:22px; font-weight:700; margin-bottom:14px;">About this project</div>
        {descriptionHtml ? (
          <div class="project-readme" style={`--readme-body:${pageBody};`} set:html={descriptionHtml} />
        ) : (
          <>
            <div style={`font-size:15.5px; color:${pageBody}; line-height:1.7;`}>{displayLong1}</div>
            <div style={`font-size:15.5px; color:${pageBody}; line-height:1.7; margin-top:14px;`}>{displayLong2}</div>
          </>
        )}
      </div>
      <div>
        {hasInstall && (
          <div style="margin-bottom:16px; --install-fz:12px;">
            <InstallBox theme={theme} project={project} />
          </div>
        )}
        <div style={`background:#fff; color:${cardInk}; border:1px solid #eef0ef; border-radius:${radius}; padding:16px; margin-bottom:16px;`}>
          <div style={`font-size:13px; font-weight:700; color:${cardMuted}; text-transform:uppercase; letter-spacing:.04em; margin-bottom:14px;`}>Tags</div>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            {project.stack.map((s) => <a href={`${base}/?tag=${encodeURIComponent(s)}`} class="tag-link" style={`font-size:12px; font-weight:600; color:${chipInk}; background:${chipBg}; border:1px solid color-mix(in srgb, ${chipColor} 30%, #fff); padding:4px 10px; border-radius:999px;`}>{s}</a>)}
          </div>
        </div>
        <div style={`background:#fff; color:${cardInk}; border:1px solid #eef0ef; border-radius:${radius}; padding:16px;`}>
          <div style={`font-size:13px; font-weight:700; color:${cardMuted}; text-transform:uppercase; letter-spacing:.04em; margin-bottom:16px;`}>Languages</div>
          <div style="display:flex; height:8px; border-radius:6px; overflow:hidden; margin-bottom:16px;">
            {langs.map((l) => <span style={`width:${l.pct}%; background:${l.color}; height:100%;`}></span>)}
          </div>
          {langs.map((l) => (
            <div style="display:flex; align-items:center; justify-content:space-between; font-size:13.5px; margin-bottom:9px;">
              <span style="display:flex; align-items:center; gap:8px; color:#3a443f;"><span style={`width:9px; height:9px; border-radius:3px; background:${l.color}; display:inline-block;`}></span><a href={`${base}/?lang=${encodeURIComponent(l.name)}`} class="filter-link" style="color:inherit;">{l.name}</a></span>
              <span style={`color:${cardMuted};`}>{l.pct}%</span>
            </div>
          ))}
          <div style="border-top:1px solid #f0f2f0; margin-top:14px; padding-top:14px; display:flex; justify-content:space-between; font-size:13.5px;"><span style={`color:${cardMuted};`}>Last updated</span><span style="font-weight:600;">{timeAgo(project.pushedAt) || project.updated}</span></div>
          <div style="display:flex; justify-content:space-between; font-size:13.5px; margin-top:9px;"><span style={`color:${cardMuted};`}>License</span><a href={`${base}/?license=${encodeURIComponent(project.license)}`} class="filter-link" style="font-weight:600; color:inherit;">{project.license}</a></div>
        </div>
        {versions.length > 0 && (
          <div style={`background:#fff; color:${cardInk}; border:1px solid #eef0ef; border-radius:${radius}; padding:13px 16px; margin-top:16px;`}>
            <div style={`font-size:13px; font-weight:700; color:${cardMuted}; text-transform:uppercase; letter-spacing:.04em; margin-bottom:10px;`}>Latest versions</div>
            {versions.map((v) => (
              <a href={v.url} target="_blank" rel="noopener" class="version-link" style="font-size:13.5px; color:#3a443f;"><span style="font-weight:600;">{v.name}</span><span style={`color:${cardMuted};`}>↗</span></a>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="disp" style="font-size:22px; font-weight:700; margin:44px 0 18px;">More {theme.techName} projects</div>
    <div class="mw-grid3" style="display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px;">
      {relatedCards.map(({ project: p }, i) => (
        <ProjectCard theme={theme} project={p} rank={(i < 9 ? "0" : "") + (i + 1)} />
      ))}
    </div>
  </div>
)}

<script>
  document.addEventListener("click", (e: MouseEvent) => {
    const target = (e.target as HTMLElement).closest<HTMLAnchorElement>("[data-track-type]");
    if (!target) return;
    const type = target.dataset.trackType;
    if (type === "github_link") {
      (window as any).posthog?.capture("github_link_clicked", { url: target.href });
    } else if (type === "demo_link") {
      (window as any).posthog?.capture("demo_link_clicked", { url: target.href });
    }
  });
</script>

<style>
  /* The discovery worker's README is Markdown with six H1 sections. Inside the
     About block those are subsections, not page titles, so they're sized down
     to sit under the block heading rather than compete with it. */
  .project-readme {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--readme-body, inherit);
    /* Generated Markdown carries bare URLs and long identifiers; without this
       they set the column's intrinsic minimum and shove the sidebar off-page. */
    overflow-wrap: anywhere;
  }

  /* Code blocks scroll inside their own box rather than widening the column. */
  .project-readme :global(pre) { overflow-x: auto; max-width: 100%; }
  .project-readme :global(table) { display: block; overflow-x: auto; max-width: 100%; }
  .project-readme :global(img) { max-width: 100%; height: auto; }

  .project-readme :global(h1) {
    font-family: var(--disp, inherit);
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.35;
    margin: 24px 0 8px;
    color: inherit;
  }

  /* Models nest subsections (e.g. under Use Cases). They're legitimate
     structure, but must read as subordinate to the six H1 sections. */
  .project-readme :global(h2),
  .project-readme :global(h3) {
    font-family: var(--disp, inherit);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.4;
    margin: 16px 0 6px;
    opacity: 0.85;
  }

  .project-readme :global(h1:first-child) {
    margin-top: 0;
  }

  .project-readme :global(p) {
    margin: 0 0 12px;
  }

  .project-readme :global(ul),
  .project-readme :global(ol) {
    margin: 0 0 12px;
    padding-left: 20px;
  }

  .project-readme :global(li) {
    margin-bottom: 4px;
  }

  .project-readme :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-readme :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.92em;
  }

  /* Terminal domains render the block on a dark shell. */
  .project-readme.is-terminal {
    font-size: 14px;
    line-height: 1.75;
    color: #a3ada7;
  }

  .project-readme.is-terminal :global(h1),
  .project-readme.is-terminal :global(h2),
  .project-readme.is-terminal :global(h3) {
    font-size: 15.5px;
    font-weight: 600;
    color: #f1f6f2;
  }
</style>
