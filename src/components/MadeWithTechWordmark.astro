---
interface Props {
  techName: string;
  accent: string;
  size?: "header" | "footer" | "compact";
}

const { techName, accent, size = "header" } = Astro.props;
const mainSize = size === "header" ? "21px" : size === "footer" ? "16px" : "12.5px";
const withSize = size === "header" ? "20px" : size === "footer" ? "16px" : "12.5px";
---

<span
  class="mwt-wordmark"
  style={`font-family:"Bricolage Grotesque",sans-serif; font-weight:800; font-size:${mainSize}; letter-spacing:-0.01em;`}
>
  Made <span style={`font-size:${withSize}; font-weight:800;`}>with</span>
  <span style={`color:${accent};`}>{techName}</span>
</span>

<style>
  .mwt-wordmark {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
