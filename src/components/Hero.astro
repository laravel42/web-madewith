---
import type { Theme } from "../config/domains";
import type { CategoryFilter } from "../lib/catalog";
import NuxtHero from "./heroes/NuxtHero.astro";
import NodeHero from "./heroes/NodeHero.astro";
import NextHero from "./heroes/NextHero.astro";
import IonicHero from "./heroes/IonicHero.astro";
import StatamicHero from "./heroes/StatamicHero.astro";
import TwillHero from "./heroes/TwillHero.astro";

import GenericHero from "./heroes/GenericHero.astro";

interface Props {
  theme: Theme;
  total: string;
  categories: CategoryFilter[];
}
const { theme, total, categories } = Astro.props;

const HEROES = {
  nuxt: NuxtHero,
  node: NodeHero,
  next: NextHero,
  ionic: IonicHero,
  statamic: StatamicHero,
  twill: TwillHero,
  generic: GenericHero,
} as const;

const HeroComponent = HEROES[theme.heroId];
---
<HeroComponent theme={theme} total={total} categories={categories} />
