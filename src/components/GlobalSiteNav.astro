---
import NavIcon from "./NavIcon.astro";

export type GlobalNavActive = "network" | "blog" | "rss";

interface Props {
  active?: GlobalNavActive;
  class?: string;
  subscribeHref?: string;
  subscribeLabel?: string;
  includeBlog?: boolean;
  includeRss?: boolean;
  includeSubscribe?: boolean;
  variant?: "light" | "terminal";
  part?: "all" | "links" | "subscribe";
}

const {
  active,
  class: className = "",
  subscribeHref = "/newsletter/",
  subscribeLabel = "Subscribe",
  includeBlog = true,
  includeRss = true,
  includeSubscribe = true,
  variant = "light",
  part = "all",
} = Astro.props;

const showLinks = part === "all" || part === "links";
const showSubscribe = includeSubscribe && (part === "all" || part === "subscribe");
---

{showLinks && (
<nav class:list={["global-site-nav", variant === "terminal" && "is-terminal", className]} aria-label="Site">
  <a href="/" class:list={["global-site-nav-link", "filter-link", active === "network" && "is-active"]}>
    <NavIcon name="network" />
    Network
  </a>
  {includeBlog && (
    <a href="/blog/" class:list={["global-site-nav-link", "filter-link", active === "blog" && "is-active"]}>
      <NavIcon name="blog" />
      Blog
    </a>
  )}
  {includeRss && (
    <a href="/blog/rss/" class:list={["global-site-nav-link", "filter-link", active === "rss" && "is-active"]}>
      <NavIcon name="rss" />
      RSS
    </a>
  )}
  {showSubscribe && part === "all" && (
    <a href={subscribeHref} class="global-site-nav-subscribe">{subscribeLabel}</a>
  )}
</nav>
)}
{showSubscribe && part === "subscribe" && (
  <a href={subscribeHref} class="global-site-nav-subscribe">{subscribeLabel}</a>
)}

<style>
  .global-site-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
  }

  .global-site-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 5px 11px;
    border-radius: 999px;
    color: #2a3038;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.12s ease, background 0.12s ease, text-decoration-color 0.12s ease;
  }

  .global-site-nav-link.is-active {
    color: #12161a;
    font-weight: 700;
    background: color-mix(in srgb, rgb(47, 111, 235) 14%, transparent);
  }

  .global-site-nav-link.is-active :global(.nav-icon) {
    opacity: 1;
  }

  .global-site-nav-link:hover {
    color: rgb(47, 111, 235);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .global-site-nav-link.is-active:hover {
    color: #12161a;
    text-decoration: none;
  }

  .global-site-nav.is-terminal .global-site-nav-link {
    color: #7c887f;
  }

  .global-site-nav.is-terminal .global-site-nav-link.is-active {
    color: #e8efe9;
    background: color-mix(in srgb, var(--global-nav-accent, #5fa04e) 18%, transparent);
  }

  .global-site-nav.is-terminal .global-site-nav-link:hover {
    color: var(--global-nav-accent, #5fa04e);
  }

  .global-site-nav.is-terminal .global-site-nav-link.is-active:hover {
    color: #e8efe9;
  }

  .global-site-nav-subscribe {
    display: inline-flex;
    align-items: center;
    color: #fff;
    background: #2f6feb;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.12s ease;
  }

  .global-site-nav-subscribe:hover {
    background: #1c4fbf;
  }

  @media (max-width: 768px) {
    .global-site-nav {
      gap: 6px;
      font-size: 13px;
    }
  }
</style>
