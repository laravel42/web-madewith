---
import type { Theme } from "../config/domains";
import { CATEGORY_ORDER } from "../config/categories";
interface Props { theme: Theme; }
const { theme } = Astro.props;
const base = `/${theme.slug}`;
const radius = `${theme.radius}px`;
const isTerminal = theme.variant === "terminal";
const btnRadius = theme.editorial ? "2px" : isTerminal ? "8px" : "10px";
const labels = isTerminal
  ? { repo: "repository_url", name: "project_name", desc: "description", cat: "category", demo: "demo_url", shot: "screenshot", submit: "./submit" }
  : { repo: "GitHub repository URL", name: "Project name", desc: "Short description", cat: "Category", demo: "Live demo URL", shot: "Screenshot", submit: "Submit project" };
---

{isTerminal ? (
  <div style="max-width:680px; margin:0 auto; padding:48px 32px 90px;">
    <div data-role="submit-success" hidden style="text-align:center; padding:60px 0;">
      <div style={`width:64px; height:64px; border-radius:12px; background:color-mix(in srgb, ${theme.accent} 22%, #0c0f0e); border:1px solid ${theme.accent}; display:flex; align-items:center; justify-content:center; margin:0 auto 22px;`}>
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4 10-10" stroke={theme.accent} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="disp" style="font-size:28px; font-weight:700; color:#f1f6f2;">✓ submission queued</div>
      <div style="font-size:14px; color:#8b948d; margin-top:12px; max-width:440px; margin-inline:auto; line-height:1.6;">We'll review your repo and merge it into the {theme.techName} index within 48h. Thanks for contributing.</div>
      <a href={`${base}/`} style={`border:1px solid ${theme.accent}; color:${theme.accent}; background:transparent; padding:12px 22px; border-radius:8px; text-decoration:none; font-size:14px; display:inline-block; margin-top:26px;`}>cd ../gallery</a>
    </div>
    <form data-role="submit-form">
      <div style={`font-size:13px; color:${theme.accent}; margin-bottom:16px;`}>// contribute</div>
      <div class="disp" style="font-size:38px; font-weight:700; letter-spacing:-0.02em; color:#f1f6f2;">Submit your project</div>
      <div style="font-size:14px; color:#8b948d; margin-top:10px; line-height:1.6;">Shipped something with {theme.techName}? Add it to the index — free, and great for backlinks.</div>
      <div style="margin-top:32px; display:flex; flex-direction:column; gap:20px;">
        <div><label for="t-repo" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.repo}</label><input id="t-repo" name="repo" type="url" required placeholder="https://github.com/you/your-project" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;"/></div>
        <div><label for="t-name" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.name}</label><input id="t-name" name="name" required placeholder="e.g. Pulse" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;"/></div>
        <div><label for="t-desc" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.desc}</label><textarea id="t-desc" name="description" rows="3" placeholder="One sentence on what it does." style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9; resize:vertical;"></textarea></div>
        <div style="display:flex; gap:16px;">
          <div style="flex:1;"><label for="t-category" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.cat}</label><select id="t-category" name="category" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;">{CATEGORY_ORDER.map((c) => <option>{c}</option>)}</select></div>
          <div style="flex:1;"><label for="t-demo" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.demo}</label><input id="t-demo" name="demo" type="url" placeholder="https://…" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;"/></div>
        </div>
        <div><div style="font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.shot}</div>
          <div style="border:1.5px dashed #2a332d; border-radius:10px; padding:34px; text-align:center; color:#5c665f; font-size:13px; background:#101410;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" style="margin-bottom:8px;"><path d="M12 16V4m0 0L8 8m4-4 4 4" stroke="#4a554f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="#4a554f" stroke-width="2" stroke-linecap="round"/></svg>
            <div>Drop an image or <span style={`color:${theme.accent};`}>browse</span></div>
          </div>
        </div>
        <button type="submit" style={`background:${theme.accent}; color:#04231a; font-weight:700; padding:15px 22px; border-radius:8px; cursor:pointer; font-size:14px; text-align:center; margin-top:6px; border:none;`}>{labels.submit}</button>
      </div>
    </form>
  </div>
) : (
  <div style="max-width:680px; margin:0 auto; padding:48px 32px 90px;">
    <div data-role="submit-success" hidden style="text-align:center; padding:60px 0;">
      <div style={`width:64px; height:64px; border-radius:50%; background:${theme.accent}; display:flex; align-items:center; justify-content:center; margin:0 auto 22px;`}>
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4 10-10" stroke={theme.accentInk} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="disp" style="font-size:30px; font-weight:800; letter-spacing:-0.02em;">Submission received!</div>
      <div style="font-size:16px; color:#5c665f; margin-top:12px; max-width:420px; margin-inline:auto; line-height:1.55;">We'll review your project and add it to the {theme.techName} gallery within 48 hours. Thanks for contributing.</div>
      <a href={`${base}/`} class="btn btn-primary" style="padding:13px 22px; font-size:15px; margin-top:26px;">Back to gallery</a>
    </div>
    <form data-role="submit-form">
      <div style={`font-size:13px; font-weight:600; color:${theme.accent}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;`}>Contribute</div>
      <div class="disp" style="font-size:40px; font-weight:800; letter-spacing:-0.03em;">Submit your project</div>
      <div style="font-size:16px; color:#5c665f; margin-top:10px; line-height:1.55;">Built something with {theme.techName}? Add it to the gallery — free, and great for backlinks.</div>
      <div style="margin-top:34px; display:flex; flex-direction:column; gap:20px;">
        <div><label for="l-repo" style="display:block; font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">{labels.repo}</label><input id="l-repo" name="repo" type="url" required placeholder="https://github.com/you/your-project" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}/></div>
        <div><label for="l-name" style="display:block; font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">{labels.name}</label><input id="l-name" name="name" required placeholder="e.g. Pulse" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}/></div>
        <div><label for="l-desc" style="display:block; font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">{labels.desc}</label><textarea id="l-desc" name="description" rows="3" placeholder="One sentence on what it does." style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b; resize:vertical;`}></textarea></div>
        <div style="display:flex; gap:16px;">
          <div style="flex:1;"><label for="l-category" style="display:block; font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">{labels.cat}</label><select id="l-category" name="category" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}>{CATEGORY_ORDER.map((c) => <option>{c}</option>)}</select></div>
          <div style="flex:1;"><label for="l-demo" style="display:block; font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">{labels.demo}</label><input id="l-demo" name="demo" type="url" placeholder="https://…" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}/></div>
        </div>
        <div><div style="font-size:13px; font-weight:600; color:#3a443f; margin-bottom:8px;">{labels.shot}</div>
          <div style={`border:1.5px dashed #d6ddd9; border-radius:${radius}; padding:34px; text-align:center; color:#8b9690; font-size:14px; background:#fff;`}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" style="margin-bottom:8px;"><path d="M12 16V4m0 0L8 8m4-4 4 4" stroke="#aab3ae" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="#aab3ae" stroke-width="2" stroke-linecap="round"/></svg>
            <div>Drop an image or <span style={`color:${theme.editorial ? "#0a0a0a" : theme.accent};`}>browse</span></div>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" style="padding:15px 22px; font-size:15px; margin-top:6px; border:none; width:100%;">{labels.submit}</button>
      </div>
    </form>
  </div>
)}

<script>
  function initSubmit() {
    const form = document.querySelector<HTMLFormElement>('[data-role="submit-form"]');
    const success = document.querySelector<HTMLElement>('[data-role="submit-success"]');
    if (!form || !success) return;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.hidden = true;
      success.hidden = false;
      window.scrollTo({ top: 0 });
    });
  }
  initSubmit();
  document.addEventListener("astro:page-load", initSubmit);
</script>
