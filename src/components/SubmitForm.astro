---
import type { Theme } from "../config/domains";
import { CATEGORY_ORDER } from "../config/categories";
interface Props { theme: Theme; }
const { theme } = Astro.props;
const base = `/${theme.slug}`;
const isTerminal = theme.variant === "terminal";
const btnRadius = theme.editorial ? "2px" : isTerminal ? "8px" : "10px";
// Page-level ink. The light branch also renders on Next's black shell, so the
// greys follow `darkShell` rather than `editorial` (which angular/rails/drupal/
// payload share while sitting on #fbfcfb).
const labelInk = theme.darkShell ? "#b4b4b4" : "#3a443f"; // 10.1:1 on #000 / 9.8:1 on #fbfcfb
const bodyInk = theme.darkShell ? "#a3ada7" : "#5c665f"; // 9.1:1 on #000 / 5.8:1 on #fbfcfb
const labels = isTerminal
  ? { repo: "repository_url", name: "project_name", desc: "description", cat: "category", demo: "demo_url", submit: "./submit" }
  : { repo: "GitHub repository URL", name: "Project name", desc: "Short description", cat: "Category", demo: "Live demo URL", submit: "Submit project" };
---

{isTerminal ? (
  <div style="max-width:680px; margin:0 auto; padding:48px 32px 90px;">
    <div data-role="submit-success" hidden style="text-align:center; padding:60px 0;">
      <div style={`width:64px; height:64px; border-radius:12px; background:color-mix(in srgb, ${theme.accent} 22%, #0c0f0e); border:1px solid ${theme.accent}; display:flex; align-items:center; justify-content:center; margin:0 auto 22px;`}>
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4 10-10" stroke={theme.accent} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="disp" style="font-size:28px; font-weight:700; color:#f1f6f2;">✓ submission queued</div>
      <div style="font-size:14px; color:#8b948d; margin-top:12px; max-width:440px; margin-inline:auto; line-height:1.6;">We'll review your repo and merge it into the {theme.techName} index within 48h. Thanks for contributing.</div>
      <a href={`${base}/`} style="border:1px solid var(--accent-text); color:var(--accent-text); background:transparent; padding:12px 22px; border-radius:8px; text-decoration:none; font-size:14px; display:inline-block; margin-top:26px;">cd ../gallery</a>
    </div>
    <form data-role="submit-form" data-slug={theme.slug}>
      <div style="font-size:13px; color:var(--accent-text); margin-bottom:16px;">// contribute</div>
      <div class="disp" style="font-size:38px; font-weight:700; letter-spacing:-0.02em; color:#f1f6f2;">Submit your project</div>
      <div style="font-size:14px; color:#8b948d; margin-top:10px; line-height:1.6;">Shipped something with {theme.techName}? Add it to the index — free, and great for backlinks.</div>
      <div style="margin-top:32px; display:flex; flex-direction:column; gap:20px;">
        <div><label for="t-repo" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.repo}</label><input id="t-repo" name="repo" type="url" required placeholder="https://github.com/you/your-project" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;"/></div>
        <div><label for="t-name" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.name}</label><input id="t-name" name="name" required placeholder="e.g. Pulse" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;"/></div>
        <div><label for="t-desc" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.desc}</label><textarea id="t-desc" name="description" rows="3" placeholder="One sentence on what it does." style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9; resize:vertical;"></textarea></div>
        <div style="display:flex; gap:16px;">
          <div style="flex:1;"><label for="t-category" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.cat}</label><select id="t-category" name="category" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;">{CATEGORY_ORDER.map((c) => <option>{c}</option>)}</select></div>
          <div style="flex:1;"><label for="t-demo" style="display:block; font-size:12px; color:#7c887f; margin-bottom:8px;">{labels.demo}</label><input id="t-demo" name="demo" type="url" placeholder="https://…" style="width:100%; border:1px solid #232a26; border-radius:8px; padding:13px 15px; font-size:14px; outline:none; background:#121614; color:#e8efe9;"/></div>
        </div>
        <button type="submit" style="background:var(--accent-solid); color:var(--accentInk); font-weight:700; padding:15px 22px; border-radius:8px; cursor:pointer; font-size:14px; text-align:center; margin-top:6px; border:none;">{labels.submit}</button>
      </div>
    </form>
  </div>
) : (
  <div style="max-width:680px; margin:0 auto; padding:48px 32px 90px;">
    <div data-role="submit-success" hidden style="text-align:center; padding:60px 0;">
      <div style={`width:64px; height:64px; border-radius:50%; background:var(--accent-solid); display:flex; align-items:center; justify-content:center; margin:0 auto 22px;`}>
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4 10-10" stroke={theme.accentInk} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="disp" style="font-size:30px; font-weight:800; letter-spacing:-0.02em;">Submission received!</div>
      <div style={`font-size:16px; color:${bodyInk}; margin-top:12px; max-width:420px; margin-inline:auto; line-height:1.55;`}>We'll review your project and add it to the {theme.techName} gallery within 48 hours. Thanks for contributing.</div>
      <a href={`${base}/`} class="btn btn-primary" style="padding:13px 22px; font-size:15px; margin-top:26px;">Back to gallery</a>
    </div>
    <form data-role="submit-form" data-slug={theme.slug}>
      <div style="font-size:13px; font-weight:600; color:var(--accent-text); letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;">Contribute</div>
      <div class="disp" style="font-size:40px; font-weight:800; letter-spacing:-0.03em;">Submit your project</div>
      <div style={`font-size:16px; color:${bodyInk}; margin-top:10px; line-height:1.55;`}>Built something with {theme.techName}? Add it to the gallery — free, and great for backlinks.</div>
      <div style="margin-top:34px; display:flex; flex-direction:column; gap:20px;">
        <div><label for="l-repo" style={`display:block; font-size:13px; font-weight:600; color:${labelInk}; margin-bottom:8px;`}>{labels.repo}</label><input id="l-repo" name="repo" type="url" required placeholder="https://github.com/you/your-project" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}/></div>
        <div><label for="l-name" style={`display:block; font-size:13px; font-weight:600; color:${labelInk}; margin-bottom:8px;`}>{labels.name}</label><input id="l-name" name="name" required placeholder="e.g. Pulse" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}/></div>
        <div><label for="l-desc" style={`display:block; font-size:13px; font-weight:600; color:${labelInk}; margin-bottom:8px;`}>{labels.desc}</label><textarea id="l-desc" name="description" rows="3" placeholder="One sentence on what it does." style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b; resize:vertical;`}></textarea></div>
        <div style="display:flex; gap:16px;">
          <div style="flex:1;"><label for="l-category" style={`display:block; font-size:13px; font-weight:600; color:${labelInk}; margin-bottom:8px;`}>{labels.cat}</label><select id="l-category" name="category" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}>{CATEGORY_ORDER.map((c) => <option>{c}</option>)}</select></div>
          <div style="flex:1;"><label for="l-demo" style={`display:block; font-size:13px; font-weight:600; color:${labelInk}; margin-bottom:8px;`}>{labels.demo}</label><input id="l-demo" name="demo" type="url" placeholder="https://…" style={`width:100%; border:1px solid #e0e5e2; border-radius:${btnRadius}; padding:13px 15px; font-size:15px; outline:none; background:#fff; color:#16201b;`}/></div>
        </div>
        <button type="submit" class="btn btn-primary" style="padding:15px 22px; font-size:15px; margin-top:6px; border:none; width:100%;">{labels.submit}</button>
      </div>
    </form>
  </div>
)}

<script>
  import { submitProject } from "../lib/public-api";

  function initSubmit() {
    const form = document.querySelector<HTMLFormElement>('[data-role="submit-form"]');
    const success = document.querySelector<HTMLElement>('[data-role="submit-success"]');
    if (!form || !success || form.dataset.submitInitialized) return;
    form.dataset.submitInitialized = "true";

    const val = (name: string) => (form.querySelector(`[name="${name}"]`) as HTMLInputElement | null)?.value.trim() || "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const slug = form.dataset.slug || "";
      const label = btn?.textContent || "Submit";

      if (btn) {
        btn.disabled = true;
        btn.dataset.label = label;
        btn.textContent = "Submitting…";
      }

      try {
        await submitProject({
          slug,
          repoUrl: val("repo"),
          name: val("name"),
          description: val("description"),
          category: val("category"),
          demoUrl: val("demo"),
        });
        (window as any).posthog?.capture("project_submitted", { tech_name: slug });
        form.hidden = true;
        success.hidden = false;
        window.scrollTo({ top: 0 });
      } catch (err) {
        (window as any).posthog?.capture("project_submission_failed", {
          tech_name: slug,
          error: (err as Error).message,
        });
        alert((err as Error).message);
        if (btn) {
          btn.disabled = false;
          btn.textContent = btn.dataset.label || label;
        }
      }
    });
  }
  initSubmit();
  document.addEventListener("astro:page-load", initSubmit);
</script>
