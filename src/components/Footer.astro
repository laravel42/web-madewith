---
import type { Theme } from "../config/domains";

interface Props { theme: Theme; }
const { theme } = Astro.props;
const base = `/${theme.slug}`;
const logo = theme.techName.charAt(0).toUpperCase();
const techSlug = theme.techName.toLowerCase().replace(/[^a-z0-9]/g, "");
---

{theme.variant === "terminal" ? (
  <div style={`border-top:${theme.footerBorder}; background:${theme.footerBg}; margin-top:auto;`}>
    <div style="max-width:1200px; margin:0 auto; padding:28px 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;">
      <div style="display:flex; align-items:center; gap:9px; font-size:13px; color:#5c665f;">
        <span style={`color:${theme.accent};`}>$</span> made-with-{techSlug} · part of the MadeWith… network
      </div>
      <div style="display:flex; gap:20px; font-size:12px; color:#5c665f;"><span>rss</span><span>submit</span><span>newsletter</span><span>twitter</span></div>
    </div>
  </div>
) : (
  <div style={`border-top:${theme.footerBorder}; background:${theme.footerBg}; margin-top:auto;`}>
    <div style="max-width:1200px; margin:0 auto; padding:30px 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;">
      <div style="display:flex; align-items:center; gap:10px;">
        <div class="disp" style={`width:26px; height:26px; border-radius:7px; background:${theme.editorial ? "#0a0a0a" : theme.accent}; color:${theme.editorial ? "#fff" : theme.accentInk}; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px;`}>{logo}</div>
        <span style="font-size:14px; color:#6b756f;">Made with {theme.techName} · part of the MadeWith… network</span>
      </div>
      <div style="display:flex; gap:22px; font-size:13px; color:#8b9690;"><span>RSS</span><span>Submit</span><span>Newsletter</span><span>Twitter</span></div>
    </div>
  </div>
)}
