---
import type { Theme } from "../config/domains";
import { articleCardMeta, getArticles, type BlogArticle } from "../lib/blog";
import BlogCardCover from "./blog/BlogCardCover.astro";

interface Props { theme: Theme; }
const { theme } = Astro.props;
const dark = theme.variant === "terminal";
const editorial = theme.editorial;
const accent = editorial ? "#6366f1" : theme.accent;
const radius = `${theme.radius}px`;
const cardBorder = dark ? "#1f2622" : "#eef0ef";
const textCol = dark ? "#e8efe9" : "#12161a";
const muted = dark ? "#7c887f" : "#6b756f";
const font = theme.dispFont;

function matchesDomainBlog(article: BlogArticle, techName: string): boolean {
  const tech = techName.toLowerCase();
  const slug = tech.replace(/[^a-z0-9]+/g, "");
  if (article.primaryTechnology === techName) return true;
  if (article.secondaryTechnology === techName) return true;
  return article.tags.some((tag) => {
    const normalized = tag.toLowerCase();
    return normalized === tech || normalized.includes(tech) || normalized.replace(/[^a-z0-9]+/g, "") === slug;
  });
}

const posts = getArticles()
  .filter((article) => matchesDomainBlog(article, theme.techName))
  .sort((a, b) => {
    const imageRank = Number(!!b.image) - Number(!!a.image);
    if (imageRank) return imageRank;
    return b.date.localeCompare(a.date) || a.title.localeCompare(b.title);
  })
  .slice(0, 3)
  .map(articleCardMeta);

if (!posts.length) return null;
---

<section
  aria-label="From the blog"
  style={`border-top:1px solid ${cardBorder}; background:${dark ? "#0a0d0c" : `color-mix(in srgb, ${accent} 4%, #fbfcfb)`}; padding:46px 0 66px; margin-top:6px;`}
>
  <div style="max-width:1200px; margin:0 auto; padding:0 32px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:24px; flex-wrap:wrap;">
      <div>
        <div style={`font-size:13px; font-weight:700; color:${accent}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:8px;`}>From the blog</div>
        <h2 style={`font-family:${font}; font-size:27px; font-weight:${editorial ? 500 : 800}; letter-spacing:${editorial ? "-0.01em" : "-0.02em"}; color:${textCol}; margin:0;`}>
          Latest {theme.techName} guides &amp; deep-dives
        </h2>
      </div>
      <a href="/blog/" class="filter-link" style={`font-size:14px; font-weight:600; color:${accent}; white-space:nowrap;`}>All articles →</a>
    </div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;">
      {posts.map((post, index) => (
        <a
          href={post.href}
          class="card domain-blog-card"
          style={`display:block; background:${dark ? "#101410" : "#fff"}; border:1px solid ${cardBorder}; border-radius:${radius}; overflow:hidden;`}
        >
          <BlogCardCover
            accent={post.tech.accent}
            accentInk={post.tech.accentInk}
            tech={post.primaryTechnology}
            category={post.category}
            title={post.title}
            size="domain"
            variant={(index % 3) as 0 | 1 | 2}
          />
          <div style="padding:17px 18px 18px;">
            <p class="domain-blog-excerpt">{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .domain-blog-excerpt {
  margin: 0;
}

.domain-blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(20, 40, 30, 0.09);
  }
  @media (max-width: 900px) {
    section > div > div:last-child { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 560px) {
    section > div > div:last-child { grid-template-columns: 1fr !important; }
  }
</style>
