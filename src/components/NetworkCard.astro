---
import type { NetworkCardStyle } from "../config/domains";

interface Props {
  href: string;
  techName: string;
  domain: string;
  count: number;
  blurb: string;
  accent: string;
  accentInk: string;
  card: NetworkCardStyle;
  logoPath?: string;
}

const { href, techName, domain, count, blurb, accent, accentInk, card, logoPath = "" } = Astro.props;
const hasLogo = !!logoPath;
const letter = techName.replace(/[^A-Za-z0-9]/g, "").charAt(0).toUpperCase();
const soft = `color-mix(in srgb, ${accent} 15%, #ffffff)`;
const softer = `color-mix(in srgb, ${accent} 7%, #ffffff)`;
const softBorder = `color-mix(in srgb, ${accent} 32%, #ffffff)`;
---

{card === "terminal" ? (
  <a href={href} class="net-card net-card--terminal">
    {hasLogo && (
      <div class="net-card__watermark" style={`--wm-fill:${accent};`}>
        <svg viewBox="0 0 24 24" width="150" height="150" fill={accent} aria-hidden="true">
          <path d={logoPath} />
        </svg>
      </div>
    )}
    <div class="net-card__top">
      <div class="net-card__chip net-card__chip--terminal" style={`background:${accent}; color:${accentInk};`}>
        {hasLogo ? (
          <svg viewBox="0 0 24 24" width="20" height="20" fill={accentInk} aria-hidden="true">
            <path d={logoPath} />
          </svg>
        ) : letter}
      </div>
      <span class="net-card__terminal-count" style={`color:${accent};`}>// {count} projects</span>
    </div>
    <div class="net-card__terminal-title">Made with {techName}</div>
    <div class="net-card__terminal-domain" style={`color:${accent};`}>~/{domain}</div>
    <div class="net-card__terminal-blurb">{blurb}</div>
    <div class="net-card__terminal-link" style={`color:${accent};`}>cd → open gallery</div>
  </a>
) : card === "black" ? (
  <a href={href} class="net-card net-card--black">
    {hasLogo && (
      <div class="net-card__watermark net-card__watermark--black">
        <svg viewBox="0 0 24 24" width="150" height="150" fill="#ffffff" aria-hidden="true">
          <path d={logoPath} />
        </svg>
      </div>
    )}
    <div class="net-card__top">
      <div class="net-card__chip net-card__chip--black">
        {hasLogo ? (
          <svg viewBox="0 0 24 24" width="20" height="20" fill="#0a0a0a" aria-hidden="true">
            <path d={logoPath} />
          </svg>
        ) : letter}
      </div>
      <span class="net-card__black-badge">{count} projects</span>
    </div>
    <div class="net-card__black-title">Made with {techName}</div>
    <div class="net-card__black-domain">{domain}</div>
    <div class="net-card__black-blurb">{blurb}</div>
    <div class="net-card__black-link">Visit the gallery →</div>
  </a>
) : (
  <a
    href={href}
    class:list={["net-card", card === "tint" ? "net-card--tint" : "net-card--default"]}
    style={`--accent:${accent}; --soft:${soft}; --softer:${softer}; --soft-border:${softBorder};`}
  >
    {hasLogo && (
      <div class:list={["net-card__watermark", card === "tint" ? "net-card__watermark--tint" : ""]} style={`--wm-fill:${accent};`}>
        <svg viewBox="0 0 24 24" width="150" height="150" fill={accent} aria-hidden="true">
          <path d={logoPath} />
        </svg>
      </div>
    )}
    <div class="net-card__top">
      <div class="net-card__chip" style={`background:${accent}; color:${accentInk}; box-shadow:0 5px 14px color-mix(in srgb, ${accent} 34%, transparent);`}>
        {hasLogo ? (
          <svg viewBox="0 0 24 24" width="20" height="20" fill={accentInk} aria-hidden="true">
            <path d={logoPath} />
          </svg>
        ) : letter}
      </div>
      <span class:list={["net-card__badge", card === "tint" ? "net-card__badge--tint" : ""]} style={`color:${accent}; background:${card === "tint" ? "rgba(255,255,255,.72)" : soft};`}>
        {count} projects
      </span>
    </div>
    <div class="net-card__title">Made with {techName}</div>
    <div class="net-card__domain">{domain}</div>
    <div class="net-card__blurb">{blurb}</div>
    <div class="net-card__link" style={`color:${accent};`}>Visit the gallery →</div>
  </a>
)}

<style>
  .net-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    padding: 18px 20px 20px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .net-card:hover { transform: translateY(-4px); }
  .net-card__watermark {
    position: absolute;
    right: -22px;
    bottom: -26px;
    line-height: 0;
    opacity: 0.1;
    pointer-events: none;
  }
  .net-card__watermark--tint { opacity: 0.13; }
  .net-card__watermark--black { right: -24px; bottom: -28px; opacity: 0.14; }
  .net-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
  }
  .net-card__chip {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
    flex-shrink: 0;
  }
  .net-card__badge {
    font-weight: 600;
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 20px;
  }
  .net-card__title {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: #12161a;
    margin-top: 16px;
    position: relative;
  }
  .net-card__domain {
    font-size: 13px;
    color: #9aa0a6;
    margin-top: 3px;
    position: relative;
  }
  .net-card__blurb {
    font-size: 13px;
    color: #6b7178;
    line-height: 1.5;
    margin-top: 11px;
    flex: 1;
    position: relative;
  }
  .net-card__link {
    font-size: 13px;
    font-weight: 600;
    margin-top: auto;
    padding-top: 14px;
    position: relative;
  }

  .net-card--default,
  .net-card--tint {
    background: linear-gradient(155deg, var(--softer) 0%, #ffffff 78%);
    border: 1px solid var(--soft-border);
  }
  .net-card--tint {
    background: linear-gradient(150deg, var(--soft) 0%, #ffffff 72%);
  }
  .net-card--default:hover,
  .net-card--tint:hover {
    box-shadow: 0 14px 34px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .net-card--terminal {
    background: radial-gradient(280px 130px at 82% -20%, rgba(0, 220, 130, 0.18), transparent 60%),
      linear-gradient(160deg, #0c130e, #111a12);
    border: 1px solid #1e2a20;
  }
  .net-card--terminal .net-card__watermark { right: -26px; bottom: -30px; opacity: 0.17; }
  .net-card--terminal .net-card__top { align-items: center; }
  .net-card__terminal-count {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
  }
  .net-card__terminal-title,
  .net-card__terminal-domain,
  .net-card__terminal-blurb,
  .net-card__terminal-link {
    font-family: "JetBrains Mono", monospace;
    position: relative;
  }
  .net-card__terminal-title {
    font-weight: 700;
    font-size: 17px;
    color: #eef3ee;
    margin-top: 16px;
  }
  .net-card__terminal-domain { font-size: 12.5px; margin-top: 6px; }
  .net-card__terminal-blurb {
    font-size: 12px;
    color: #7c887f;
    line-height: 1.6;
    margin-top: 12px;
    flex: 1;
  }
  .net-card__terminal-link { font-size: 12.5px; margin-top: auto; padding-top: 14px; }

  .net-card--black {
    background: #0a0a0a;
    border: 1px solid #0a0a0a;
  }
  .net-card__chip--black {
    border-radius: 50%;
    background: #fff;
    color: #0a0a0a;
    box-shadow: none;
  }
  .net-card__black-badge {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #8a8a8a;
  }
  .net-card__black-title {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
    margin-top: 16px;
    position: relative;
  }
  .net-card__black-domain { font-size: 13px; color: #8a8a8a; margin-top: 3px; position: relative; }
  .net-card__black-blurb { font-size: 13px; color: #9a9a9a; line-height: 1.5; margin-top: 11px; flex: 1; position: relative; }
  .net-card__black-link { font-size: 13px; font-weight: 600; color: #fff; margin-top: auto; padding-top: 14px; position: relative; }
</style>
