---
import type { NetworkCardStyle } from "../config/domains";
import { readableOnDark, readableOnLight, solidSurface, tint } from "../config/accessible-color";
import { hasNetworkIcon, networkIconHref } from "../lib/network-icons";

interface Props {
  href: string;
  techName: string;
  domain: string;
  count: number;
  blurb: string;
  accent: string;
  accentInk: string;
  card: NetworkCardStyle;
  /** Clone used for seamless marquee — skip keyboard focus. */
  decorative?: boolean;
}

const { href, techName, domain, count, blurb, accent, accentInk, card, decorative = false } = Astro.props;
const hasLogo = hasNetworkIcon(techName);
const iconHref = networkIconHref(techName);
const letter = techName.replace(/[^A-Za-z0-9]/g, "").charAt(0).toUpperCase();
const soft = tint(accent, 14);
const softBorder = tint(accent, 30);
// Terminal shell: the 55%-toward-white tint the design used, lightened further
// for near-black accents (fastify's #000000 mixed to 3.97:1 on #0c130e).
const accentText = readableOnDark(accent);
const linkInk = readableOnLight(accent);
// Solid accent plate carrying accentInk (badge, logo chip, fallback letter):
// raw brand accents ran 2.95–4.5:1 against their own ink.
const accentSolid = solidSurface(accent, accentInk);
const maskStyle = `background-color:var(--mask-fill); -webkit-mask-image:url(${iconHref}); mask-image:url(${iconHref}); -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat; -webkit-mask-position:center; mask-position:center; -webkit-mask-size:contain; mask-size:contain;`;
---

{card === "terminal" ? (
  <a href={href} class="net-card net-card--terminal" style={`--accent:${accent};`} tabindex={decorative ? -1 : undefined}>
    {hasLogo && (
      <span class="net-card__watermark net-card__watermark--terminal" style={`--mask-fill:${accent}; ${maskStyle}`} aria-hidden="true"></span>
    )}
    <div class="net-card__top">
      <div class="net-card__chip" style={`background:${accentSolid}; box-shadow:0 5px 14px color-mix(in srgb, ${accent} 34%, transparent);`}>
        {hasLogo ? (
          <span class="net-card__logo-mask" style={`--mask-fill:${accentInk}; ${maskStyle}`} aria-hidden="true"></span>
        ) : (
          <span class="net-card__letter" style={`color:${accentInk};`}>{letter}</span>
        )}
      </div>
      <span class="net-card__terminal-count" style={`color:${accentText};`}>// {count} projects</span>
    </div>
    <div class="net-card__terminal-title">Made with {techName}</div>
    <div class="net-card__terminal-domain" style={`color:${accentText};`} hidden>~/{domain}</div>
    <div class="net-card__terminal-blurb">{blurb}</div>
    <div class="net-card__terminal-link" style={`color:${accentText};`}>cd → open gallery</div>
  </a>
) : card === "black" ? (
  <a href={href} class="net-card net-card--black" tabindex={decorative ? -1 : undefined}>
    {hasLogo && (
      <span class="net-card__watermark net-card__watermark--black" style={`--mask-fill:#ffffff; ${maskStyle}`} aria-hidden="true"></span>
    )}
    <div class="net-card__top">
      <div class="net-card__chip net-card__chip--black">
        {hasLogo ? (
          <span class="net-card__logo-mask net-card__logo-mask--black" style={`--mask-fill:#0a0a0a; ${maskStyle}`} aria-hidden="true"></span>
        ) : (
          <span class="net-card__letter" style="color:#0a0a0a;">{letter}</span>
        )}
      </div>
      <span class="net-card__black-badge">{count} projects</span>
    </div>
    <div class="net-card__black-title">Made with {techName}</div>
    <div class="net-card__black-domain" hidden>{domain}</div>
    <div class="net-card__black-blurb">{blurb}</div>
    <div class="net-card__black-link">Visit the gallery →</div>
  </a>
) : (
  <a
    href={href}
    class="net-card net-card--default"
    style={`--accent:${accent}; --soft:${soft}; --soft-border:${softBorder};`}
    tabindex={decorative ? -1 : undefined}
  >
    {hasLogo && (
      <span class="net-card__watermark" style={`--mask-fill:${accent}; ${maskStyle}`} aria-hidden="true"></span>
    )}
    <div class="net-card__top">
      <div class="net-card__chip" style={`background:${accentSolid}; box-shadow:0 5px 14px color-mix(in srgb, ${accent} 34%, transparent);`}>
        {hasLogo ? (
          <span class="net-card__logo-mask" style={`--mask-fill:${accentInk}; ${maskStyle}`} aria-hidden="true"></span>
        ) : (
          <span class="net-card__letter" style={`color:${accentInk};`}>{letter}</span>
        )}
      </div>
      <span class="net-card__badge" style={`background:${accentSolid}; color:${accentInk};`}>{count} projects</span>
    </div>
    <div class="net-card__title">Made with {techName}</div>
    <div class="net-card__domain" hidden>{domain}</div>
    <div class="net-card__blurb">{blurb}</div>
    <div class="net-card__link" style={`color:${linkInk};`}>Visit the gallery →</div>
  </a>
)}

<style>
  .net-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    padding: 18px 20px 20px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .net-card:hover { transform: translateY(-4px); }
  .net-card__watermark {
    position: absolute;
    right: -22px;
    bottom: -26px;
    width: 150px;
    height: 150px;
    opacity: 0.13;
    pointer-events: none;
  }
  .net-card__watermark--terminal { opacity: 0.2; }
  .net-card__watermark--black { right: -24px; bottom: -28px; opacity: 0.13; }
  .net-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
  }
  .net-card__chip {
    position: relative;
    overflow: hidden;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .net-card__logo-mask {
    position: absolute;
    inset: 9px;
  }
  .net-card__letter {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
  }
  .net-card__badge {
    font-weight: 700;
    font-size: 11.5px;
    line-height: 1.2;
    padding: 4px 10px;
    border-radius: 20px;
  }
  .net-card__title {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: #12161a;
    margin-top: 16px;
    position: relative;
  }
  .net-card__domain {
    font-size: 13px;
    color: #5c665f;
    margin-top: 3px;
    position: relative;
  }
  .net-card__blurb {
    font-size: 14px;
    font-weight: 500;
    color: #3d4550;
    line-height: 1.45;
    margin-top: 11px;
    min-height: 3.9em;
    flex: 1;
    position: relative;
  }
  .net-card__link {
    font-size: 13px;
    font-weight: 600;
    margin-top: 14px;
    position: relative;
  }

  .net-card--default {
    background: linear-gradient(150deg, var(--soft) 0%, #ffffff 74%);
    border: 1px solid var(--soft-border);
  }
  .net-card--default:hover {
    box-shadow: 0 14px 34px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .net-card--terminal {
    background:
      radial-gradient(280px 130px at 82% -20%, rgba(120, 140, 150, 0.16), transparent 60%),
      linear-gradient(160deg, #0c130e, #111a12);
    border: 1px solid #1e2a20;
  }
  .net-card--terminal .net-card__top { align-items: center; }
  .net-card__terminal-count {
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    font-weight: 600;
  }
  .net-card__terminal-title,
  .net-card__terminal-domain,
  .net-card__terminal-blurb,
  .net-card__terminal-link {
    font-family: "JetBrains Mono", monospace;
    position: relative;
  }
  .net-card__terminal-title {
    font-weight: 700;
    font-size: 17px;
    color: #eef3ee;
    margin-top: 16px;
  }
  .net-card__terminal-domain { font-size: 12.5px; margin-top: 6px; }
  .net-card__terminal-blurb {
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.5;
    margin-top: 12px;
    min-height: 52px;
    flex: 1;
  }
  .net-card__terminal-link { font-size: 12.5px; margin-top: 8px; }

  .net-card--black {
    background: #0a0a0a;
    border: 1px solid #0a0a0a;
  }
  .net-card__chip--black {
    border-radius: 12px;
    background: #fff;
    box-shadow: none;
  }
  .net-card__black-badge {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: #d0d0d0;
  }
  .net-card__black-title {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
    margin-top: 16px;
    position: relative;
  }
  .net-card__black-domain { font-size: 13px; color: #8a8a8a; margin-top: 3px; position: relative; }
  .net-card__black-blurb {
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.45;
    margin-top: 11px;
    min-height: 3.9em;
    flex: 1;
    position: relative;
  }
  .net-card__black-link { font-size: 13px; font-weight: 600; color: #fff; margin-top: 14px; position: relative; }
</style>
