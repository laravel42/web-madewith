---
import type { Theme } from "../config/domains";
import { videoCardsForDomain } from "../lib/video-view";
import VideoCard from "./VideoCard.astro";
import { readableOnDark, readableOnLight } from "../config/accessible-color";
import "../styles/marquee-rows.css";

interface Props { theme: Theme; }
const { theme } = Astro.props;
const dark = theme.variant === "terminal";
const editorial = theme.editorial;
const accent = editorial ? "#6366f1" : theme.accent;
const accentText = dark ? readableOnDark(accent) : readableOnLight(accent);
const cardBorder = dark ? "#1f2622" : "#eef0ef";
const textCol = dark ? "#e8efe9" : "#12161a";
const font = theme.dispFont;

const videos = videoCardsForDomain(theme.slug).slice(0, 3);
// Cooler, deeper band than the blog's near-white accent wash so the two
// sections stay distinct even when the brand colour is itself cool/blue.
const sectionBg = dark
  ? `color-mix(in srgb, ${accent} 10%, #121820)`
  : `color-mix(in srgb, ${accent} 7%, #e2e8f0)`;

if (!videos.length) return null;
---

<section
  class="mw-full-bleed"
  aria-label="Video archive"
  style={`border-top:1px solid ${cardBorder}; background:${sectionBg}; padding:46px 0 66px;`}
>
  <div class="shell-pad-x" style="max-width:1200px; margin:0 auto; padding:0 32px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:24px; flex-wrap:wrap;">
      <div>
        <div style={`font-size:13px; font-weight:700; color:${accentText}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:8px;`}>Video archive</div>
        <h2 style={`font-family:${font}; font-size:27px; font-weight:${editorial ? 500 : 800}; letter-spacing:${editorial ? "-0.01em" : "-0.02em"}; color:${textCol}; margin:0;`}>
          {theme.techName} talks, tutorials &amp; deep-dives
        </h2>
      </div>
      <a href="/video/" class="filter-link" style={`font-size:14px; font-weight:600; color:${accentText}; white-space:nowrap;`}>All videos →</a>
    </div>
    <div class="domain-video-grid" data-role="domain-video-grid">
      {videos.map((item, i) => <VideoCard item={item} priority={i < 2} />)}
    </div>
    <div class="grid-slideshow" data-role="domain-video-marquee"></div>
  </div>
</section>

<style>
  .domain-video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .domain-video-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .domain-video-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { syncGridMarquee } from "../scripts/marquee-rows";

  function initDomainVideoMarquee() {
    const grid = document.querySelector<HTMLElement>('[data-role="domain-video-grid"]');
    const host = document.querySelector<HTMLElement>('[data-role="domain-video-marquee"]');
    if (!grid || !host || grid.dataset.marqueeInit) return;
    grid.dataset.marqueeInit = "1";
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-role="video-card"]'));
    const mobile = window.matchMedia("(max-width: 560px)");
    let destroy = () => {};
    const sync = () => {
      destroy = syncGridMarquee(grid, host, cards, destroy);
    };
    mobile.addEventListener("change", sync);
    sync();
  }

  initDomainVideoMarquee();
  document.addEventListener("astro:page-load", initDomainVideoMarquee);
</script>
