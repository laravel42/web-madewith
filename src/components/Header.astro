---
import type { Theme } from "../config/domains";

interface Props { theme: Theme; active?: string; }
const { theme, active = "" } = Astro.props;
const base = `/${theme.slug}`;
const logo = theme.techName.charAt(0).toUpperCase();
const techSlug = theme.techName.toLowerCase().replace(/[^a-z0-9]/g, "");
---

{theme.variant === "terminal" ? (
  <div style={`position:sticky; top:0; z-index:30; background:${theme.headerBg}; backdrop-filter:blur(10px); border-bottom:${theme.headerBorder};`}>
    <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:16px 32px;">
      <a href={`${base}/`} style="display:flex; align-items:center; gap:10px; cursor:pointer; text-decoration:none;">
        <span style={`color:${theme.accent}; font-weight:700; font-size:16px;`}>$</span>
        <span style="font-weight:700; font-size:16px; color:#e8efe9;">made-with-<span style={`color:${theme.accent};`}>{techSlug}</span></span>
        <span style={`width:8px; height:15px; background:${theme.accent}; display:inline-block;`}></span>
      </a>
      <div style="display:flex; align-items:center; gap:22px; font-size:13px; color:#7c887f;">
        <a href={`${base}/`} style="cursor:pointer; text-decoration:none; color:inherit;">--projects</a>
        <a href={`${base}/categories`} style="cursor:pointer; text-decoration:none; color:inherit;">--categories</a>
        <a href={`${base}/submit`} style={`border:1px solid ${theme.accent}; color:${theme.accent}; background:transparent; padding:8px 15px; border-radius:6px; cursor:pointer; text-decoration:none;`}>+ submit</a>
      </div>
    </div>
  </div>
) : theme.editorial ? (
  <div style={`position:sticky; top:0; z-index:30; background:${theme.headerBg}; backdrop-filter:blur(10px); border-bottom:${theme.headerBorder};`}>
    <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:20px 32px;">
      <a href={`${base}/`} style="display:flex; align-items:center; gap:11px; cursor:pointer; text-decoration:none;">
        <div style="width:30px; height:30px; border-radius:50%; background:#0a0a0a; display:flex; align-items:center; justify-content:center;"><span class="disp" style="color:#fff; font-weight:800; font-size:15px;">{logo}</span></div>
        <span style="font-weight:700; font-size:17px; letter-spacing:-0.01em;">Made with {theme.techName}</span>
      </a>
      <div style="display:flex; align-items:center; gap:26px; font-size:14px; font-weight:600;">
        <a href={`${base}/`} style="cursor:pointer; text-decoration:none; color:inherit;">Gallery</a>
        <a href={`${base}/categories`} style="cursor:pointer; text-decoration:none; color:inherit;">Categories</a>
        <a href={`${base}/submit`} style="background:#0a0a0a; color:#fff; padding:9px 18px; cursor:pointer; text-decoration:none;">Submit ↗</a>
      </div>
    </div>
  </div>
) : (
  <div style={`position:sticky; top:0; z-index:30; background:${theme.headerBg}; backdrop-filter:blur(10px); border-bottom:${theme.headerBorder};`}>
    <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:16px 32px;">
      <a href={`${base}/`} style="display:flex; align-items:center; gap:11px; cursor:pointer; text-decoration:none;">
        <div class="disp" style={`width:34px; height:34px; border-radius:9px; background:${theme.accent}; color:${theme.accentInk}; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px;`}>{logo}</div>
        <span style="font-weight:800; font-size:18px; letter-spacing:-0.01em;">Made with <span style={`color:${theme.accent};`}>{theme.techName}</span></span>
      </a>
      <div style="display:flex; align-items:center; gap:26px; font-size:14px; font-weight:500; color:#4a554f;">
        <a href={`${base}/`} style="cursor:pointer; text-decoration:none; color:inherit;">Projects</a>
        <a href={`${base}/categories`} style="cursor:pointer; text-decoration:none; color:inherit;">Categories</a>
        <a href={`${base}/submit`} class="btn btn-primary" style={`padding:9px 16px; font-size:14px;`}>Submit a project</a>
      </div>
    </div>
  </div>
)}
