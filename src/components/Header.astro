---
import type { Theme } from "../config/domains";

interface Props { theme: Theme; active?: string; }
const { theme, active = "" } = Astro.props;
const base = `/${theme.slug}`;
const logo = theme.techName.charAt(0).toUpperCase();
const techSlug = theme.techName.toLowerCase().replace(/[^a-z0-9]/g, "");

const isTerminal = theme.variant === "terminal";
const isEditorial = theme.editorial;

const links = isTerminal
  ? [
      { href: `${base}/`, label: "--projects", key: "" },
      { href: `${base}/categories`, label: "--categories", key: "categories" },
    ]
  : isEditorial
    ? [
        { href: `${base}/`, label: "Gallery", key: "" },
        { href: `${base}/categories`, label: "Categories", key: "categories" },
      ]
    : [
        { href: `${base}/`, label: "Projects", key: "" },
        { href: `${base}/categories`, label: "Categories", key: "categories" },
      ];

const submitHref = `${base}/submit`;
const submitLabel = isTerminal ? "+ submit" : isEditorial ? "Submit ↗" : "Submit a project";
---

<header
  class:list={["mw-header", isTerminal && "is-terminal", isEditorial && "is-editorial"]}
  style={`--header-bg:${theme.headerBg}; --header-border:${theme.headerBorder}; --accent:${theme.accent}; --accentInk:${theme.accentInk}; --radius:${theme.radius}px;`}
>
  <div class="mw-header-inner">
    <a href={`${base}/`} class="mw-header-brand">
      {isTerminal ? (
        <>
          <span class="mw-header-brand-accent">$</span>
          <span class="mw-header-brand-text">made-with-<span class="mw-header-brand-accent">{techSlug}</span></span>
          <span class="mw-header-cursor"></span>
        </>
      ) : isEditorial ? (
        <>
          <span class="mw-header-logo is-round disp">{logo}</span>
          <span class="mw-header-brand-text disp">Made with {theme.techName}</span>
        </>
      ) : (
        <>
          <span class="mw-header-logo disp">{logo}</span>
          <span class="mw-header-brand-text disp">Made with <span class="mw-header-brand-accent">{theme.techName}</span></span>
        </>
      )}
    </a>

    <button
      type="button"
      class="mw-header-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mw-header-nav"
    >
      <span class="mw-header-toggle-bar" aria-hidden="true"></span>
      <span class="mw-header-toggle-bar" aria-hidden="true"></span>
      <span class="mw-header-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="mw-header-nav" class="mw-header-nav">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["mw-header-link", active === link.key && "is-active"]}
        >{link.label}</a>
      ))}
      <a
        href={submitHref}
        class:list={["mw-header-submit", !isTerminal && !isEditorial && "btn btn-primary"]}
      >{submitLabel}</a>
    </nav>
  </div>
</header>

<style>
  .mw-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: var(--header-border);
  }

  .mw-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 32px;
    position: relative;
  }

  .is-editorial .mw-header-inner { padding: 20px 32px; }

  .mw-header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .is-editorial .mw-header-brand { gap: 11px; }

  .mw-header-brand-text {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .is-terminal .mw-header-brand-text { color: #e8efe9; }

  .is-editorial .mw-header-brand-text {
    font-weight: 700;
    font-size: 17px;
  }

  .mw-header:not(.is-terminal):not(.is-editorial) .mw-header-brand-text {
    font-weight: 800;
    font-size: 18px;
  }

  .mw-header-brand-accent { color: var(--accent); }

  .mw-header-cursor {
    width: 8px;
    height: 15px;
    background: var(--accent);
    display: inline-block;
    flex-shrink: 0;
  }

  .mw-header-logo {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accentInk);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
  }

  .mw-header-logo.is-round {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 15px;
  }

  .mw-header-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    color: inherit;
    flex-shrink: 0;
  }

  .mw-header-toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    margin: 0 auto;
    background: currentColor;
    border-radius: 1px;
    transition: transform .2s ease, opacity .2s ease;
  }

  .mw-header.is-open .mw-header-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mw-header.is-open .mw-header-toggle-bar:nth-child(2) { opacity: 0; }
  .mw-header.is-open .mw-header-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mw-header-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14px;
    font-weight: 500;
    color: #4a554f;
  }

  .is-terminal .mw-header-nav {
    gap: 22px;
    font-size: 13px;
    color: #7c887f;
  }

  .is-editorial .mw-header-nav {
    font-weight: 600;
  }

  .mw-header-link {
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  .mw-header-submit {
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .is-terminal .mw-header-submit {
    border: 1px solid var(--accent);
    color: var(--accent);
    background: transparent;
    padding: 8px 15px;
    border-radius: 6px;
  }

  .is-editorial .mw-header-submit {
    background: var(--accent);
    color: var(--accentInk);
    padding: 9px 18px;
  }

  .mw-header:not(.is-terminal):not(.is-editorial) .mw-header-submit {
    padding: 9px 16px;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .mw-header-inner {
      flex-wrap: wrap;
      padding: 14px 20px;
    }

    .is-editorial .mw-header-inner { padding: 16px 20px; }

    .mw-header-brand {
      flex: 1;
      min-width: 0;
    }

    .mw-header:not(.is-terminal):not(.is-editorial) .mw-header-brand-text {
      font-size: 16px;
    }

    .is-editorial .mw-header-brand-text { font-size: 15px; }

    .mw-header-logo {
      width: 30px;
      height: 30px;
      font-size: 14px;
    }

    .mw-header-logo.is-round {
      width: 28px;
      height: 28px;
      font-size: 13px;
    }

    .mw-header-toggle { display: flex; }

    .mw-header-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 20px 16px;
      background: var(--header-bg);
      border-bottom: var(--header-border);
      backdrop-filter: blur(10px);
    }

    .mw-header.is-open .mw-header-nav { display: flex; }

    .mw-header-link,
    .mw-header-submit {
      padding: 12px 0;
      white-space: normal;
    }

    .mw-header-link + .mw-header-link {
      border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    }

    .is-terminal .mw-header-link + .mw-header-link {
      border-top-color: #232a26;
    }

    .mw-header-submit {
      margin-top: 8px;
      text-align: center;
    }

    .is-terminal .mw-header-submit,
    .is-editorial .mw-header-submit,
    .mw-header:not(.is-terminal):not(.is-editorial) .mw-header-submit {
      padding: 11px 16px;
    }
  }
</style>

<script>
  document.querySelectorAll(".mw-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".mw-header-toggle");
    const nav = header.querySelector<HTMLElement>(".mw-header-nav");
    if (!toggle || !nav) return;

    const close = () => {
      header.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
    };

    toggle.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });

    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  });
</script>
