---
import type { Theme } from "../config/domains";
import GlobalSiteNav from "./GlobalSiteNav.astro";
import MadeWithTechWordmark from "./MadeWithTechWordmark.astro";
import NavIcon from "./NavIcon.astro";

interface Props { theme: Theme; active?: string; }
const { theme, active = "" } = Astro.props;
const base = `/${theme.slug}`;
const logo = theme.techName.charAt(0).toUpperCase();
const techSlug = theme.techName.toLowerCase().replace(/[^a-z0-9]/g, "");

const isTerminal = theme.variant === "terminal";
const isNext = theme.slug === "next";
const isBannerHeader = theme.heroArch === "banner" && !isNext;
const isEditorial = theme.editorial && isNext;

const links = isTerminal
  ? [
      { href: `${base}/`, label: "--projects", key: "", icon: "projects" as const },
      { href: `${base}/categories`, label: "--categories", key: "categories", icon: "categories" as const },
    ]
  : isNext || isBannerHeader
    ? [
        { href: `${base}/`, label: "Gallery", key: "", icon: "gallery" as const },
        { href: `${base}/categories`, label: "Categories", key: "categories", icon: "categories" as const },
      ]
    : [
        { href: `${base}/`, label: "Projects", key: "", icon: "projects" as const },
        { href: `${base}/categories`, label: "Categories", key: "categories", icon: "categories" as const },
      ];

const submitHref = `${base}/submit`;
const submitLabel = isTerminal ? "+ submit" : isNext || isBannerHeader ? "Submit ↗" : "Submit a project";
// Bright accents stay vivid on solid chips; darken for text on light headers.
const brandTextAccent = isEditorial
  ? theme.accent
  : `color-mix(in srgb, ${theme.accent} 45%, #16202a)`;
---

<header
  class:list={["mw-header", isTerminal && "is-terminal", isEditorial && "is-editorial", isBannerHeader && "is-banner"]}
  style={`--header-bg:${theme.headerBg}; --header-border:${theme.headerBorder}; --accent:${theme.accent}; --accentInk:${theme.accentInk}; --radius:${theme.radius}px;`}
>
  <div class="mw-header-inner">
    <a href={`${base}/`} class="mw-header-brand">
      {isTerminal ? (
        <>
          <span class="mw-header-brand-accent">$</span>
          <span class="mw-header-brand-text">made-with-<span class="mw-header-brand-accent">{techSlug}</span></span>
          <span class="mw-header-cursor"></span>
        </>
      ) : (
        <>
          <span class:list={["mw-header-logo", "disp", (isNext || isBannerHeader) && "is-round", isBannerHeader && "is-banner-logo"]}>{logo}</span>
          <MadeWithTechWordmark techName={theme.techName} accent={brandTextAccent} />
        </>
      )}
    </a>

    <button
      type="button"
      class="mw-header-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mw-header-nav"
    >
      <span class="mw-header-toggle-bar" aria-hidden="true"></span>
      <span class="mw-header-toggle-bar" aria-hidden="true"></span>
      <span class="mw-header-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="mw-header-nav" class="mw-header-nav">
      <div class="mw-header-nav-center">
        <div
          class="mw-header-global-nav"
          style={isTerminal ? `--global-nav-accent:${theme.accent};` : undefined}
        >
          <GlobalSiteNav
            part="links"
            variant={isTerminal ? "terminal" : "light"}
            includeBlog={false}
            includeRss={false}
            includeSubscribe={false}
          />
        </div>
        {links.map((link) => (
          <a
            href={link.href}
            class:list={["mw-header-link", active === link.key && "is-active"]}
          >
            <NavIcon name={link.icon} />
            {link.label}
          </a>
        ))}
      </div>
      <div class="mw-header-nav-end">
        <a
          href={submitHref}
          class:list={["mw-header-submit", !isTerminal && !isEditorial && !isBannerHeader && "btn btn-primary"]}
        >{submitLabel}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .mw-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: var(--header-border);
  }

  .mw-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 32px;
    position: relative;
  }

  .is-editorial .mw-header-inner { padding: 20px 32px; }
  .is-banner .mw-header-inner { padding: 20px 32px; }

  .mw-header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .is-editorial .mw-header-brand { gap: 11px; }

  .mw-header-brand-text {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .is-terminal .mw-header-brand-text { color: #e8efe9; }

  .mw-header-brand-accent { color: var(--accent-text); }

  .is-terminal .mw-header-brand-accent {
    color: var(--accent-text);
  }

  .mw-header-cursor {
    width: 8px;
    height: 15px;
    background: var(--accent);
    display: inline-block;
    flex-shrink: 0;
  }

  .is-terminal .mw-header-cursor {
    background: var(--accent-text);
  }

  .mw-header-logo {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent-solid);
    color: var(--accentInk);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
  }

  .mw-header-logo.is-round {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 15px;
  }

  .mw-header-logo.is-banner-logo {
    background: #0a0a0a;
    color: #fff;
  }

  .mw-header-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    color: inherit;
    flex-shrink: 0;
  }

  .mw-header-toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    margin: 0 auto;
    background: currentColor;
    border-radius: 1px;
    transition: transform .2s ease, opacity .2s ease;
  }

  .mw-header.is-open .mw-header-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mw-header.is-open .mw-header-toggle-bar:nth-child(2) { opacity: 0; }
  .mw-header.is-open .mw-header-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mw-header-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #4a554f;
  }

  .mw-header-nav-center {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mw-header-nav-end {
    display: flex;
    align-items: center;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 4px;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-brand {
    grid-column: 1;
    justify-self: start;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-nav {
    display: contents;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-nav-center {
    grid-column: 2;
    justify-self: center;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-nav-end {
    grid-column: 3;
    justify-self: end;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-nav {
    font-size: 14px;
    color: #2a3038;
  }

  .is-terminal .mw-header-nav {
    gap: 8px;
    font-size: 13px;
    color: #a8b2ab;
  }

  .is-editorial .mw-header-nav {
    font-weight: 600;
    color: #d4d4d4;
  }

  .mw-header.is-editorial .mw-header-link,
  .mw-header.is-editorial .mw-header-global-nav :global(.global-site-nav-link) {
    color: #d4d4d4;
  }

  .mw-header.is-editorial .mw-header-link:hover,
  .mw-header.is-editorial .mw-header-global-nav :global(.global-site-nav-link:hover) {
    color: #ffffff;
  }

  .mw-header.is-editorial .mw-header-link.is-active,
  .mw-header.is-editorial .mw-header-global-nav :global(.global-site-nav-link.is-active) {
    color: #ffffff;
    background: rgb(255 255 255 / 14%);
  }

  .is-banner .mw-header-nav {
    font-weight: 600;
    color: #0a0a0a;
  }

  .mw-header-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
    padding: 5px 11px;
    border-radius: 999px;
    transition: color 0.12s ease, background 0.12s ease, text-decoration-color 0.12s ease;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-link {
    color: #2a3038;
    font-weight: 600;
  }

  .mw-header-link.is-active {
    color: var(--accent);
    font-weight: 700;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-link.is-active {
    color: #12161a;
    font-weight: 700;
    background: color-mix(in srgb, rgb(47, 111, 235) 14%, transparent);
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-link:hover {
    /* the brand blue is 4.44:1 on the #fbfcfb header — just under AA at 14px */
    color: #2c68dd;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-link.is-active:hover {
    color: #12161a;
    text-decoration: none;
  }

  .mw-header-link.is-active :global(.nav-icon) {
    opacity: 1;
  }

  .is-terminal .mw-header-link.is-active {
    color: #e8efe9;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .is-terminal .mw-header-link.is-active:hover {
    color: #ffffff;
  }

  .is-terminal .mw-header-link:not(.is-active):hover {
    color: var(--accent-text);
  }

  .mw-header-submit {
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .mw-header-global-nav {
    display: flex;
    align-items: center;
  }

  .mw-header-global-nav :global(.global-site-nav) {
    gap: 6px;
  }

  .mw-header.is-terminal .mw-header-global-nav :global(.global-site-nav-link) {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
    background: transparent;
  }

  .mw-header.is-terminal .mw-header-global-nav :global(.global-site-nav-link:hover) {
    color: var(--accent-text);
    text-decoration: none;
  }

  .mw-header.is-terminal .mw-header-global-nav :global(.global-site-nav-link.is-active) {
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  @media (max-width: 768px) {
    .mw-header-inner {
      flex-wrap: wrap;
      padding: 14px 20px;
    }

    .mw-header-global-nav {
      width: 100%;
    }

    .mw-header-global-nav .global-site-nav {
      width: 100%;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .mw-header-global-nav + .mw-header-link,
    .mw-header-nav-center > .mw-header-global-nav + .mw-header-link,
    .mw-header-nav-center + .mw-header-nav-end {
      border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    }

    .is-terminal .mw-header-global-nav + .mw-header-link,
    .is-terminal .mw-header-nav-center > .mw-header-global-nav + .mw-header-link {
      border-top-color: #232a26;
    }

    .is-editorial .mw-header-inner { padding: 16px 20px; }

    .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-inner {
      display: flex;
    }

    .mw-header-brand {
      flex: 1;
      min-width: 0;
    }

    .mw-header-logo {
      width: 30px;
      height: 30px;
      font-size: 14px;
    }

    .mw-header-logo.is-round {
      width: 28px;
      height: 28px;
      font-size: 13px;
    }

    .mw-header-toggle { display: flex; }

    .mw-header-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 20px 16px;
      background: var(--header-bg);
      border-bottom: var(--header-border);
      backdrop-filter: blur(10px);
    }

    .mw-header-nav-center,
    .mw-header-nav-end {
      display: contents;
    }

    .mw-header.is-open .mw-header-nav { display: flex; }

    .mw-header-link,
    .mw-header-submit {
      padding: 12px 0;
      white-space: normal;
    }

    .mw-header-link + .mw-header-link {
      border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    }

    .is-terminal .mw-header-link + .mw-header-link {
      border-top-color: #232a26;
    }

    .mw-header-submit {
      margin-top: 8px;
      text-align: center;
    }

    .is-terminal .mw-header-submit,
    .is-editorial .mw-header-submit,
    .mw-header:not(.is-terminal):not(.is-editorial) .mw-header-submit {
      padding: 11px 16px;
    }
  }

  .is-terminal .mw-header-submit {
    border: 1px solid var(--accent-text);
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 8px 15px;
    border-radius: 6px;
  }

  .is-terminal .mw-header-submit:hover {
    color: #ffffff;
    border-color: #ffffff;
  }

  .is-editorial .mw-header-submit {
    background: var(--accent);
    color: var(--accentInk);
    padding: 9px 18px;
  }

  .is-banner .mw-header-submit {
    background: #0a0a0a;
    color: #fff;
    padding: 9px 18px;
  }

  .mw-header:not(.is-terminal):not(.is-editorial):not(.is-banner) .mw-header-submit {
    padding: 9px 16px;
    font-size: 14px;
  }
</style>

<script>
  document.querySelectorAll(".mw-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".mw-header-toggle");
    const nav = header.querySelector<HTMLElement>(".mw-header-nav");
    if (!toggle || !nav) return;

    const close = () => {
      header.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
    };

    toggle.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });

    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  });
</script>
