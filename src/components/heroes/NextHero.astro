---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import type { CategoryFilter } from "../../lib/catalog";
interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);
---
<div style="max-width:1200px; margin:0 auto; padding:50px 32px 30px; border-bottom:1px solid #262626;">
  <h1 class="disp" style="margin:0; font-weight:800; font-size:clamp(44px, 9vw, 82px); line-height:0.92; letter-spacing:-0.04em;" set:html={theme.heroHeadline}></h1>
  <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-top:26px; gap:40px; flex-wrap:wrap;">
    <div style="font-size:18px; color:#a1a1a1; max-width:520px; line-height:1.5;">{subcopy}</div>
    <div style="display:flex; gap:10px; flex-shrink:0;">
      <div style="display:flex; align-items:center; gap:9px; border:1.5px solid #333; padding:12px 18px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="#888" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="#888" stroke-width="2" stroke-linecap="round"/></svg>
        <input data-role="search" aria-label="Search projects" placeholder="Search" style="border:none; outline:none; background:transparent; font-size:14px; width:110px; color:#fafafa;"/>
      </div>
      <div data-role="sort" style="display:flex; align-items:center; gap:8px; border:1.5px solid #333; padding:12px 18px; font-size:14px; font-weight:700; cursor:pointer;">★ <span data-sort-label data-label-stars="Most stars" data-label-name="A–Z">Most stars</span> ▾</div>
    </div>
  </div>
</div>

<style>
  /* CatalogLayout's `.mw ::placeholder` is tuned for the white search fields and
     only reaches 3.5:1 on Next's black shell — lift it here. The attribute
     selector keeps it ahead of the layout rule. */
  input[data-role="search"]::placeholder { color: #9aa69e; }
</style>
