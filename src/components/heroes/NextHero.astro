---
import type { Theme } from "../../config/domains";
interface Props { theme: Theme; total: string; }
const { theme, total } = Astro.props;
---
<div style="max-width:1200px; margin:0 auto; padding:50px 32px 30px; border-bottom:1px solid #e8e8e8;">
  <div class="disp" style="font-weight:800; font-size:82px; line-height:0.92; letter-spacing:-0.04em;" set:html={theme.heroHeadline}></div>
  <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-top:26px; gap:40px; flex-wrap:wrap;">
    <div style="font-size:18px; color:#444; max-width:520px; line-height:1.5;">The definitive index of sites &amp; apps in production. {total} projects, ranked by GitHub stars and shipped weekly.</div>
    <div style="display:flex; gap:10px; flex-shrink:0;">
      <div style="display:flex; align-items:center; gap:9px; border:1.5px solid #0a0a0a; padding:12px 18px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="#0a0a0a" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="#0a0a0a" stroke-width="2" stroke-linecap="round"/></svg>
        <input data-role="search" aria-label="Search projects" placeholder="Search" style="border:none; outline:none; background:transparent; font-size:14px; width:110px; color:#0a0a0a;"/>
      </div>
      <div data-role="sort" style="display:flex; align-items:center; gap:8px; border:1.5px solid #0a0a0a; padding:12px 18px; font-size:14px; font-weight:700; cursor:pointer;">★ <span data-sort-label data-label-stars="Most stars" data-label-name="A–Z">Most stars</span> ▾</div>
    </div>
  </div>
</div>
