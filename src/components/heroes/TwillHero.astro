---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import TagRow from "../TagRow.astro";
import type { CategoryFilter } from "../../lib/catalog";
interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);
---
<div style="max-width:1200px; margin:0 auto; padding:60px 32px 30px;">
  <div style={`font-size:13px; font-weight:600; color:${theme.accent}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;`}>{theme.eyebrow}</div>
  <div class="disp" style="font-size:clamp(36px, 7.5vw, 52px); font-weight:800; letter-spacing:-0.03em; line-height:1.03; max-width:780px;">{theme.heroTitle}</div>
  <div style="font-size:18px; color:#5c665f; margin-top:18px; max-width:640px; line-height:1.55;">{subcopy}</div>

  <div style="display:flex; gap:12px; margin-top:32px; max-width:700px;">
    <div style="flex:1; display:flex; align-items:center; gap:10px; background:#fff; border:1px solid #e6eae8; border-radius:10px; padding:13px 16px;">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="#8b9690" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="#8b9690" stroke-width="2" stroke-linecap="round"/></svg>
      <input data-role="search" aria-label="Search projects, authors, or tags" placeholder="Search projects, authors, tags…" style="border:none; outline:none; background:transparent; font-size:15px; width:100%; color:#16201b;"/>
    </div>
    <div data-role="sort" style="display:flex; align-items:center; gap:8px; background:#fff; border:1px solid #e6eae8; border-radius:10px; padding:13px 16px; font-size:14px; font-weight:600; color:#3a443f; cursor:pointer; white-space:nowrap;">
      <span data-sort-label data-label-stars="Most stars" data-label-name="A–Z">Most stars</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="#3a443f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <div style="margin-top:22px;"><TagRow theme={theme} gap={9} categories={categories} /></div>
</div>
