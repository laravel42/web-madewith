---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import TagRow from "../TagRow.astro";
import type { CategoryFilter } from "../../lib/catalog";

interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);
const accent = theme.accent;
const accentText = `color-mix(in srgb, ${accent} 55%, #ffffff)`;
---
<div style="max-width:1200px; margin:0 auto; padding:48px 32px 30px;">
  <div style={`font-family:'JetBrains Mono',monospace; font-size:13px; color:${accentText}; margin-bottom:16px;`}>// {total} open-source projects indexed</div>
  <h1 class="disp" style="margin:0; font-family:'JetBrains Mono',monospace; font-size:clamp(30px, 6vw, 40px); font-weight:700; letter-spacing:-0.02em; line-height:1.1; color:#f1f6f2; max-width:820px;">
    <span style={`color:${accentText};`}>$</span> {theme.heroTitle}
  </h1>
  <div style="font-size:16px; color:#8b948d; margin-top:16px; max-width:600px; line-height:1.6;">{subcopy}</div>

  <div style="display:flex; gap:12px; margin-top:28px; max-width:700px;">
    <div style="flex:1; display:flex; align-items:center; gap:10px; background:#121614; border:1px solid #232a26; border-radius:8px; padding:13px 16px;">
      <span style={`color:${accentText}; font-family:'JetBrains Mono',monospace;`}>&gt;</span>
      <input data-role="search" aria-label="Search projects" placeholder="grep projects…" style="border:none; outline:none; background:transparent; font-size:14px; width:100%; color:#c7d0ca; font-family:'JetBrains Mono',monospace;"/>
    </div>
    <div data-role="sort" style="display:flex; align-items:center; gap:8px; background:#121614; border:1px solid #232a26; border-radius:8px; padding:13px 16px; font-size:13px; color:#c7d0ca; cursor:pointer; font-family:'JetBrains Mono',monospace; white-space:nowrap;">
      sort --<span data-sort-label data-label-stars="stars" data-label-name="name">stars</span> ▾
    </div>
  </div>

  <div style="margin-top:18px;"><TagRow theme={theme} categories={categories} /></div>
</div>

<style>
  /* CatalogLayout's `.mw ::placeholder` is tuned for the white search fields and
     only reaches 3.1:1 inside this variant's #121614 one — lift it for the dark
     shell. The attribute selector keeps it ahead of the layout rule. */
  input[data-role="search"]::placeholder { color: #9aa69e; }
</style>
