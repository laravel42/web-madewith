---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import TagRow from "../TagRow.astro";
import type { CategoryFilter } from "../../lib/catalog";

interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);
const accent = theme.accent;
const soft = `color-mix(in srgb, ${accent} 13%, #ffffff)`;
const softBorder = theme.heroSoftBorder ?? `color-mix(in srgb, ${accent} 22%, #ffffff)`;
const bandBg = theme.heroBandBg ?? `radial-gradient(560px 300px at 92% 6%, ${soft}, rgba(255,255,255,0) 62%), linear-gradient(135deg, ${soft} 0%, #f7fbf9 100%)`;
const mockHero = theme.heroMockHero ?? `linear-gradient(135deg, color-mix(in srgb, ${accent} 88%, #000), ${accent})`;
const shadow = `color-mix(in srgb, ${accent} 30%, transparent)`;
---
<div class="hero-panel" style={`max-width:1140px; margin:22px auto 8px; padding:44px 46px; border-radius:28px; background:${bandBg}; border:1px solid ${softBorder}; display:flex; align-items:center; gap:44px; flex-wrap:wrap;`}>
  <div style="flex:1; min-width:320px;">
    <div style={`font-size:13px; font-weight:700; color:${accent}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;`}>{theme.eyebrow}</div>
    <h1 class="disp" style="margin:0; font-size:clamp(32px, 7vw, 46px); font-weight:800; letter-spacing:-0.03em; line-height:1.05;">{theme.heroTitle}</h1>
    <div style="font-size:17px; color:#4a6157; margin-top:16px; max-width:520px; line-height:1.55;">{subcopy}</div>

    <div style="display:flex; gap:10px; margin-top:28px; max-width:560px;">
      <div style={`flex:1; display:flex; align-items:center; gap:10px; background:#fff; border:1px solid ${softBorder}; border-radius:100px; padding:13px 20px;`}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke={accent} stroke-width="2"/><path d="m20 20-3.5-3.5" stroke={accent} stroke-width="2" stroke-linecap="round"/></svg>
        <input data-role="search" aria-label="Search apps" placeholder="Search apps…" style="border:none; outline:none; background:transparent; font-size:15px; width:100%; color:#16201b;"/>
      </div>
      <div data-role="sort" style={`display:flex; align-items:center; gap:8px; background:${accent}; border-radius:100px; padding:13px 20px; font-size:14px; font-weight:700; color:${theme.accentInk}; cursor:pointer; white-space:nowrap; box-shadow:0 8px 18px color-mix(in srgb, ${accent} 34%, transparent);`}>
        <span data-sort-label data-label-stars="Most stars" data-label-name="A–Z">Most stars</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    <div style="margin-top:20px;"><TagRow theme={theme} categories={categories} /></div>
  </div>

  <div style={`flex-shrink:0; width:216px; height:436px; background:#0a0a0a; border-radius:42px; padding:9px; box-shadow:0 34px 70px ${shadow};`}>
    <div style="position:relative; width:100%; height:100%; background:#fff; border-radius:34px; overflow:hidden;">
      <div style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:92px; height:24px; background:#0a0a0a; border-bottom-left-radius:14px; border-bottom-right-radius:14px; z-index:2;"></div>
      <div style={`height:132px; background:${mockHero}; padding:40px 18px 0;`}>
        <div style="height:9px; width:44%; background:rgba(255,255,255,.7); border-radius:5px; margin-bottom:9px;"></div>
        <div style="height:17px; width:72%; background:#fff; border-radius:5px;"></div>
      </div>
      <div style="padding:16px 14px; display:flex; flex-direction:column; gap:11px;">
        {[70, 60, 66, 74].map((w, i) => (
          <div style="display:flex; align-items:center; gap:11px;">
            <span style={`width:38px;height:38px;border-radius:12px;background:${i === 2 ? accent : soft};flex-shrink:0;`}></span>
            <span style="flex:1;">
              <span style={`display:block;height:8px;width:${w}%;background:#e9edf3;border-radius:4px;margin-bottom:6px;`}></span>
              <span style={`display:block;height:7px;width:${w - 20}%;background:#eef2f7;border-radius:4px;`}></span>
            </span>
          </div>
        ))}
      </div>
      <div style="position:absolute; bottom:0; left:0; right:0; height:58px; background:#fff; border-top:1px solid #eef2f7; display:flex; align-items:center; justify-content:space-around; padding:0 8px;">
        <span style={`width:22px;height:22px;border-radius:7px;background:${accent};`}></span>
        <span style="width:22px;height:22px;border-radius:7px;background:#d9dfe8;"></span>
        <span style="width:22px;height:22px;border-radius:7px;background:#d9dfe8;"></span>
        <span style="width:22px;height:22px;border-radius:7px;background:#d9dfe8;"></span>
      </div>
    </div>
  </div>
</div>
