---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import TagRow from "../TagRow.astro";
import type { CategoryFilter } from "../../lib/catalog";

interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);
const accent = theme.accent;
const soft = `color-mix(in srgb, ${accent} 13%, #ffffff)`;
const softBorder = theme.heroSoftBorder ?? `color-mix(in srgb, ${accent} 22%, #ffffff)`;
const bandBg = theme.heroBandBg ?? `radial-gradient(560px 300px at 92% 6%, ${soft}, rgba(255,255,255,0) 62%), linear-gradient(135deg, ${soft} 0%, #f7fbf9 100%)`;
const mockHero = theme.heroMockHero ?? `linear-gradient(135deg, color-mix(in srgb, ${accent} 88%, #000), ${accent})`;
const shadow = `color-mix(in srgb, ${accent} 30%, transparent)`;
---
<div class="hero-panel" style={`max-width:1140px; margin:22px auto 8px; padding:44px 46px; border-radius:28px; background:${bandBg}; border:1px solid ${softBorder}; display:flex; align-items:center; gap:46px; flex-wrap:wrap;`}>
  <div style="flex:1; min-width:320px;">
    <div style={`font-size:13px; font-weight:700; color:${accent}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;`}>{theme.eyebrow}</div>
    <h1 class="disp" style={`margin:0; font-size:clamp(32px, 7vw, 46px); font-weight:800; letter-spacing:-0.03em; line-height:1.04; background:linear-gradient(96deg, color-mix(in srgb, ${accent} 55%, #000), ${accent}); -webkit-background-clip:text; background-clip:text; color:transparent;`}>{theme.heroTitle}</h1>
    <div style="font-size:17px; color:#4a6157; margin-top:16px; max-width:500px; line-height:1.55;">{subcopy}</div>

    <div style="display:flex; gap:10px; margin-top:28px; max-width:560px;">
      <div style={`flex:1; display:flex; align-items:center; gap:10px; background:#fff; border:1px solid ${softBorder}; border-radius:12px; padding:13px 16px;`}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke={accent} stroke-width="2"/><path d="m20 20-3.5-3.5" stroke={accent} stroke-width="2" stroke-linecap="round"/></svg>
        <input data-role="search" aria-label="Search projects" placeholder="Search projects…" style="border:none; outline:none; background:transparent; font-size:15px; width:100%; color:#16201b;"/>
      </div>
      <div data-role="sort" style={`display:flex; align-items:center; gap:8px; background:${accent}; border-radius:12px; padding:13px 18px; font-size:14px; font-weight:700; color:${theme.accentInk}; cursor:pointer; white-space:nowrap; box-shadow:0 8px 18px color-mix(in srgb, ${accent} 34%, transparent);`}>
        <span data-sort-label data-label-stars="Most stars" data-label-name="A–Z">Most stars</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    <div style="margin-top:20px;"><TagRow theme={theme} categories={categories} /></div>
  </div>

  <div style={`flex-shrink:0; width:346px; background:#fff; border-radius:16px; box-shadow:0 34px 70px ${shadow}; overflow:hidden; border:1px solid #eceeed;`}>
    <div style="height:40px; background:#f5f7f6; border-bottom:1px solid #edefee; display:flex; align-items:center; gap:7px; padding:0 15px;">
      <span style="width:10px;height:10px;border-radius:50%;background:#ff5f57;"></span>
      <span style="width:10px;height:10px;border-radius:50%;background:#febc2e;"></span>
      <span style="width:10px;height:10px;border-radius:50%;background:#28c840;"></span>
      <div style="flex:1; margin-left:9px; height:18px; background:#fff; border:1px solid #edefee; border-radius:9px;"></div>
    </div>
    <div style={`height:104px; background:${mockHero}; padding:22px 20px 0;`}>
      <div style={`height:8px; width:38%; background:${accent}; border-radius:4px; margin-bottom:10px;`}></div>
      <div style="height:15px; width:66%; background:rgba(255,255,255,.92); border-radius:5px; margin-bottom:8px;"></div>
      <div style="height:15px; width:48%; background:rgba(255,255,255,.5); border-radius:5px;"></div>
    </div>
    <div style="padding:16px; display:grid; grid-template-columns:1fr 1fr; gap:11px;">
      {[80, 72, 66, 78].map((w) => (
        <div style="border:1px solid #eef1f0; border-radius:10px; padding:11px;">
          <div style={`height:44px; background:${soft}; border-radius:7px; margin-bottom:9px;`}></div>
          <div style={`height:7px;width:${w}%;background:#eef1f0;border-radius:4px;`}></div>
        </div>
      ))}
    </div>
  </div>
</div>
