---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import TagRow from "../TagRow.astro";
import type { CategoryFilter } from "../../lib/catalog";

interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);
const dark = theme.heroBandDark;
const accent = theme.accent;
const titleColor = dark ? "#f6f2ff" : undefined;
const eyebrowColor = dark ? `color-mix(in srgb, ${accent} 60%, #fff)` : accent;
const subColor = dark ? "rgba(255,255,255,.78)" : "#4a6157";
const bandBg = theme.heroBandBg ?? `color-mix(in srgb, ${accent} 7%, #fff)`;
const bandBorder = dark ? "none" : `1px solid ${theme.heroSoftBorder ?? `color-mix(in srgb, ${accent} 22%, #e8ecea)`}`;
const pad = dark ? "58px 50px" : "48px 46px";
const radius = dark ? "24px" : "28px";
---
<div
  class="hero-panel"
  style={`max-width:1140px; margin:22px auto 8px; padding:${pad}; border-radius:${radius}; background:${bandBg}; border:${bandBorder};`}
>
  <div style={`font-size:13px; font-weight:700; color:${eyebrowColor}; letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px;`}>{theme.eyebrow}</div>
  <div class="disp" style={`font-size:clamp(32px, 7vw, ${dark ? "52px" : "46px"}); font-weight:${theme.heroBandDark && theme.slug === "statamic" ? 400 : 800}; letter-spacing:-0.03em; line-height:1.04; max-width:820px;${titleColor ? ` color:${titleColor};` : ""}`}>{theme.heroTitle}</div>
  <div style={`font-size:17px; color:${subColor}; margin-top:16px; max-width:560px; line-height:1.55;`}>{subcopy}</div>

  <div style="display:flex; gap:10px; margin-top:28px; max-width:640px;">
    <div style={`flex:1; display:flex; align-items:center; gap:10px; background:#fff; border:1px solid ${theme.heroSoftBorder ?? "#e0e5e2"}; border-radius:12px; padding:13px 16px;`}>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke={accent} stroke-width="2"/><path d="m20 20-3.5-3.5" stroke={accent} stroke-width="2" stroke-linecap="round"/></svg>
      <input data-role="search" aria-label="Search projects, authors, or tags" placeholder="Search projects, authors, tags…" style="border:none; outline:none; background:transparent; font-size:15px; width:100%; color:#16201b;"/>
    </div>
    <div data-role="sort" style={`display:flex; align-items:center; gap:8px; background:${accent}; border-radius:12px; padding:13px 18px; font-size:14px; font-weight:700; color:${theme.accentInk}; cursor:pointer; white-space:nowrap; box-shadow:0 8px 18px color-mix(in srgb, ${accent} 34%, transparent);`}>
      <span data-sort-label data-label-stars="Most stars" data-label-name="A–Z">Most stars</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <div style="margin-top:20px;"><TagRow theme={theme} categories={categories} /></div>
</div>
