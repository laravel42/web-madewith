---
import type { Theme } from "../../config/domains";
import { heroSubcopy } from "../../config/domain-settings";
import TagRow from "../TagRow.astro";
import type { CategoryFilter } from "../../lib/catalog";
import { readableOnDark } from "../../config/accessible-color";
interface Props { theme: Theme; total: string; categories: CategoryFilter[]; }
const { theme, total, categories } = Astro.props;
const subcopy = heroSubcopy(theme, total);

// The raw Node green is a fill colour; as 13px text on the near-black shell and
// inside the #121614 search field it has no margin, so use the dark-surface
// variant the rest of the terminal chrome uses.
const accentText = readableOnDark(theme.accent);
---
<div class="mw-full-bleed" style={`max-width:1200px; margin:0 auto; padding:56px 32px 28px; background:${theme.bg};`}>
  <div style={`font-size:13px; color:${accentText}; margin-bottom:16px;`}>{theme.eyebrow.replace("{total}", total)}</div>
  <h1 class="disp" style="margin:0; font-size:clamp(34px, 7vw, 48px); font-weight:700; letter-spacing:-0.02em; line-height:1.06; color:#f1f6f2; max-width:820px;">{theme.heroTitle}</h1>
  <div style="font-size:15px; color:#8b948d; margin-top:16px; max-width:620px; line-height:1.6;">{subcopy}</div>

  <div style="display:flex; gap:12px; margin-top:30px; max-width:720px;">
    <div style="flex:1; display:flex; align-items:center; gap:10px; background:#121614; border:1px solid #232a26; border-radius:8px; padding:13px 16px;">
      <span style={`color:${accentText};`}>&gt;</span>
      <input data-role="search" aria-label="Search projects, authors, or tags" placeholder="grep projects, authors, tags…" style="border:none; outline:none; background:transparent; font-size:14px; width:100%; color:#e8efe9;"/>
    </div>
    <div data-role="sort" style="display:flex; align-items:center; gap:8px; background:#121614; border:1px solid #232a26; border-radius:8px; padding:13px 16px; font-size:13px; color:#c7d0ca; cursor:pointer; white-space:nowrap;">
      sort --<span data-sort-label data-label-stars="stars" data-label-updated="updated" data-label-name="name">stars</span> ▾
    </div>
  </div>

  <div style="margin-top:20px;"><TagRow theme={theme} categories={categories} /></div>
</div>

<style>
  /* CatalogLayout's `.mw ::placeholder` is tuned for the white search fields and
     only reaches 3.1:1 inside this variant's #121614 one — lift it for the dark
     shell. The attribute selector keeps it ahead of the layout rule. */
  input[data-role="search"]::placeholder { color: #9aa69e; }
</style>
