---
import type { VideoCardItem } from "../lib/video-view";

interface Props { item: VideoCardItem; priority?: boolean; }
const { item, priority = false } = Astro.props;
const cover = `linear-gradient(135deg, color-mix(in srgb, ${item.accent} 82%, #000), ${item.accent})`;
const haystack = `${item.techName} ${item.title} ${item.channel} ${item.groupLabel} ${item.kind}`.toLowerCase();
---

<article
  class="video-card"
  data-role="video-card"
  data-slug={item.slug}
  data-group={item.group}
  data-text={haystack}
>
  <a href={item.href} aria-label={`Watch: ${item.title}`}>
    <div class="video-card-cover" style={`background:${cover};`}>
      {item.thumbnail && (
        <img
          class="video-card-thumb"
          src={item.thumbnail}
          alt=""
          width="480"
          height="270"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
          decoding="async"
          onerror="this.remove()"
        />
      )}
      <span class="video-card-tag">{item.kind}</span>
      <span class="video-card-dur">{item.duration}</span>
      <span class="video-card-play"><span class="video-card-tri" style={`border-color:transparent transparent transparent ${item.accent};`}></span></span>
    </div>
    <div class="video-card-body">
      <div class="video-card-tech" style={`color:${item.accent};`}>{item.techName}</div>
      <h3 class="video-card-title">{item.title}</h3>
      <div class="video-card-meta">
        <span class="video-card-avatar" style={`background:${item.accent}; color:${item.accentInk};`}>{item.channelInitial}</span>
        <span class="video-card-metatext">{item.channel} · {item.viewsLabel} views · <time datetime={item.dateIso}>{item.dateLabel}</time></span>
      </div>
    </div>
  </a>
</article>

<style>
  .video-card {
    background: #fff;
    border: 1px solid #e9ebee;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .video-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgb(20 30 50 / 8%); }
  .video-card > a { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }

  .video-card-cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
  .video-card-thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .video-card-tag {
    position: absolute; top: 11px; left: 11px; z-index: 2;
    font-size: 11px; font-weight: 700; color: #fff;
    background: rgb(0 0 0 / 26%); padding: 4px 10px; border-radius: 20px; backdrop-filter: blur(4px);
  }
  .video-card-dur {
    position: absolute; bottom: 11px; right: 11px; z-index: 2;
    font-size: 11.5px; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums;
    background: rgb(0 0 0 / 58%); padding: 3px 8px; border-radius: 6px;
  }
  .video-card-play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;
    width: 52px; height: 52px; border-radius: 50%; background: rgb(255 255 255 / 92%);
    display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 22px rgb(0 0 0 / 28%);
    transition: transform 0.15s ease;
  }
  .video-card:hover .video-card-play { transform: translate(-50%, -50%) scale(1.06); }
  .video-card-tri { width: 0; height: 0; border-style: solid; border-width: 9px 0 9px 15px; margin-left: 3px; }

  .video-card-body { display: flex; flex-direction: column; flex: 1; padding: 16px 17px 18px; }
  .video-card-tech {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .video-card-title {
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 16.5px; font-weight: 800; letter-spacing: -0.01em; line-height: 1.28;
    margin: 6px 0 0; min-height: 42px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .video-card-meta {
    display: flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 13px;
    font-size: 12.5px; color: #9aa0a6;
  }
  .video-card-avatar {
    width: 24px; height: 24px; border-radius: 50%; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 11px;
  }
  .video-card-metatext { min-width: 0; }
</style>
