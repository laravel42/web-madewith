---
/** Stroke icons for site and domain header navigation. */
interface Props {
  name: "network" | "projects" | "categories" | "gallery" | "blog" | "video" | "rss";
}

const { name } = Astro.props;
---

{name === "network" && (
  <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
    <path d="M3 12h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
)}
{name === "projects" && (
  <svg
    class="nav-icon"
    viewBox="0 0 512 512"
    fill="none"
    stroke="currentColor"
    stroke-width="18"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M170 330 V250 C135 220 116 177 116 130 C116 62 170 20 256 20 C342 20 396 74 396 142 C396 185 378 223 344 250 V330"
    />
    <rect x="170" y="330" width="174" height="96" rx="18" fill="currentColor" stroke="none" />
    <circle cx="257" cy="438" r="22" fill="currentColor" stroke="none" />
    <path d="M172 110 C172 150 186 183 214 205" />
    <path d="M205 252 C210 264 214 276 214 292" />
    <g transform="translate(328 126)">
      <path
        fill="currentColor"
        stroke="none"
        d="M42 -58 L66 -46 L92 -52 L100 -24 L124 -10 L116 18 L128 42 L104 58 L98 86 L70 82 L48 100 L26 82 L-2 86 L-8 58 L-32 42 L-20 18 L-28 -10 L-4 -24 L4 -52 L30 -46 Z"
      />
      <circle cx="48" cy="18" r="34" fill="white" stroke="none" />
    </g>
  </svg>
)}
{name === "categories" && (
  <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M4 7h7l2 2h7v10H4V7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    <path d="M4 4h5l2 2h9v10H4V4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" opacity="0.45"/>
  </svg>
)}
{name === "gallery" && (
  <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
    <circle cx="9" cy="11" r="2" stroke="currentColor" stroke-width="2"/>
    <path d="m3 17 5-5 4 4 5-6 4 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === "blog" && (
  <svg
    class="nav-icon"
    viewBox="0 0 512 512"
    fill="none"
    stroke="currentColor"
    stroke-width="28"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M64 64 H448 A24 24 0 0 1 472 88 V344 A24 24 0 0 1 448 368 H228 L120 472 L200 368 H64 A24 24 0 0 1 40 344 V88 A24 24 0 0 1 64 64 Z"
    />
    <path
      fill="currentColor"
      stroke="none"
      d="M180 210 C180 160 218 132 270 128 L264 156 C235 160 219 176 214 198 C240 198 258 216 258 244 C258 276 236 298 204 298 C171 298 148 273 148 239 C148 228 151 218 156 208 C162 196 170 187 180 180 Z"
    />
    <path
      fill="currentColor"
      stroke="none"
      d="M310 210 C310 160 348 132 400 128 L394 156 C365 160 349 176 344 198 C370 198 388 216 388 244 C388 276 366 298 334 298 C301 298 278 273 278 239 C278 228 281 218 286 208 C292 196 300 187 310 180 Z"
    />
  </svg>
)}
{name === "video" && (
  <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="2"/>
    <path d="M11 9.5v5l4-2.5-4-2.5Z" fill="currentColor" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
)}
{name === "rss" && (
  <svg class="nav-icon" viewBox="0 0 512 512" aria-hidden="true">
    <circle cx="112" cy="400" r="48" fill="currentColor" />
    <path
      d="M64 224 C187.7 224 288 324.3 288 448 H224 C224 359.6 152.4 288 64 288 Z"
      fill="currentColor"
    />
    <path
      d="M64 96 C258.4 96 416 253.6 416 448 H352 C352 289 223 160 64 160 Z"
      fill="currentColor"
    />
  </svg>
)}

<style>
  .nav-icon {
    display: grid;
    place-items: center;
    width: 1.2em;
    height: 1.2em;
    flex-shrink: 0;
    opacity: 0.92;
  }
</style>
