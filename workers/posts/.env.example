# Required
OPENROUTER_API_KEY=          # default provider (or OPENAI_API_KEY for OpenAI direct)
GITHUB_TOKEN=

# Optional
FACTORY_MODEL=               # default: anthropic/claude-sonnet-4.5 on OpenRouter, gpt-5-mini on OpenAI
FACTORY_BASE_URL=            # override the LLM endpoint (default: OpenRouter when OPENROUTER_API_KEY is set)
FACTORY_MAX_TOKENS=32000
CONTENT_DB=content_factory.sqlite3
CONTENT_OUTPUT_DIR=output
GITHUB_API_VERSION=2022-11-28
