{
  "name": "madewith-catalog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "MadeWith… — a replicable, per-domain showcase catalog of open-source projects, fed by real GitHub data.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "projects:scrape": "workers/.venv/bin/python workers/pipeline.py projects:scrape",
    "projects:publish": "workers/.venv/bin/python workers/pipeline.py projects:publish",
    "projects:status": "workers/.venv/bin/python workers/projects/status.py",
    "github:discover": "workers/.venv/bin/python workers/github/scheduled.py discover",
    "github:import": "workers/.venv/bin/python workers/github/scheduled.py import",
    "github:cli": "workers/.venv/bin/madewith-github",
    "youtube:scrape": "workers/.venv/bin/python workers/pipeline.py videos:scrape",
    "youtube:publish": "workers/.venv/bin/python workers/pipeline.py videos:publish",
    "blog:generate": "workers/.venv/bin/python workers/pipeline.py blog:generate",
    "blog:hydrate": "workers/.venv/bin/python workers/pipeline.py blog:hydrate",
    "blog:test": "workers/.venv/bin/python workers/posts/tests/run.py",
    "discovery:worker": "workers/.venv/bin/python workers/projects/discovery_worker.py",
    "redeploy:worker": "workers/.venv/bin/python workers/utils/redeploy_worker.py",
    "pipeline": "workers/.venv/bin/python workers/pipeline.py",
    "dev": "astro dev",
    "predev": "node workers/utils/hydrate-blog.mjs",
    "prebuild": "node workers/utils/pull-data.mjs && node workers/utils/hydrate-blog.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:s3": "workers/.venv/bin/python workers/utils/deploy_s3.py",
    "server": "pnpm --dir server start",
    "server:dev": "pnpm --dir server dev",
    "server:refresh": "pnpm --dir server refresh",
    "server:migrate": "pnpm --dir server migrate",
    "infra:synth": "pnpm --dir infra run synth",
    "infra:diff": "pnpm --dir infra run diff",
    "infra:deploy": "pnpm --dir infra run deploy",
    "infra:wire-cloudfront": "workers/.venv/bin/python workers/utils/cloudfront/add_api_origins.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "astro-chat-widget": "^0.1.2",
    "flowbite": "^4.0.2",
    "marked": "^18.0.11",
    "posthog-js": "^1.427.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  },
  "packageManager": "pnpm@11.17.0"
}
