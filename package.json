{
  "name": "madewith-catalog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "MadeWith… — a replicable, per-domain showcase catalog of open-source projects, fed by real GitHub data.",
  "scripts": {
    "scrape": "bash scraper/crawl.sh",
    "scrape:publish": "bash scraper/publish.sh",
    "scrape:status": "cd scraper && .venv/bin/python status.py",
    "scrape:migrate:json": "bash scraper/migrate_json.sh",
    "scrape:youtube": "bash youtube/crawl_youtube.sh",
    "scrape:youtube:publish": "bash youtube/publish_videos.sh",
    "dev": "astro dev",
    "generate:blog": "cd factory && .venv/bin/python content_factory.py",
    "hydrate:blog": "node scripts/hydrate-blog.mjs",
    "predev": "node scripts/hydrate-blog.mjs",
    "prebuild": "node scripts/pull-data.mjs && node scripts/hydrate-blog.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "server": "pnpm --dir server start",
    "server:dev": "pnpm --dir server dev",
    "server:refresh": "pnpm --dir server refresh",
    "server:migrate": "pnpm --dir server migrate"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-chat-widget": "^0.1.2",
    "flowbite": "^4.0.2",
    "marked": "^18.0.7",
    "posthog-js": "^1.410.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  },
  "packageManager": "pnpm@11.17.0"
}
