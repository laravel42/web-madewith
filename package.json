{
  "name": "madewith-catalog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "MadeWith… — a replicable, per-domain showcase catalog of open-source projects, fed by real GitHub data.",
  "scripts": {
    "scrape": "bash scraper/crawl.sh",
    "scrape:publish": "bash scraper/publish.sh",
    "scrape:status": "cd scraper && .venv/bin/python status.py",
    "scrape:migrate-json": "bash scraper/migrate_json.sh",
    "scrape:youtube": "bash scraper/crawl_youtube.sh",
    "scrape:youtube:publish": "bash scraper/publish_videos.sh",
    "dev": "astro dev",
    "dev:worker": "npm run dev --prefix worker",
    "hydrate-blog": "node scripts/hydrate-blog.mjs",
    "predev": "node scripts/hydrate-blog.mjs",
    "prebuild": "node scripts/pull-data.mjs && node scripts/hydrate-blog.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler pages deploy",
    "cf:preview": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "flowbite": "^4.0.2",
    "marked": "^18.0.6",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "wrangler": "^4.110.0"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
